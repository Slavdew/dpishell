#!/bin/sh /etc/rc.common
# DpiShell: после загрузки — привести zapret к сохранённому выбору (перезагрузка посреди подбора оставила бы
# в config проверяемую стратегию), status.json, проверка по таймеру через cron.

START=95
USE_PROCD=1

CRON=/etc/crontabs/root
# Одна строка на всё фоновое: сторож раз в 5 мин, проверка по таймеру, DNS и обновления — раз в 30 мин (run tick);
# включены ли они — run смотрит в настройках сам. Пониженный приоритет: железо пользователя не нагружать.
CRON_LINE='*/5 * * * * nice -n 19 /usr/libexec/dpishell/run tick'

# cron_set 0|1
cron_set() {
	touch "$CRON"
	grep -v '/usr/libexec/dpishell/run \(watch\|guard\|tick\)' "$CRON" > "$CRON.dpishell" || true
	[ "$1" = 1 ] && echo "$CRON_LINE" >> "$CRON.dpishell"
	if ! cmp -s "$CRON" "$CRON.dpishell"; then
		mv "$CRON.dpishell" "$CRON"
		/etc/init.d/cron restart >/dev/null 2>&1
	else
		rm -f "$CRON.dpishell"
	fi
}

restore_choice() {
	ucode -e '
		import * as st from "dpishell.state";
		st.ensure_dirs();
		let s = st.settings();
		if (s.enabled && s.strategy && !st.write_zapret_config(s.strategy, s))
			system("/etc/init.d/zapret restart >/dev/null 2>&1");
		else if (!s.enabled)
			system("/etc/init.d/zapret stop >/dev/null 2>&1");
		st.write_status_json();
	'
}

start_service() {
	# Перезагрузка, пока включение ждало подтверждения (confirm_s), — то же, что неподтверждение: откат до restore_choice.
	[ -f /etc/dpishell/pending-confirm.json ] && /usr/libexec/dpishell/run revert now
	# Задания, прерванные перезагрузкой или обновлением со старой версии, — закрыть итогом по факту.
	/usr/libexec/dpishell/run recover
	restore_choice
	cron_set 1
}

reload_service() {
	cron_set 1
}

stop_service() {
	cron_set 0
}

service_triggers() {
	procd_add_reload_trigger dpishell
}
