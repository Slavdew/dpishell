#!/bin/sh
# Аварийный выключатель кнопкой на корпусе (docs/router/README.md «Если всё сломалось»). Штатный /etc/rc.button/reset
# не заменяется — procd зовёт его отдельно, этот файл только добавляет выключение обхода (пороги ниже — типичные для OpenWrt,
# на деле их задаёт rc.button/reset вашей прошивки):
#   wps (если есть)        — выключить обход, без перезагрузки;
#   reset, меньше 1 с      — штатная перезагрузка; обход выключаем до неё, роутер поднимется уже без него;
#   reset, 1–4 с           — штатно ничего не делает; выключаем обход без перезагрузки;
#   reset, 5 с и дольше    — штатный сброс к заводским, не трогаем. Аварийный режим при загрузке (preinit) сюда не попадает.
[ "$ACTION" = released ] || exit 0
case "$BUTTON" in
	wps) ;;
	reset) [ "${SEEN:-0}" -lt 5 ] || exit 0 ;;
	*) exit 0 ;;
esac
[ -x /usr/libexec/dpishell/off ] && /usr/libexec/dpishell/off button
exit 0
