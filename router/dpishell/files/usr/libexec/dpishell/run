#!/usr/bin/ucode -S
// Фоновые задания DpiShell: подбор, проверка, проверка по таймеру.
//   run select '<json args>'   — подбор (select_start)
//   run check <manual|app>     — полная проверка текущей стратегии
//   run watch                  — проверка по таймеру: запасные стратегии, автоподбор (architecture.md «Проверка по таймеру и запасные»)
//   run guard                  — сторож: с обходом пропал интернет, без него есть — выключить и один раз подобрать
//   run tick                   — cron раз в 5 мин: сторож и раз в 30 мин watch
//   run revert [now]           — откат включения, не подтверждённого вовремя (confirm_s)
//   run rollback saved|local   — откат версии пакета (update_rollback)
//   run changes_undo <id|all>  — «Изменено DpiShell»: отменить пункт или всё
'use strict';

import { writefile, readfile, stat, lstat, lsdir, unlink, rmdir } from 'fs';
import * as st from 'dpishell.state';
import * as sel from 'dpishell.select';
import * as core from 'dpishell.core';
import * as dg from 'dpishell.diag';
import * as dns from 'dpishell.dns';
import * as upd from 'dpishell.update';
import * as pr from 'dpishell.probe';
import * as cat from 'dpishell.catalog';
import * as chg from 'dpishell.changes';

const cmd = ARGV[0];

// Замок задания — атомарно, с проверкой PID по времени старта (state.uc job_lock; rpcd занимает его заранее — DPS_LOCK).
function lock(name) {
	return st.job_lock(name);
}

// Итог задания: e — null, строка или сообщение { key, params, text, detail } (pkgs.uc msg). message — русский текст (старые окна),
// message_msg — фраза словаря, detail — сырой вывод для «Подробнее».
function job_result(e, done) {
	if (!e)
		return { ok: true, message: done };
	if (type(e) != 'object')
		return { ok: false, message: `${e}` };
	return { ok: false, message: e.text, message_msg: { key: e.key, params: e.params ?? {}, text: e.text }, ...(e.detail ? { detail: e.detail } : {}) };
}

// Предупреждение: text — готовый русский (старые окна), key/params — ключ общего словаря и сырые параметры
// (router-api.md §9, 2026-10-20). text null — снять предупреждение с этим кодом.
function warn(code, text, key, params) {
	let w = filter(st.read_json('/tmp/dpishell/warnings.json', []), x => x.code != code);
	if (text)
		push(w, { code, text, ...(key ? { key, params: params ?? {} } : {}) });
	st.write_atomic('/tmp/dpishell/warnings.json', sprintf('%J\n', w));
}

function title_of(id) {
	return cat.find(st.catalogs(), id)?.title ?? id;
}

// Подбор после сторожа: один раз, быстрый, все группы (cron tick уже под nice). Найденная стратегия прошла и обычные
// сайты (группа control) — то, на чём сработал сторож; сломается и она — сторож выключит снова, но подбирать уже не будет,
// пока человек не включит обход или не запустит подбор (WATCHDOG_SELECT снимают enable/select_start).
function guard_select() {
	if (st.read_json(st.WATCHDOG_SELECT, null))
		return;
	st.write_atomic(st.WATCHDOG_SELECT, sprintf('%J\n', { at: time(), ok: false }));
	let ls = lock('select');
	if (!ls) return;
	unlink(sel.CANCEL);   // «Остановить» от прошлого подбора не должна отменить этот
	let p = null;
	try { p = sel.select_run({ mode: 'quick', depth: 'main', started_by: 'watchdog' }); } catch (e) {}
	unlink(ls);
	st.write_atomic(st.WATCHDOG_SELECT, sprintf('%J\n', { at: time(), ok: !!p?.applied, best: p?.applied ? p.best : null }));
	if (p?.applied) {
		warn('watchdog_select_failed', null);
		warn('auto_selected', `Сторож выключил оптимизацию: пропал интернет. Роутер подобрал и включил ${title_of(p.best)}.`,
			'router.wd.select_found', { name: title_of(p.best) });
	} else
		warn('watchdog_select_failed', 'Сторож выключил оптимизацию: пропал интернет, а подходящей стратегии не нашлось. Включить снова — вручную.',
			'router.wd.select_failed');
	st.write_status_json();
}

// Сторож (architecture.md «Аварийный выключатель»): обычные сайты (группа control) — только рукопожатие TLS, по одной,
// до 3 целей. Не открылись дважды подряд — проверка без обхода: открылись — обход мешает, выключить (включит снова только
// человек); нет — обрыв у провайдера, обход вернуть и проверять реже (5 → 10 → 20 мин, после успеха снова 5).
// Журнал — только logread; состояние — /tmp/dpishell/guard.json { fails, interval, next_at, checked_at, ok }.
function guard() {
	let s = st.settings();
	if (!s.enabled || !s.schedule.watchdog)
		return;
	// Ждёт подтверждения включения — откатит сам по сроку, сторожу не вмешиваться (иначе качели «откат → сторож»).
	if (st.read_json(st.PENDING, null))
		return;
	for (let j in ['select', 'check', 'update', 'core_install', 'dns', 'site_check', 'changes'])
		if (st.job_running(j))
			return;
	let G = '/tmp/dpishell/guard.json';
	let gs = st.read_json(G, { fails: 0, interval: 5, next_at: 0 });
	if (time() < (gs.next_at ?? 0))
		return;
	let l = lock('guard');
	if (!l) return;
	// Только сайты, через которые обход идёт: из исключений (стандартных и своих) обход не трогает — их сторож не видит
	// (vk.com, ozon.ru… в exclude.txt открывались бы при любой поломке).
	let excl = {};
	for (let f in [`${st.P.share}/lists/exclude.txt`, `${st.P.lists}/user-exclude.txt`])
		for (let d in split(readfile(f) ?? '', '\n'))
			if (length(trim(d))) excl[lc(trim(d))] = true;
	let excluded = url => {
		let h = lc(match(url, /^https?:\/\/([^\/:]+)/)?.[1] ?? '');
		for (let parts = split(h, '.'); length(parts) >= 2; shift(parts))
			if (excl[join('.', parts)]) return true;
		return false;
	};
	let ctl = filter(sel.load_groups(null, s.mode), g => g.control)[0];
	let targets = slice(filter(ctl?.targets ?? [], t => t.required !== false && !excluded(t.url)), 0, 3);
	if (!length(targets)) { unlink(l); return; }
	// Адреса целей (DoH) — на час в guard.json: не лишний запрос к 8.8.8.8 каждые 5 мин. При неудаче — узнать заново.
	let dns = (time() - (gs.dns_at ?? 0) < 3600 && type(gs.dns) == 'object') ? gs.dns : {};
	let dns_at = length(dns) ? gs.dns_at : time();
	// По одной цели и до первой открывшейся: при живом интернете — одно рукопожатие.
	let probe = () => {
		let res = [];
		for (let t in targets) {
			let r = pr.check_batch([{ target: { ...t, handshake_only: true }, tls: '1.3' }], { parallel: 1, connect_s: 3, read_s: 2, dns_cache: dns })[0];
			push(res, r);
			if (r.ok) break;
		}
		return res;
	};
	let save = (ok, extra) => st.write_atomic(G, sprintf('%J\n', { fails: 0, interval: 5, next_at: 0, ...(extra ?? {}), checked_at: time(), ok,
		...(ok ? { dns, dns_at } : {}) }));
	let r = probe();
	if (length(filter(r, x => x.ok))) {
		save(true);
		unlink(l);
		return;
	}
	if ((gs.fails ?? 0) < 1) {
		save(false, { fails: 1, interval: gs.interval ?? 5 });
		unlink(l);
		return;
	}
	system('/etc/init.d/zapret stop >/dev/null 2>&1');
	sleep(2000);
	let r2 = probe();
	if (length(filter(r2, x => x.ok))) {
		let bad = sprintf('%J', map(r, x => ({ url: x.url, detail: x.detail })));
		system(`/usr/libexec/dpishell/off watchdog '${replace(bad, "'", "'\\''")}'`);
		save(false);
		unlink(l);
		guard_select();
		return;
	} else {
		system('/etc/init.d/zapret restart >/dev/null 2>&1');
		let iv = min((gs.interval ?? 5) * 2, 20);
		system(`logger -t dpishell 'Сторож: интернета нет и без оптимизации — обрыв у провайдера, оптимизация оставлена; следующая проверка через ${iv} мин'`);
		save(false, { interval: iv, next_at: time() + iv * 60 - 30 });
	}
	unlink(l);
}

// Связки с ПК (pc_link_set): истекла (24 ч без продления) — config без её nfqws; набор активных разошёлся с тем,
// что записан в config, — переписать и перезапустить zapret. Во время заданий не трогаем: они держат свой config.
function pc_refresh() {
	let s = st.settings();
	if (!s.enabled || !s.strategy)
		return;
	for (let j in ['select', 'check', 'update', 'core_install', 'changes'])
		if (st.job_running(j))
			return;
	let want = join(',', map(slice(st.pc_active(s), 0, st.PC_MAX), x => x.id));
	let have = join(',', st.read_json('/tmp/dpishell/pc-rendered.json', []));
	if (want == have)
		return;
	if (!st.write_zapret_config(s.strategy, s))
		system('/etc/init.d/zapret restart >/dev/null 2>&1');
}

// Остатки в ОЗУ после прерванных заданий (tick, старт пакета). Только свои пути в своём /tmp/dpishell (0700, root),
// без перехода по ссылкам: каталоги проб probe-<время>-<n> старше часа (задание убито — свои файлы не убрало), config
// кандидата, когда подбор не идёт, zip и распаковка ядра после неудачи, папка обновления окна ПК старше часа.
function cleanup_tmp() {
	for (let f in lsdir(st.P.run) ?? []) {
		if (!match(f, /^probe-[0-9]+-[0-9]+$/))
			continue;
		let d = `${st.P.run}/${f}`, s = lstat(d);
		if (s?.type != 'directory' || time() - s.mtime < 3600)
			continue;
		for (let x in lsdir(d) ?? [])
			unlink(`${d}/${x}`);
		rmdir(d);
	}
	if (!st.job_running('select'))
		unlink(st.P.trial_config);
	// Итог «Сравнить скорость» нужен минуту-другую (страница держит его у себя) — старше 10 мин не хранить.
	let dc = `${st.P.run}/dns_compare.json`, dcs = lstat(dc);
	if (dcs?.type == 'file' && time() - dcs.mtime > 600 && !st.job_running('dns_compare'))
		unlink(dc);
	try { core.cleanup_tmp(); } catch (x) {}
	try { upd.local_cleanup(3600); } catch (x) {}
}

// Задания, чей процесс умер (убит, перезагрузка), остаются «идёт» навсегда — закрыть по факту (tick, старт пакета).
function recover_jobs() {
	try { upd.recover(); } catch (x) {}
	let dj = st.read_json('/tmp/dpishell/dns_job.json', null);
	if (dj?.running && !st.job_running('dns'))
		st.write_atomic('/tmp/dpishell/dns_job.json', sprintf('%J\n', { ...dj, running: false, ok: false, message: 'Задание прервалось', at: time() }));
	cleanup_tmp();
}

// Проверка по таймеру, DNS и обновления (бывший cron run watch раз в 30 мин).
function watch() {
	let dw = null;
	try { dw = dns.watch(); } catch (x) {}
	// Есть ли новая версия DpiShell — раз в сутки (router-api.md §5, status.update).
	if (!st.job_running('update'))
		try { upd.check_daily(); } catch (x) {}
	if (dw == 'dns_fallback') warn('dns_fallback', 'Защищённый DNS недоступен — временно работает DNS провайдера', 'web.warn.dns_fallback');
	else if (dw == 'dns_back') warn('dns_fallback', null);
	let s = st.settings();
	if (!s.schedule.enabled || !s.enabled || st.job_running('select')) return;
	// Интервал выдерживаем сами: cron зовёт каждые 30 мин. Свежая запись — в /tmp (во флеш — только перемены, select.uc).
	let last = st.last_check();
	if (last && time() - last.at < s.schedule.hours * 3600 - 120) return;
	let l = lock('check');
	if (!l) return;
	let r = sel.check_run('timer', true);
	unlink(l);
	if (!r || r.fail_streak < 2) return;
	// Две неудачи подряд: следующая запасная (architecture.md «Проверка по таймеру и запасные»).
	let backups = s.backups;
	if (length(backups)) {
		let next = backups[0];
		s.strategy = next;
		if (!st.write_zapret_config(next, s) && system('/etc/init.d/zapret restart >/dev/null 2>&1') == 0) {
			st.uci_set({ strategy: next, backups: slice(backups, 1) });
			st.write_atomic(`${st.P.etc}/fail-streak.json`, '0\n');
			warn('switched_backup', `Стратегия перестала работать — включена запасная ${title_of(next)}`, 'web.warn.switched_backup', { name: title_of(next) });
			st.write_status_json();
		}
		return;
	}
	if (!s.schedule.auto_select) {
		warn('switched_backup', null);
		return;
	}
	let lr = st.read_json(`${st.P.etc}/auto-select.json`, { at: 0 });
	if (time() - lr.at < 6 * 3600) return;
	st.write_atomic(`${st.P.etc}/auto-select.json`, sprintf('%J\n', { at: time() }));
	let ls = lock('select');
	if (!ls) return;
	unlink(sel.CANCEL);
	let p = sel.select_run({ mode: 'quick', depth: 'main', started_by: 'timer' });
	unlink(ls);
	if (p.applied)
		warn('auto_selected', `Автоподбор включил ${title_of(p.best)}`, 'web.warn.auto_selected', { name: title_of(p.best) });
	else
		warn('auto_select_failed', 'Автоподбор не нашёл рабочую стратегию — оставлена прежняя', 'web.warn.auto_select_failed');
}

if (cmd == 'select') {
	let l = lock('select');
	if (!l) exit(1);
	let args = {};
	try { args = json(ARGV[1] ?? '{}'); } catch (e) {}
	try { sel.select_run(args); } catch (e) { warn('select_failed', `Подбор прервался: ${e}`, 'web.warn.select_failed', { error: `${e}` }); }
	unlink(l);
}
else if (cmd == 'check') {
	if (st.job_running('select')) exit(1);
	let l = lock('check');
	if (!l) exit(1);
	try { sel.check_run(ARGV[1] == 'manual' ? 'manual' : 'app', false); } catch (e) {}
	unlink(l);
}
else if (cmd == 'watch')
	watch();
else if (cmd == 'recover')
	recover_jobs();
else if (cmd == 'guard')
	guard();
// cron раз в 5 мин (nice): сторож — каждый раз, остальное — раз в 30 мин. Одна строка вместо двух — проверки не пересекаются.
else if (cmd == 'tick') {
	recover_jobs();
	guard();
	pc_refresh();
	let T = '/tmp/dpishell/tick.json';
	if (time() - (st.read_json(T, { watch_at: 0 }).watch_at ?? 0) >= 30 * 60 - 60) {
		st.write_atomic(T, sprintf('%J\n', { watch_at: time() }));
		watch();
	}
}
// Откат неподтверждённого включения (confirm_s): ждать до until, пока ожидание то же (token); run revert now — сразу (при загрузке).
else if (cmd == 'revert') {
	let p = st.read_json(st.PENDING, null);
	if (!p) exit(0);
	if (ARGV[1] != 'now')
		while (time() < p.until) {
			sleep(1000);
			let cur = st.read_json(st.PENDING, null);
			if (cur?.token != p.token) exit(0);
		}
	// Прежние настройки продвинутого режима (advanced_set с confirm_s) — до записи config.
	if (p.advanced?.absent)
		unlink(st.ADVANCED);
	else if (p.advanced != null)
		st.write_atomic(st.ADVANCED, sprintf('%J\n', p.advanced));
	if (p.revert_to == 'off')
		system('/usr/libexec/dpishell/off revert');
	else {
		let s = st.settings();
		s.strategy = p.revert_to;
		if (!st.write_zapret_config(p.revert_to, s))
			system('/etc/init.d/zapret enable; /etc/init.d/zapret restart >/dev/null 2>&1');
		st.uci_set({ strategy: p.revert_to, enabled: 1 });
		unlink(st.PENDING);
		warn('confirm_reverted', 'Новая стратегия отменена: не подтвердили вовремя', 'router.off.revert_strategy_at', { time: time() });
		st.write_status_json();
	}
}
else if (cmd == 'core_install') {
	let l = lock('core_install');
	if (!l) exit(1);
	let e = null;
	try { e = core.install(msg => st.write_atomic('/tmp/dpishell/core_install.json', sprintf('%J\n', { running: true, message: msg }))); }
	catch (x) { e = `${x}`; }
	st.write_atomic('/tmp/dpishell/core_install.json', sprintf('%J\n', { running: false, ok: !e, message: e ?? 'Ядро установлено' }));
	warn('core_install_failed', e);
	let s = st.settings();
	if (!e && s.enabled && s.strategy && !st.write_zapret_config(s.strategy, s))
		system('/etc/init.d/zapret enable; /etc/init.d/zapret restart >/dev/null 2>&1');
	st.write_status_json();
	unlink(l);
}
else if (cmd == 'dns_analyze' || cmd == 'dns_enable' || cmd == 'dns_restore' || cmd == 'dns_set') {
	let l = lock('dns');
	if (!l) exit(1);
	let job = '/tmp/dpishell/dns_job.json';
	st.write_atomic(job, sprintf('%J\n', { action: cmd, running: true }));
	let e = null;
	try {
		if (cmd == 'dns_analyze') dns.analyze();
		else if (cmd == 'dns_enable') { e = dns.enable(); if (!e) dns.analyze(); }
		// Вариант уже проверен rpcd и записан им (свой — в dns-custom.json), здесь только id.
		else if (cmd == 'dns_set') { e = dns.apply(st.read_json('/tmp/dpishell/dns_set.json', {}).preset); if (!e) dns.analyze(); }
		else e = dns.restore();
	} catch (x) { e = `${x}`; }
	st.write_atomic(job, sprintf('%J\n', { action: cmd, running: false, ...job_result(e, 'Готово'), at: time() }));
	let ds = st.read_json('/etc/dpishell/dns-status.json', {});
	warn('dns_spoofed', ds.spoofed && dns.status().mode != 'doh' ? 'Провайдер подменяет адреса сайтов — приложения вне браузера могут не работать' : null,
		'web.warn.dns_spoofed');
	unlink(l);
}
else if (cmd == 'dns_compare') {
	// «Сравнить скорость» фоном (rpcd dns_compare_start): curl по 4 с — вне rpcd, итог — dns_compare_result.
	let l = lock('dns_compare');
	if (!l) exit(1);
	let f = `${st.P.run}/dns_compare.json`, items = null;
	try { items = dns.compare(); } catch (x) {}
	st.write_atomic(f, sprintf('%J\n', { running: false, items, at: time() }));
	unlink(l);
}
else if (cmd == 'site_check') {
	let l = lock('site_check');
	if (!l) exit(1);
	st.write_atomic('/tmp/dpishell/site_check.json', sprintf('%J\n', { running: true, url: ARGV[1] }));
	let r;
	try { r = dg.site_check(ARGV[1]); } catch (e) { r = { running: false, url: ARGV[1], error: `${e}` }; }
	st.write_atomic('/tmp/dpishell/site_check.json', sprintf('%J\n', r));
	unlink(l);
}
else if (cmd == 'update' || cmd == 'update_check' || cmd == 'rollback') {
	// Обновление и откат: пакет заменяет сам себя (и этот файл) — сценарий уже в памяти, итог — в /tmp (router-api.md §5,
	// update_install, update_rollback). Откат: rollback saved — пакеты из флеша, rollback local — из папки окна ПК.
	let l = lock('update');
	if (!l) exit(1);
	let from = cmd == 'rollback' ? (ARGV[1] == 'local' ? 'local' : 'saved') : (ARGV[1] == 'local' ? 'local' : 'feed');
	let job = { action: cmd, from, running: true, step: cmd != 'update_check' ? 'download' : null, started_at: time(),
		from_version: upd.installed_version('dpishell'), target: null, log: [] };
	upd.job_put(job, {});
	let e = null;
	try {
		if (cmd == 'update_check') upd.check();
		else e = upd.install(from, job, cmd == 'rollback');
	} catch (x) { e = `${x}`; }
	let v = upd.installed_version('dpishell');
	upd.job_put(job, { running: false, step: 'done',
		...job_result(e, cmd == 'update' ? `Обновлено до ${v}` : cmd == 'rollback' ? `Возвращена версия ${v}` : 'Проверено') });
	// Пакеты из окна ПК после установки (успешной или нет) — не нужны: при повторе окно кладёт их заново.
	if (cmd != 'update_check' && from == 'local')
		try { upd.local_cleanup(0, true); } catch (x) {}
	unlink(l);
}
// «Изменено DpiShell»: отмена пункта или всех (changes_undo / changes_undo_all); итог по пунктам — changes_job.json.
else if (cmd == 'changes_undo') {
	let l = lock('changes');
	if (!l) exit(1);
	try { chg.undo(ARGV[1] ?? ''); }
	catch (x) { st.write_atomic(chg.JOB, sprintf('%J\n', { id: ARGV[1], running: false, ok: false, error: `${x}`, items: [], at: time() })); }
	unlink(l);
}
else {
	print('usage: run select|check|watch|core_install|site_check|dns_compare\n');
	exit(2);
}
