#!/usr/bin/ucode -S
// Фоновые задания DpiShell: подбор, проверка, проверка по таймеру.
//   run select '<json args>'   — подбор (select_start)
//   run check <manual|app>     — полная проверка текущей стратегии
//   run watch                  — проверка по таймеру: запасные стратегии, автоподбор (06 §3.5)
'use strict';

import { writefile, readfile, stat, unlink } from 'fs';
import * as st from 'dpishell.state';
import * as sel from 'dpishell.select';
import * as core from 'dpishell.core';
import * as dg from 'dpishell.diag';
import * as dns from 'dpishell.dns';
import * as upd from 'dpishell.update';

const cmd = ARGV[0];

// Замок с PID: если хозяин умер (ошибка, kill), замок считается снятым — иначе задание не запустить до перезагрузки.
function lock(name) {
	let f = `/tmp/dpishell/${name}.lock`;
	let pid = +trim(readfile(f) ?? '');
	if (pid && stat(`/proc/${pid}`))
		return null;
	st.ensure_dirs();
	writefile(f, `${split(readfile('/proc/self/stat'), ' ')[0]}\n`);
	return f;
}

function warn(code, text) {
	let w = filter(st.read_json('/tmp/dpishell/warnings.json', []), x => x.code != code);
	if (text)
		push(w, { code, text });
	st.write_atomic('/tmp/dpishell/warnings.json', sprintf('%J\n', w));
}

if (cmd == 'select') {
	let l = lock('select');
	if (!l) exit(1);
	let args = {};
	try { args = json(ARGV[1] ?? '{}'); } catch (e) {}
	try { sel.select_run(args); } catch (e) { warn('select_failed', `Подбор прервался: ${e}`); }
	unlink(l);
}
else if (cmd == 'check') {
	if (st.job_running('select')) exit(1);
	let l = lock('check');
	if (!l) exit(1);
	try { sel.check_run(ARGV[1] == 'manual' ? 'manual' : 'app', false); } catch (e) {}
	unlink(l);
}
else if (cmd == 'watch') {
	let dw = null;
	try { dw = dns.watch(); } catch (x) {}
	// Есть ли новая версия DpiShell — раз в сутки (07 §9, status.update).
	if (!st.job_running('update'))
		try { upd.check_daily(); } catch (x) {}
	if (dw == 'dns_fallback') warn('dns_fallback', 'Защищённый DNS недоступен — временно работает DNS провайдера');
	else if (dw == 'dns_back') warn('dns_fallback', null);
	let s = st.settings();
	if (!s.schedule.enabled || !s.enabled || st.job_running('select')) exit(0);
	// Интервал выдерживаем сами: cron зовёт каждые 30 мин.
	let last = st.read_json(`${st.P.etc}/last-check.json`, null);
	if (last && time() - last.at < s.schedule.hours * 3600 - 120) exit(0);
	let l = lock('check');
	if (!l) exit(0);
	let r = sel.check_run('timer', true);
	unlink(l);
	if (!r || r.fail_streak < 2) exit(0);
	// Две неудачи подряд: следующая запасная (02-spec §9.15 — на роутере остаётся).
	let backups = s.backups;
	if (length(backups)) {
		let next = backups[0];
		s.strategy = next;
		if (!st.write_zapret_config(next, s) && system('/etc/init.d/zapret restart >/dev/null 2>&1') == 0) {
			st.uci_set({ strategy: next, backups: slice(backups, 1) });
			st.write_atomic(`${st.P.etc}/fail-streak.json`, '0\n');
			warn('switched_backup', `Стратегия перестала работать — включена запасная ${next}`);
			st.write_status_json();
		}
		exit(0);
	}
	if (!s.schedule.auto_select) {
		warn('switched_backup', null);
		exit(0);
	}
	let lr = st.read_json(`${st.P.etc}/auto-select.json`, { at: 0 });
	if (time() - lr.at < 6 * 3600) exit(0);
	st.write_atomic(`${st.P.etc}/auto-select.json`, sprintf('%J\n', { at: time() }));
	let ls = lock('select');
	if (!ls) exit(0);
	let p = sel.select_run({ mode: 'quick', depth: 'main', started_by: 'timer' });
	unlink(ls);
	if (p.applied)
		warn('auto_selected', `Автоподбор включил ${p.best}`);
	else
		warn('auto_select_failed', 'Автоподбор не нашёл рабочую стратегию — оставлена прежняя');
}
else if (cmd == 'core_install') {
	let l = lock('core_install');
	if (!l) exit(1);
	let e = null;
	try { e = core.install(msg => st.write_atomic('/tmp/dpishell/core_install.json', sprintf('%J\n', { running: true, message: msg }))); }
	catch (x) { e = `${x}`; }
	st.write_atomic('/tmp/dpishell/core_install.json', sprintf('%J\n', { running: false, ok: !e, message: e ?? 'Ядро установлено' }));
	warn('core_install_failed', e);
	let s = st.settings();
	if (!e && s.enabled && s.strategy && !st.write_zapret_config(s.strategy, s))
		system('/etc/init.d/zapret enable; /etc/init.d/zapret restart >/dev/null 2>&1');
	st.write_status_json();
	unlink(l);
}
else if (cmd == 'dns_analyze' || cmd == 'dns_enable' || cmd == 'dns_restore' || cmd == 'dns_set') {
	let l = lock('dns');
	if (!l) exit(1);
	let job = '/tmp/dpishell/dns_job.json';
	st.write_atomic(job, sprintf('%J
', { action: cmd, running: true }));
	let e = null;
	try {
		if (cmd == 'dns_analyze') dns.analyze();
		else if (cmd == 'dns_enable') { e = dns.enable(); if (!e) dns.analyze(); }
		// Вариант уже проверен rpcd и записан им (свой — в dns-custom.json), здесь только id.
		else if (cmd == 'dns_set') { e = dns.apply(st.read_json('/tmp/dpishell/dns_set.json', {}).preset); if (!e) dns.analyze(); }
		else e = dns.restore();
	} catch (x) { e = `${x}`; }
	st.write_atomic(job, sprintf('%J
', { action: cmd, running: false, ok: !e, message: e ?? 'Готово', at: time() }));
	let ds = st.read_json('/etc/dpishell/dns-status.json', {});
	warn('dns_spoofed', ds.spoofed && dns.status().mode != 'doh' ? 'DNS провайдера подменяет адреса — приложения вне браузера могут не работать' : null);
	unlink(l);
}
else if (cmd == 'site_check') {
	let l = lock('site_check');
	if (!l) exit(1);
	st.write_atomic('/tmp/dpishell/site_check.json', sprintf('%J\n', { running: true, url: ARGV[1] }));
	let r;
	try { r = dg.site_check(ARGV[1]); } catch (e) { r = { running: false, url: ARGV[1], error: `${e}` }; }
	st.write_atomic('/tmp/dpishell/site_check.json', sprintf('%J\n', r));
	unlink(l);
}
else if (cmd == 'update' || cmd == 'update_check') {
	// Обновление: пакет заменяет сам себя (и этот файл) — сценарий уже в памяти, итог — в /tmp (07 §9, update_install).
	let l = lock('update');
	if (!l) exit(1);
	let job = '/tmp/dpishell/update_job.json';
	let from = ARGV[1] == 'local' ? 'local' : 'feed';
	st.write_atomic(job, sprintf('%J\n', { action: cmd, from, running: true }));
	let e = null;
	try {
		if (cmd == 'update_check') upd.check();
		else e = upd.install(from);
	} catch (x) { e = `${x}`; }
	st.write_atomic(job, sprintf('%J\n', { action: cmd, from, running: false, ok: !e,
		message: e ?? (cmd == 'update' ? `Обновлено до ${upd.installed_version('dpishell')}` : 'Проверено'), at: time() }));
	unlink(l);
}
else {
	print('usage: run select|check|watch|core_install|site_check\n');
	exit(2);
}
