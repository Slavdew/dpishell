{
	"dpishell": {
		"description": "DpiShell: управление обходом DPI (объект dpishell; из файлов — только загрузка архива ядра через cgi-upload, без exec)",
		"read": {
			"ubus": {
				"dpishell": [ "status", "strategies", "select_progress", "targets_get", "lists_get", "diag", "report",
				              "dns_status", "site_check_result", "dns_presets" ]
			}
		},
		"write": {
			"file": {
				"/tmp/dpishell-core.zip": [ "write" ]
			},
			"ubus": {
				"dpishell": [ "enable", "disable", "strategy_set", "mode_set", "check_now", "select_start", "select_cancel", "apply",
				              "schedule_set", "targets_set", "lists_set", "strategies_user_set", "conflict_stop", "core_install",
				              "dns_analyze", "dns_enable", "dns_restore", "site_check", "flow_offload_fix", "ipv6_set", "dns_set", "uninstall", "update_install", "update_check" ]
			}
		}
	}
}
