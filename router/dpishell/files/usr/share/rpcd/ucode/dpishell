// Продвинутый режим (router-api §5.2, mixed-strategies.md §6): строки «сайты → стратегия» и режим остальных адресов.
// resolved у «auto» — итог подбора для строки, до подбора — текущая стратегия; у «direct» — null.
methods.advanced_get = {
	call: function() {
		let a = st.advanced(), s = st.settings();
		return { enabled: a.enabled, others: a.others, rows: map(a.rows, r => ({ domains: r.domains, strategy: r.strategy,
			resolved: r.strategy == 'direct' ? null : r.strategy == 'auto' ? (r.resolved ?? s.strategy ?? null) : r.strategy })) };
	}
};

methods.advanced_set = {
	args: { enabled: false, others: 'others', rows: [], confirm_s: 180 },
	call: function(req) {
		let b = busy(); if (b) return b;
		let a = req.args;
		if (type(a.enabled) != 'bool')
			return err('invalid', 'enabled: true/false', 'enabled');
		if (index(st.ADV_OTHERS, a.others) < 0)
			return err('invalid', 'Остальные адреса: direct, lists или all', 'others');
		let rows = lines_of(a.rows);
		if (!rows || length(rows) > 20)
			return err('invalid', 'rows: список, не больше 20 строк', 'rows');
		let c = trial_arg(a); if (type(c) == 'object') return c;
		let prev = st.advanced(), out = [];
		for (let i = 0; i < length(rows); i++) {
			let r = rows[i], doms = lines_of(r?.domains);
			if (!doms || !length(doms) || length(doms) > 50)
				return err('invalid', 'В строке от 1 до 50 сайтов', `rows[${i}].domains`);
			let clean = [];
			for (let j = 0; j < length(doms); j++) {
				let d = lc(trim(`${doms[j]}`));
				// В --hostlist-domains — через запятую: «^» и пробелы туда не годятся, только имя.
				if (!st.valid_domain_line(d) || index(d, '^') >= 0)
					return err('invalid', 'Домен вида example.com', `rows[${i}].domains[${j}]`);
				push(clean, d);
			}
			let sid = r.strategy ?? 'auto';
			if (type(sid) != 'string' || (sid != 'auto' && sid != 'direct' && !cat.find(st.catalogs(), sid)))
				return err('invalid', 'Стратегия: auto, direct или id из списка', `rows[${i}].strategy`);
			// resolved подбора сохраняется, пока строка та же (те же сайты и «auto»).
			let old = filter(prev.rows, x => x.strategy == 'auto' && join(',', x.domains) == join(',', clean))[0];
			push(out, { domains: clean, strategy: sid, ...(sid == 'auto' && old?.resolved ? { resolved: old.resolved } : {}) });
		}
		let s = st.settings(), before = { enabled: s.enabled, strategy: s.strategy };
		// Файла не было — откат (advanced_revert) его уберёт, а не оставит пустые настройки (absent).
		let prev_file = st.read_json(st.ADVANCED, null) ?? { enabled: false, others: 'lists', rows: [], absent: true };
		st.ensure_dirs();
		if (!st.write_atomic(st.ADVANCED, sprintf('%J\n', { enabled: a.enabled, others: a.others, rows: out })))
			return err('failed', 'Не удалось сохранить');
		// Для «Вернуть как было» (advanced_revert) — состояние до этого сохранения; после записи: неудача не затирает прежнее.
		st.write_atomic(`${st.ADVANCED}.prev`, sprintf('%J\n', prev_file));
		if (s.enabled && s.strategy) {
			let e = st.write_zapret_config(s.strategy, s);
			if (e) return err('failed', e);
			let z = zapret('restart');
			if (z) return z;
			trial_start(c, before, prev_file);
		}
		st.write_status_json();
		return {};
	}
};

// «Вернуть как было» для своих настроек для сайтов: состояние до последнего advanced_set (одна ступень, повтор — «нечего»).
methods.advanced_revert = {
	call: function() {
		let b = busy(); if (b) return b;
		let prev = st.read_json(`${st.ADVANCED}.prev`, null);
		if (!prev)
			return { nothing: true };
		if (prev.absent ? (!unlink(st.ADVANCED) && stat(st.ADVANCED)) : !st.write_atomic(st.ADVANCED, sprintf('%J\n', prev)))
			return err('failed', 'Не удалось сохранить');
		unlink(`${st.ADVANCED}.prev`);
		let s = st.settings();
		if (s.enabled && s.strategy) {
			let e = st.write_zapret_config(s.strategy, s);
			if (e) return err('failed', e);
			let z = zapret('restart');
			if (z) return z;
		}
		st.write_status_json();
		return {};
	}
};

// Совместная работа с ПК (router-api §5.2, mixed-strategies.md §7): у ПК свой nfqws (очередь 200+n) с исключением
// его сайтов, по MAC. Домены, которыми владеет роутер, не берутся — ignored. Связка живёт 24 ч без продления.
function pc_apply(changed) {
	let s = st.settings();
	if (!changed || !s.enabled || !s.strategy)
		return null;
	let e = st.write_zapret_config(s.strategy, s);
	return e ? err('failed', e) : zapret('restart');
}

function pc_save(items) {
	// Истёкшие больше 7 дней назад — удаляются.
	items = filter(items, x => x.expires_at > time() - 7 * 86400);
	st.ensure_dirs();
	let ok = st.write_atomic(st.PC_LINKS, sprintf('%J\n', { items }));
	// Сроки во флеше теперь свежие — копия в ОЗУ не нужна (pc_renew).
	if (ok) unlink(st.PC_EXPIRY);
	return ok;
}

// Продление без перемен (pc_link_set раз в 30 мин): срок — только в ОЗУ, флеш не трогаем.
function pc_renew(it) {
	st.ensure_dirs();
	let ex = st.read_json(st.PC_EXPIRY, {});
	ex[it.id] = { seen_at: it.seen_at, expires_at: it.expires_at };
	return st.write_atomic(st.PC_EXPIRY, sprintf('%J\n', ex));
}

methods.pc_link_set = {
	args: { id: 'id', macs: [], domains: [] },
	call: function(req) {
		let a = req.args, id = a.id;
		if (type(id) != 'string' || !match(id, /^[A-Za-z0-9-]{8,64}$/))
			return err('invalid', 'id ПК: 8–64 символа, буквы, цифры, дефис', 'id');
		let macs = lines_of(a.macs), doms = lines_of(a.domains);
		if (!macs || !length(macs) || length(macs) > 8)
			return err('invalid', 'От 1 до 8 MAC-адресов', 'macs');
		let m2 = [];
		for (let i = 0; i < length(macs); i++) {
			let m = lc(replace(trim(`${macs[i]}`), '-', ':'));
			if (!match(m, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
				return err('invalid', 'MAC вида aa:bb:cc:dd:ee:ff', `macs[${i}]`);
			push(m2, m);
		}
		if (!doms || length(doms) > 500)
			return err('invalid', 'Сайты ПК: список, не больше 500', 'domains');
		let d2 = [];
		for (let i = 0; i < length(doms); i++) {
			let d = lc(trim(`${doms[i]}`));
			if (!st.valid_domain_line(d) || index(d, '^') >= 0)
				return err('invalid', 'Домен вида example.com', `domains[${i}]`);
			push(d2, d);
		}
		let items = st.pc_links(), old = filter(items, x => x.id == id)[0];
		if (!old && length(filter(items, x => x.expires_at > time())) >= st.PC_MAX)
			return err('invalid', `Не больше ${st.PC_MAX} компьютеров одновременно`, 'id');
		let now = time(), it = { id, macs: m2, domains: d2, seen_at: now, expires_at: now + st.PC_TTL };
		let was_active = old && old.expires_at > now;
		let changed = !was_active || join(',', old.macs) != join(',', m2) || join(',', old.domains) != join(',', d2);
		if (!(changed ? pc_save([...filter(items, x => x.id != id), it]) : pc_renew(it)))
			return err('failed', 'Не удалось сохранить');
		let e = pc_apply(changed);
		if (e) return e;
		st.write_status_json();
		return { expires_at: st.iso(it.expires_at), ignored: st.pc_split(d2).ignored };
	}
};

methods.pc_link_del = {
	args: { id: 'id' },
	call: function(req) {
		let items = st.pc_links(), old = filter(items, x => x.id == req.args.id)[0];
		if (!old)
			return {};
		if (!pc_save(filter(items, x => x.id != req.args.id)))
			return err('failed', 'Не удалось сохранить');
		return pc_apply(old.expires_at > time()) ?? {};
	}
};

