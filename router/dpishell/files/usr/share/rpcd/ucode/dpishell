// Удаление DpiShell (ядро договора, router-api.md §5): сценарий копируется в /tmp и идёт отвязанно — пакет и этот объект ubus
// исчезают по ходу. Ход и итог — /tmp/dpishell-uninstall.json; страница ждёт, пока объект dpishell пропадёт.
methods.uninstall = {
	args: { keep_settings: true },
	call: function(req) {
		let keep = req.args.keep_settings;
		if (keep != null && type(keep) != 'bool')
			return err('invalid', 'keep_settings: true/false', 'keep_settings');
		let r = sh(`cp /usr/libexec/dpishell/uninstall.sh /tmp/dpishell-uninstall.sh && chmod 700 /tmp/dpishell-uninstall.sh`);
		if (r.rc != 0)
			return err('failed', `Не удалось запустить удаление: ${trim(r.out)}`);
		sh(`( setsid ${DETACH} sh /tmp/dpishell-uninstall.sh ${keep === false ? '--full' : '--keep'} >/dev/null 2>&1 & )`);
		return { started: true };
	}
};

// Обновление (ядро договора, router-api.md §5): из витрины или из /tmp/dpishell-update (кладёт окно ПК; путь не принимается).
methods.update_install = {
	args: { from: 'feed' },
	call: function(req) {
		let from = req.args.from ?? 'feed';
		if (index(['feed', 'local'], from) < 0)
			return err('invalid', 'from: feed или local', 'from');
		if (st.job_running('select'))
			return err('busy', 'Идёт подбор');
		if (st.job_running('update'))
			return err('busy', 'Обновление уже идёт');
		if (from == 'local' && !stat(`${upd.LOCAL_DIR}/SHA256SUMS`))
			return err('invalid', `Нет пакетов в ${upd.LOCAL_DIR}`, 'from');
		spawn(`update ${from}`);
		return { started: true };
	}
};

