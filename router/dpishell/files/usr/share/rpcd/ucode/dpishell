// ubus-объект dpishell: методы договора docs/dev/router-api.md. Страница LuCI и Windows-приложение вызывают одно и то же.
// Ни один метод не принимает командную строку или путь: всё проверяется здесь.
'use strict';

import { readfile, writefile, stat, popen, unlink } from 'fs';
import * as cat from 'dpishell.catalog';
import * as st from 'dpishell.state';
import * as core from 'dpishell.core';
import * as dg from 'dpishell.diag';
import * as dns from 'dpishell.dns';
import * as upd from 'dpishell.update';
import * as sec from 'dpishell.security';
import * as chg from 'dpishell.changes';

// Ошибка: text — готовый русский (старые окна), key/params — ключ общего словаря и сырые параметры (router-api.md §9,
// 2026-10-20): окно и страница собирают фразу на своём языке, если знают ключ.
// Частые тексты — ключами словаря (страница и окно ПК переводят); остальные (технические, для разработчика) — только text.
const TEXT_KEYS = {
	'Ядро zapret не установлено': 'web.core.missing',
	'Стратегия не выбрана и подборов ещё не было — запустите подбор': 'web.err.no_strategy',
	'Нет такой стратегии': 'web.err.no_strategy_id',
	'Не больше 50 адресов': 'web.err.max50',
	'Адрес вида https://example.com/': 'web.err.url',
	'Не удалось сохранить': 'web.err.save',
	'Подсеть вида 1.2.3.0/24': 'web.err.subnet',
	'Домен вида example.com': 'web.err.domain',
	'Список своих адресов на роутере пуст — добавьте адреса или выберите другие группы': 'web.err.no_user_sites',
	'В строке от 1 до 50 сайтов': 'web.err.row_sites',
	'Стратегия: auto, direct или id из списка': 'web.err.row_strategy',
	'Оптимизация выключена — проверять нечего': 'web.err.check_off',
	'Архитектура роутера не поддерживается': 'web.err.arch',
	'Адрес вида example.com': 'web.err.site',
	'Идёт подбор': 'web.err.busy_select',
	'Обновление уже идёт': 'web.err.busy_update',
	'До 4 адресов IPv4/IPv6': 'web.err.ips4',
	'Название до 40 символов': 'web.err.title40',
	'Адрес DoH вида https://сервер/dns-query': 'web.err.doh',
	'Нужен адрес DoH или обычные адреса DNS': 'web.err.doh_or_plain',
	'Укажите адреса сервера DoH (bootstrap)': 'web.err.boot',
	'Идёт настройка DNS': 'web.err.busy_dns',
	'Этот список менять нельзя': 'web.err.list_ro'
};

function err(code, text, field, key, params) {
	key ??= TEXT_KEYS[text];
	let e = { code, text };
	if (field)
		e.field = field;
	if (key) {
		e.key = key;
		e.params = params ?? {};
	}
	return { error: e };
}

function busy() {
	return st.job_running('select') ? err('busy', 'Идёт подбор', null, 'web.err.busy_select') : null;
}

// Чужой обход работает — включение и подбор заблокированы (architecture.md «Пакет для роутера»): два обхода обрабатывали бы одни пакеты.
function conflict() {
	let running = filter(dg.conflicts(), c => c.running);
	let names = join(', ', map(running, c => c.name));
	return length(running) ? err('conflict', `Работает похожая программа: ${names} — остановите её на вкладке «Диагностика»`, null,
		'web.err.conflict', { names }) : null;
}

function sh(cmd) {
	let p = popen(`${cmd} 2>&1`);
	let out = p ? p.read('all') : '';
	let rc = p ? p.close() : -1;
	return { rc, out };
}

function zapret(action) {
	if (!st.core_installed())
		return err('not_installed', 'Ядро zapret не установлено');
	let r = sh(`/etc/init.d/zapret ${action}`);
	return r.rc == 0 ? null : err('failed', `zapret ${action}: ${trim(r.out)}`);
}

// Запуск вне cgroup rpcd: иначе перезапуск rpcd (postinst при обновлении, удаление) упирается в занятую cgroup
// («failed to remove busy cgroup of rpcd::instance1») или procd убивает задание вместе с rpcd — и rpcd не поднимается.
const DETACH = `sh -c 'echo $$ > /sys/fs/cgroup/cgroup.procs 2>/dev/null; exec "$@"' detach`;

// tok — метка замка, занятого заранее (st.job_reserve): задание заберёт его себе, второй вызов до его старта получит «занято».
function spawn(args, tok) {
	// Фоном, без ожидания: rpcd-вызов должен вернуться сразу (router-api §4).
	let env = tok ? `DPS_LOCK=${tok} ` : '';
	sh(`( ${env}${DETACH} /usr/libexec/dpishell/run ${args} >/dev/null 2>&1 & )`);
}

// Подтверждение включения (architecture.md «Аварийный выключатель»): confirm_s — сколько ждать confirm, иначе откат
// к revert_to. Повторное включение до подтверждения откатывает к первому подтверждённому состоянию.
function trial_arg(a) {
	let c = a.confirm_s;
	if (c == null)
		return null;
	if (type(c) != 'int' || c < 60 || c > 600)
		return err('invalid', 'confirm_s: 60–600 с', 'confirm_s');
	return c;
}

// advanced — прежние настройки продвинутого режима (advanced_set): откат возвращает и их. При цепочке включений
// откат идёт к самому первому состоянию — его advanced тоже не перезаписываем.
function trial_start(c, s, advanced) {
	if (c == null)
		return;
	let prev = st.read_json(st.PENDING, null);
	let revert_to = prev ? prev.revert_to : (s.enabled && s.strategy ? s.strategy : 'off');
	let adv = prev ? prev.advanced : advanced;
	st.write_atomic(st.PENDING, sprintf('%J\n', { until: time() + c, revert_to, token: `${time()}-${c}-${s.strategy}`,
		...(adv != null ? { advanced: adv } : {}) }));
	spawn('revert');
}

// Человек включил сам — прежние «выключено кнопкой/сторожем/откатом» больше не к месту. Включил или запустил подбор
// (only_select) — сторож снова может один раз подобрать сам.
function clear_off(only_select) {
	unlink(st.WATCHDOG_SELECT);
	let codes = only_select ? ['watchdog_select_failed'] : ['watchdog_off', 'button_off', 'confirm_reverted', 'watchdog_select_failed'];
	if (!only_select)
		unlink(st.LAST_OFF);
	let w = filter(st.read_json(`${st.P.run}/warnings.json`, []), x => index(codes, x.code) < 0);
	st.write_atomic(`${st.P.run}/warnings.json`, sprintf('%J\n', w));
}

// status.watchdog: жив ли сторож — время и итог последней проверки, через сколько минут следующая (растёт при обрыве).
function guard_status(s) {
	let g = st.read_json('/tmp/dpishell/guard.json', null);
	let ws = st.read_json(st.WATCHDOG_SELECT, null);
	return { enabled: s.schedule.watchdog, checked_at: st.iso(g?.checked_at), ok: g?.ok ?? null, interval_min: g?.interval ?? 5,
		select: ws ? { at: st.iso(ws.at), ok: !!ws.ok, best: ws.best ?? null } : null };
}

// Медленные факты для status.warnings (обход /proc, процессы uci, sh network.sh + ip, df): страница зовёт status раз
// в 1–10 с — считаем не чаще раза в 60 с; во время подбора не пересчитываем (мешало бы замерам). Сбрасывают conflict_stop
// и flow_offload_fix. Модуль rpcd живёт между вызовами — кеш в памяти, без записи в файлы.
const FACTS_TTL = 60;
let facts_memo = null;

function slow_facts() {
	let now = time();
	if (facts_memo && (now - facts_memo.at < FACTS_TTL || st.job_running('select')))
		return facts_memo;
	facts_memo = { at: now, conflicts: filter(dg.conflicts(), c => c.running), flow_offload: dg.flow_offload(),
		ipv6_wan: dg.ipv6_wan(), overlay_free_kb: dg.overlay_free_kb() };
	return facts_memo;
}

function warnings(s) {
	let w = [];
	let f = slow_facts();
	// key/params — ключ общего словаря и сырые параметры (router-api.md §9, 2026-10-20); text — для старых окон.
	if (!st.core_installed())
		push(w, { code: 'core_missing', text: 'Ядро zapret не установлено', key: 'web.core.missing', params: {} });
	let running = f.conflicts;
	if (length(running)) {
		let names = join(', ', map(running, c => c.name));
		push(w, { code: 'conflict', text: `Мешает похожая программа: ${names}`, key: 'web.warn.conflict', params: { names } });
	}
	if (f.flow_offload)
		push(w, { code: 'flow_offload', text: 'Ускорение сети мешает оптимизации', key: 'router.warn.flow_offload', params: {} });
	if (!s.ipv6 && f.ipv6_wan)
		push(w, { code: 'ipv6', text: 'Сайты по IPv6 идут мимо оптимизации', key: 'router.warn.ipv6', params: {} });
	// Флеш почти полон (с r14): настройки, в т.ч. выключение, могут не сохраниться.
	if (f.overlay_free_kb != null && f.overlay_free_kb < 1024)
		push(w, { code: 'flash_full', text: `Во флеше роутера почти нет места (${f.overlay_free_kb} КБ) — настройки могут не сохраниться`,
			key: 'web.warn.flash_full', params: { kb: f.overlay_free_kb } });
	for (let x in st.read_json(`${st.P.run}/warnings.json`, []))
		push(w, x);
	let off = s.enabled ? null : st.last_off();
	if (off) {
		let key = { watchdog: 'router.off.watchdog_at', button: 'router.off.button_at' }[off.by] ?? 'router.off.revert_enable_at';
		push(w, { code: off.by == 'watchdog' ? 'watchdog_off' : off.by == 'button' ? 'button_off' : 'confirm_reverted', text: off.text,
			key, params: { time: off.at } });
	}
	return w;
}

function jobs() {
	let j = {};
	for (let n in ['select', 'check', 'core_install', 'site_check'])
		j[n] = st.job_running(n);
	j.dns = st.job_running('dns');
	j.dns_analyze = j.dns;   // прежнее имя (router-api §5.1), то же значение
	j.update = st.job_running('update');
	j.changes = st.job_running('changes');
	return j;
}

function strategy_list() {
	let stats = st.read_json(`${st.P.etc}/stats.json`, {});
	let items = [];
	for (let c in st.catalogs())
		for (let s in c.strategies)
			push(items, {
				id: s.id, title: s.title ?? s.id, source: (s.source == 'user' || index(s.id, 'u-') == 0) ? 'user' : 'catalog',
				runs: stats[s.id]?.runs ?? 0, passed: stats[s.id]?.passed ?? 0,
				last: stats[s.id]?.last ? { ...stats[s.id].last, at: st.iso(stats[s.id].last.at) } : null,
				roles: s.roles ?? {},
				...(s.parts ? { parts: s.parts } : {}),
			});
	// Порядок — по статистике (architecture.md «Порядок по статистике»): доля удачных, затем число прогонов.
	return sort(items, (a, b) => {
		let ra = a.runs ? 1.0 * a.passed / a.runs : 0.5, rb = b.runs ? 1.0 * b.passed / b.runs : 0.5;
		return ra != rb ? (rb - ra) : (b.runs - a.runs);
	});
}

function lines_of(v) {
	return type(v) == 'array' ? v : null;
}

const LIST_LIMIT = 5000;

// status.update (router-api.md §5): { available, version, notes, checked_at, job } — job — последнее задание обновления.
function update_status() {
	upd.recover();
	let u = upd.status();
	u.job = st.read_json('/tmp/dpishell/update_job.json', null);
	if (u.job) { u.job.at = st.iso(u.job.at); u.job.started_at = st.iso(u.job.started_at); }
	return u;
}

// status.rollback (с 0.2.0-r16): прежняя версия { version, saved, reason } или null. Обновление, сделанное прежней версией
// пакета, — запомнить её как прежнюю без сохранённых пакетов (откат через окно ПК).
function rollback_status() {
	try { upd.learn_prev(); } catch (e) {}
	return upd.rollback_status();
}

// status.methods — методы, которые этот роутер реально обрабатывает (router-api.md §5): без заглушек «не реализовано».
// Таблица методов собирается ниже, поэтому — через реестр (ucode разрешает имена при компиляции).
const registry = { methods: {}, stubs: {} };

function implemented() {
	return sort(filter(keys(registry.methods), n => !registry.stubs[n]));
}

const methods = {
	status: {
		call: function() {
			let s = st.settings(), lc = st.last_check();
			let strat = s.strategy ? cat.find(st.catalogs(), s.strategy) : null;
			return {
				api: st.API, version: st.VERSION, min_app: st.MIN_APP, methods: implemented(), engine: 'zapret1',
				core: { version: 'v72.13', installed: st.core_installed(), hash_ok: st.core_installed() && core.verify(),
					installed_version: st.core_installed() ? st.read_json(`${st.P.etc}/core-installed.json`, {}).version ?? null : null },
				packages: { dpishell: upd.installed_version('dpishell'), 'luci-app-dpishell': upd.installed_version('luci-app-dpishell') },
				enabled: s.enabled, mode: s.mode, strategy: s.strategy, backups: s.backups,
				needs_tcp_timestamps: strat ? cat.uses_ts(strat) : false,
				last_check: lc ? { ...lc, at: st.iso(lc.at) } : null, fail_streak: st.read_json(`${st.P.etc}/fail-streak.json`, 0),
				schedule: s.schedule, jobs: jobs(), warnings: warnings(s), update: update_status(), rollback: rollback_status(),
				pending_confirm: st.pending_confirm(), last_off: s.enabled ? null : st.last_off(),
				watchdog: guard_status(s),
				advanced: ((a) => ({ enabled: a.enabled, rows: length(a.rows) }))(st.advanced()),
				pc_links: length(st.pc_active(s)),
			};
		}
	},

	strategies: {
		call: function() {
			return { catalog_version: st.catalog().version, items: strategy_list() };
		}
	},

	enable: {
		args: { confirm_s: 180 },
		call: function(req) {
			let b = busy() ?? conflict(); if (b) return b;
			let c = trial_arg(req.args); if (type(c) == 'object') return c;
			let s = st.settings();
			let before = { enabled: s.enabled, strategy: s.strategy };
			if (!s.strategy) {
				// Без стратегии — лучшая по статистике (architecture.md «Сборка config zapret из стратегии»); подбор без статистики — в select.uc.
				let best = strategy_list()[0];
				if (!best?.runs)
					return err('failed', 'Стратегия не выбрана и подборов ещё не было — запустите подбор');
				s.strategy = best.id;
				st.uci_set({ strategy: best.id });
			}
			let e = st.write_zapret_config(s.strategy, s);
			if (e) return err('failed', e);
			let z = zapret('enable') ?? zapret('restart');
			if (z) return z;
			st.uci_set({ enabled: 1 });
			clear_off();
			trial_start(c, before);
			st.write_status_json();
			return {};
		}
	},

	disable: {
		call: function() {
			let b = busy(); if (b) return b;
			if (st.core_installed()) {
				sh('/etc/init.d/zapret stop');
				sh('/etc/init.d/zapret disable');
			}
			unlink(st.PENDING);
			st.uci_set({ enabled: 0 });
			st.write_status_json();
			return {};
		}
	},

	strategy_set: {
		args: { id: 'id', confirm_s: 180 },
		call: function(req) {
			let b = busy(); if (b) return b;
			let id = req.args.id;
			if (type(id) != 'string' || !cat.find(st.catalogs(), id))
				return err('invalid', 'Нет такой стратегии', 'id');
			let c = trial_arg(req.args); if (type(c) == 'object') return c;
			let s = st.settings();
			let before = { enabled: s.enabled, strategy: s.strategy };
			s.strategy = id;
			if (s.enabled) {
				let e = st.write_zapret_config(id, s);
				if (e) return err('failed', e);
				let z = zapret('restart');
				if (z) return z;
				// Подтверждение — только когда обход работает: выключенному нечего откатывать.
				if (before.strategy != id)
					trial_start(c, before);
			}
			st.uci_set({ strategy: id });
			st.write_status_json();
			return {};
		}
	},

	mode_set: {
		args: { mode: 'mode' },
		call: function(req) {
			let b = busy(); if (b) return b;
			let m = req.args.mode;
			if (index(st.MODES, m) < 0)
				return err('invalid', 'Режим: all или lists', 'mode');
			let s = st.settings();
			s.mode = m;
			st.uci_set({ mode: m });
			if (s.enabled && s.strategy) {
				let e = st.write_zapret_config(s.strategy, s);
				if (e) return err('failed', e);
				let z = zapret('restart');
				if (z) return z;
			}
			// Полная проверка с контрольной группой после смены режима — check.uc (architecture.md «Режимы роутера»).
			return { started: false };
		}
	},

	// Разгрузка из firewall передаётся zapret: та же скорость, но пакеты для nfqws в обход разгрузки (architecture.md «Диагностика роутера»).
	flow_offload_fix: {
		call: function() {
			let b = busy(); if (b) return b;
			let fw = k => trim(sh(`uci -q get firewall.@defaults[0].${k}`).out) == '1';
			let sw = fw('flow_offloading'), hw = fw('flow_offloading_hw');
			let s = st.settings();
			if (!sw && !hw)
				return { changed: false, flowoffload: s.flowoffload };
			let mode = hw ? 'hardware' : 'software';
			let r = sh('uci set firewall.@defaults[0].flow_offloading=0 && uci set firewall.@defaults[0].flow_offloading_hw=0 && uci commit firewall');
			facts_memo = null;
			if (r.rc != 0)
				return err('failed', `firewall: ${trim(r.out)}`);
			st.uci_set({ flowoffload: mode, fw_offload_prev: mode });
			sh('/etc/init.d/firewall reload');
			s.flowoffload = mode;
			if (s.enabled && s.strategy) {
				let e = st.write_zapret_config(s.strategy, s);
				if (e) return err('failed', e);
				let z = zapret('restart');
				if (z) return z;
			}
			return { changed: true, flowoffload: mode };
		}
	},

	ipv6_set: {
		args: { enabled: true },
		call: function(req) {
			let b = busy(); if (b) return b;
			if (type(req.args.enabled) != 'bool')
				return err('invalid', 'enabled: true/false', 'enabled');
			let s = st.settings();
			s.ipv6 = req.args.enabled;
			st.uci_set({ ipv6: s.ipv6 ? 1 : 0 });
			if (s.enabled && s.strategy) {
				let e = st.write_zapret_config(s.strategy, s);
				if (e) return err('failed', e);
				let z = zapret('restart');
				if (z) return z;
			}
			return {};
		}
	},

	schedule_set: {
		args: { enabled: true, hours: 1, auto_select: false, watchdog: true },
		call: function(req) {
			let a = req.args;
			// Сначала проверяются все аргументы, потом пишется (ошибка — ничего не записано). Только сторож
			// ({ watchdog } без расписания) — меняется только он.
			if (a.watchdog != null && type(a.watchdog) != 'bool')
				return err('invalid', 'watchdog: true/false', 'watchdog');
			if (a.watchdog != null && a.enabled == null && a.hours == null && a.auto_select == null) {
				st.uci_set({ watchdog: a.watchdog ? 1 : 0 });
				return {};
			}
			if (type(a.enabled) != 'bool')
				return err('invalid', 'enabled: true/false', 'enabled');
			if (index(st.HOURS, a.hours) < 0)
				return err('invalid', 'Интервал: 0.5, 1, 3, 6, 12 или 24 ч', 'hours');
			if (a.auto_select != null && type(a.auto_select) != 'bool')
				return err('invalid', 'auto_select: true/false', 'auto_select');
			st.uci_set({ schedule_enabled: a.enabled ? 1 : 0, schedule_hours: a.hours, auto_select: a.auto_select ? 1 : 0,
				...(a.watchdog != null ? { watchdog: a.watchdog ? 1 : 0 } : {}) });
			sh('/etc/init.d/dpishell reload');
			return {};
		}
	},

	targets_get: {
		call: function() {
			return { items: st.read_json(`${st.P.etc}/user-targets.json`, []) };
		}
	},

	targets_set: {
		args: { items: [] },
		call: function(req) {
			let items = lines_of(req.args.items);
			if (!items)
				return err('invalid', 'items: список', 'items');
			if (length(items) > 50)
				return err('invalid', 'Не больше 50 адресов', 'items');
			let out = [];
			for (let i = 0; i < length(items); i++) {
				let it = items[i], url = it?.url;
				if (type(url) != 'string' || !match(url, /^https?:\/\/[a-z0-9.-]+(:[0-9]{1,5})?(\/[A-Za-z0-9._~%!$&'()*+,;=:@\/?-]*)?$/) || length(url) > 300)
					return err('invalid', 'Адрес вида https://example.com/', `items[${i}].url`);
				push(out, { url, important: it.important === true });
			}
			st.ensure_dirs();
			return st.write_atomic(`${st.P.etc}/user-targets.json`, sprintf('%J\n', out)) ? {} : err('failed', 'Не удалось сохранить');
		}
	},

	lists_get: {
		args: { name: 'name' },
		call: function(req) {
			let n = req.args.name;
			let editable = index(st.USER_LISTS, n) >= 0;
			// Встроенные — только чтение: exclude и (для окна при совместной работе) списки ролей google, discord, general.
			if (!editable && index(['exclude', 'google', 'discord', 'general'], n) < 0)
				return err('invalid', 'Нет такого списка', 'name');
			let path = editable ? `${st.P.lists}/${n}.txt` : `${st.P.share}/lists/${n}.txt`;
			let text = readfile(path) ?? '';
			return { lines: filter(split(text, '\n'), l => length(trim(l)) > 0), editable };
		}
	},

	lists_set: {
		args: { name: 'name', lines: [] },
		call: function(req) {
			let n = req.args.name, lines = lines_of(req.args.lines);
			if (index(st.USER_LISTS, n) < 0)
				return err('invalid', 'Этот список менять нельзя', 'name');
			if (!lines || length(lines) > LIST_LIMIT)
				return err('invalid', `Список строк, не больше ${LIST_LIMIT}`, 'lines');
			let ipset = index(n, 'ipset') >= 0;
			let out = [];
			for (let i = 0; i < length(lines); i++) {
				let l = lc(trim(`${lines[i]}`));
				if (!length(l))
					continue;
				if (!(ipset ? st.valid_subnet_line(l) : st.valid_domain_line(l)))
					return err('invalid', ipset ? 'Подсеть вида 1.2.3.0/24' : 'Домен вида example.com', `lines[${i}]`);
				push(out, l);
			}
			st.ensure_dirs();
			if (!st.write_atomic(`${st.P.lists}/${n}.txt`, join('\n', out) + (length(out) ? '\n' : '')))
				return err('failed', 'Не удалось сохранить');
			return {};   // nfqws перечитывает списки сам
		}
	},

	strategies_user_set: {
		args: { items: [] },
		call: function(req) {
			let items = lines_of(req.args.items);
			if (!items || length(items) > 50)
				return err('invalid', 'items: список, не больше 50', 'items');
			let r = st.roles(), out = [];
			for (let i = 0; i < length(items); i++) {
				let it = items[i];
				if (type(it?.id) != 'string' || !match(it.id, /^u-[a-z0-9-]{1,48}$/))
					return err('invalid', 'id вида u-…', `items[${i}].id`);
				// <>&"' — не для названия: оно показывается на странице и в окне (security-audit-router №1); управляющие — тоже.
				if (it.title != null && (type(it.title) != 'string' || length(it.title) > 80 || match(it.title, /[[:cntrl:]<>&"']/)))
					return err('invalid', 'Название до 80 символов, без <>&"\'', `items[${i}].title`);
				let e = cat.validate({ id: it.id, roles: it.roles }, r, `items[${i}]`);
				if (e) {
					let colon = index(e, ': ');
					return err('invalid', substr(e, colon + 2), substr(e, 0, colon));
				}
				// Файлы фейков должны быть у роутера.
				for (let role in it.roles)
					for (let m in match(it.roles[role], /\{fake\}\/[A-Za-z0-9_.-]+\.bin/g) ?? [])
						if (!stat(`${st.P.fake}/${substr(m[0], 7)}`))
							return err('invalid', `Нет файла ${substr(m[0], 7)}`, `items[${i}].roles.${role}`);
				// parts — из каких стратегий собрана смешанная (router-api §5.1): { youtube|discord|user: id }, хранится как прислали.
				let parts = null;
				if (it.parts != null) {
					if (type(it.parts) != 'object' || !length(keys(it.parts)))
						return err('invalid', 'parts: { группа: id стратегии }', `items[${i}].parts`);
					for (let g in it.parts)
						if (index(['youtube', 'discord', 'user'], g) < 0 || type(it.parts[g]) != 'string' || !match(it.parts[g], /^[A-Za-z0-9_.-]{1,64}$/))
							return err('invalid', 'Группа youtube, discord или user, значение — id стратегии', `items[${i}].parts.${g}`);
					parts = it.parts;
				}
				push(out, { id: it.id, title: it.title ?? it.id, source: 'user', roles: it.roles, ...(parts ? { parts } : {}) });
			}
			st.ensure_dirs();
			return st.write_atomic(`${st.P.etc}/user-strategies.json`, sprintf('%J\n', { strategies: out })) ? {} : err('failed', 'Не удалось сохранить');
		}
	},
};


function q(s) { return `'${replace(`${s}`, "'", "'\\''")}'`; }

const GROUPS = ['youtube', 'discord', 'user'];

methods.select_start = {
	args: { groups: [], mode: 'full', depth: 'main', ids: [] },
	call: function(req) {
		let b = busy() ?? conflict(); if (b) return b;
		if (!st.core_installed()) return err('not_installed', 'Ядро zapret не установлено');
		let a = req.args;
		let groups = a.groups ?? GROUPS;
		if (type(groups) != 'array' || !length(groups) || length(filter(groups, g => index(GROUPS, g) < 0)))
			return err('invalid', 'Группы: youtube, discord, user', 'groups');
		// Только «Свои адреса», а список пуст — иначе подбор честно ответил бы «блокировки не обнаружено».
		if (length(groups) == 1 && groups[0] == 'user' && !length(st.read_json(`${st.P.etc}/user-targets.json`, [])))
			return err('invalid', 'Список своих адресов на роутере пуст — добавьте адреса или выберите другие группы', 'groups');
		if (index(['full', 'quick'], a.mode ?? 'full') < 0) return err('invalid', 'Режим: full или quick', 'mode');
		if (index(['main', 'deep'], a.depth ?? 'main') < 0) return err('invalid', 'Глубина: main или deep', 'depth');
		// ids — проверить только эти (как «Проверить только её» на ПК): без автоприменения, всё возвращается как было.
		let ids = a.ids ?? [];
		if (type(ids) != 'array' || length(ids) > 5 || length(filter(ids, x => type(x) != 'string' || !cat.find(st.catalogs(), x))))
			return err('invalid', 'ids: до 5 id стратегий из списка', 'ids');
		let by = a.started_by == 'page' ? 'page' : 'app';
		// Замок — до запуска: второй select_start (окно и страница, двойной щелчок) получит «Идёт подбор».
		let tok = st.job_reserve('select');
		if (!tok) return err('busy', 'Идёт подбор', null, 'web.err.busy_select');
		unlink('/tmp/dpishell/select.cancel');   // «Остановить» от прошлого подбора не должна отменить этот
		clear_off(true);
		// Начальное состояние — сразу, до фонового задания: select_progress сразу после select_start видит «идёт, 0 из N»,
		// а не прошлый итог или пустоту (окно ПК принимало это за ошибку и запускало подбор повторно).
		st.ensure_dirs();
		// started_at уходит и в задание: select_run держит его в select.json до конца (select_progress.run).
		let started_at = time();
		st.write_atomic('/tmp/dpishell/select.json', sprintf('%J\n', { running: true, started_at, started_by: by,
			depth: length(ids) ? 'main' : (a.depth ?? 'main'), groups, ids: length(ids) ? ids : null, index: 0, total: length(ids),
			eta_s: null, message: 'Запуск подбора…', message_msg: { key: 'router.select.starting', params: {}, text: 'Запуск подбора…' },
			rows: [], finished_at: null, cancelled: false, best: null, applied: false, backups: [] }));
		spawn(`select ${q(sprintf('%J', { groups, mode: a.mode ?? 'full', depth: a.depth ?? 'main', started_by: by, started_at, ...(length(ids) ? { ids } : {}) }))}`, tok);
		return { started: true };
	}
};

// since/run (с 0.2.2, router-api §9): строки rows с номера since — окно и страница досылают новые, а не тянут весь
// select.json (~60 КБ) раз в секунду. run — started_at подбора, по которому считали since: другой подбор — строки с 0.
// В ответе всегда (и без since) run, rows_from, rows_total — по ним клиент понимает, что роутер умеет since.
methods.select_progress = {
	args: { since: 0, run: 0 },
	call: function(req) {
		let p = st.read_json('/tmp/dpishell/select.json', { running: false, index: 0, total: 0, rows: [], best: null, applied: false, backups: [] });
		// Запись и живой процесс расходятся: задание умерло (убито, перезагрузка) — итог «прервался»; запись ещё не
		// обновилась, а задание идёт — «идёт».
		let alive = st.job_running('select');
		if (p.running && !alive && time() - (p.started_at ?? 0) > 10)
			p = { ...p, running: false, message: 'Подбор прервался', message_msg: { key: 'web.msg.interrupted', params: {}, text: 'Подбор прервался' }, cancelled: true };
		else if (!p.running && alive)
			p = { ...p, running: true, index: 0, total: 0, rows: [], message: 'Запуск подбора…',
				message_msg: { key: 'router.select.starting', params: {}, text: 'Запуск подбора…' }, finished_at: null };
		p.finished_at = st.iso(p.finished_at);
		let rows = type(p.rows) == 'array' ? p.rows : [], n = length(rows), a = req.args ?? {};
		let since = type(a.since) == 'int' && a.since > 0 ? a.since : 0;
		if (type(a.run) == 'int' && a.run > 0 && a.run != (p.started_at ?? 0))
			since = 0;
		let from = since < n ? since : n;
		p.rows = from ? slice(rows, from) : rows;
		p.run = p.started_at ?? 0;
		p.rows_from = from;
		p.rows_total = n;
		return p;
	}
};

