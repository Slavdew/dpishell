// Удаление DpiShell (ядро договора, router-api.md §5): сценарий копируется в /tmp и идёт отвязанно — пакет и этот объект ubus
// исчезают по ходу. Ход и итог — /tmp/dpishell-uninstall.json; страница ждёт, пока объект dpishell пропадёт.
methods.uninstall = {
	args: { keep_settings: true },
	call: function(req) {
		let keep = req.args.keep_settings;
		if (keep != null && type(keep) != 'bool')
			return err('invalid', 'keep_settings: true/false', 'keep_settings');
		// Своя папка mktemp (0700, root): по постоянному имени в общем /tmp другой пользователь подложил бы ссылку или свой
		// файл и подменил сценарий между копированием и запуском (security-audit-router №5).
		let r = sh(`d=$(mktemp -d /tmp/dpishell-uninst.XXXXXX) && cp /usr/libexec/dpishell/uninstall.sh "$d/uninstall.sh" && echo "$d"`);
		let dir = trim(r.out);
		if (r.rc != 0 || !match(dir, /^\/tmp\/dpishell-uninst\.[A-Za-z0-9]+$/))
			return err('failed', `Не удалось запустить удаление: ${dir}`);
		sh(`( setsid ${DETACH} sh ${dir}/uninstall.sh ${keep === false ? '--full' : '--keep'} >/dev/null 2>&1 & )`);
		return { started: true };
	}
};

// Обновление (ядро договора, router-api.md §5): из витрины или из /tmp/dpishell-update (кладёт окно ПК; путь не принимается).
methods.update_install = {
	args: { from: 'feed' },
	call: function(req) {
		let from = req.args.from ?? 'feed';
		if (index(['feed', 'local'], from) < 0)
			return err('invalid', 'from: feed или local', 'from');
		if (st.job_running('select'))
			return err('busy', 'Идёт подбор');
		if (st.job_running('update'))
			return err('busy', 'Обновление уже идёт');
		if (from == 'local' && !stat(`${upd.LOCAL_DIR}/SHA256SUMS`))
			return err('invalid', `Нет пакетов в ${upd.LOCAL_DIR}`, 'from');
		// Папку обновления кладёт окно ПК по SSH (root): чужая или ссылка — не берём (security-audit-router №3).
		let bad = from == 'local' ? upd.local_dir_problem() : null;
		if (bad)
			return err('invalid', bad, 'from');
		let tok = st.job_reserve('update');
		if (!tok)
			return err('busy', 'Обновление уже идёт');
		spawn(`update ${from}`, tok);
		return { started: true };
	}
};

methods.update_check = {
	call: function() {
		let tok = st.job_reserve('update');
		if (tok) spawn('update_check', tok);
		return { started: true };
	}
};

// Откат версии пакета (router-api.md §5.2, с 0.2.0-r16): только по кнопке человека. saved — прежняя пара из флеша
// (status.rollback.saved), local — пакеты прежней версии, которые окно ПК положило в /tmp/dpishell-update (проверка — как у
// update_install local: SHA256SUMS, подпись release.json). Ставится только версия старше установленной; настройки остаются.
// Ход и итог — status.update.job (action rollback).
methods.update_rollback = {
	args: { from: 'saved' },
	call: function(req) {
		let from = req.args.from ?? 'saved';
		if (index(['saved', 'local'], from) < 0)
			return err('invalid', 'from: saved или local', 'from');
		if (st.job_running('select'))
			return err('busy', 'Идёт подбор');
		if (st.job_running('update'))
			return err('busy', 'Обновление уже идёт');
		if (from == 'saved') {
			let r = upd.rollback_status();
			if (!r?.saved)
				return err('invalid', 'Прежние пакеты на роутере не сохранены — откат через окно ПК', 'from', 'router.rollback.not_saved', {});
			let f = upd.slot_files('prev');
			if (type(f) == 'string')
				return err('failed', f);
		} else {
			if (!stat(`${upd.LOCAL_DIR}/SHA256SUMS`))
				return err('invalid', `Нет пакетов в ${upd.LOCAL_DIR}`, 'from');
			let bad = upd.local_dir_problem();
			if (bad)
				return err('invalid', bad, 'from');
		}
		let tok = st.job_reserve('update');
		if (!tok)
			return err('busy', 'Обновление уже идёт');
		spawn(`rollback ${from}`, tok);
		return { started: true };
	}
};

// «Изменено DpiShell» (router-api.md §5.2, с 0.2.0-r16): что пакет поменял на роутере, у пункта — undo yes|no, risk link.
// job — итог последней отмены по пунктам (changes_undo / changes_undo_all идут фоном).
methods.changes_list = { call: function() { return chg.list(); } };

function changes_start(id) {
	let b = busy(); if (b) return b;
	if (st.job_running('update'))
		return err('busy', 'Обновление уже идёт');
	let tok = st.job_reserve('changes');
	if (!tok)
		return err('busy', 'Идёт отмена изменений', null, 'router.changes.busy', {});
	spawn(`changes_undo ${q(id)}`, tok);
	return { started: true };
}

methods.changes_undo = {
	args: { id: 'id' },
	call: function(req) {
		let id = req.args.id;
		let it = type(id) == 'string' ? filter(chg.items(), x => x.id == id)[0] : null;
		if (!it)
			return err('invalid', 'Нет такого пункта — список изменился', 'id', 'router.changes.gone', {});
		if (it.undo != 'yes')
			return err('invalid', it.note ?? 'Отдельно отменить нельзя', 'id', it.note_key, {});
		return changes_start(id);
	}
};

methods.changes_undo_all = { call: function() { return changes_start('all'); } };

// «Сравнить скорость» (как на ПК): время ответа защищённого DNS каждого варианта, мс; null — не ответил.
// Прежний синхронный вызов (до 4 с внутри rpcd — стоит вся LuCI) — для старых страниц; новые — dns_compare_start/_result.
methods.dns_compare = {
	call: function() {
		return { items: dns.compare() };
	}
};

const DNS_COMPARE = '/tmp/dpishell/dns_compare.json';

// Фоном (с 0.2.2): rpcd возвращается сразу, итог — dns_compare_result. Идёт — второй запуск не плодит процессы (замок).
methods.dns_compare_start = {
	call: function() {
		let tok = st.job_reserve('dns_compare');
		if (tok) {
			st.write_atomic(DNS_COMPARE, sprintf('%J\n', { running: true, started_at: time(), items: null, at: null }));
			spawn('dns_compare', tok);
		}
		return { started: true };
	}
};

methods.dns_compare_result = {
	call: function() {
		let r = st.read_json(DNS_COMPARE, { running: false, items: null, at: null });
		// Задание умерло (убито, перезагрузка) — не «идёт» вечно.
		if (r.running && !st.job_running('dns_compare') && time() - (r.started_at ?? 0) > 10)
			r = { running: false, items: null, at: null };
		return { running: !!r.running, items: r.items ?? null, at: st.iso(r.at) };
	}
};

methods.dns_presets = {
	call: function() {
		return { presets: map(dns.presets(), p => ({ id: p.id, title: p.title, note: p.note ?? null,
			resolvers: p.resolvers ?? [], plain: p.plain ?? [] })), current: dns.current_id(), custom: st.read_json(dns.CUSTOM, null) };
	}
};

function pr_host(url) {
	let m = match(url, /^https:\/\/([^\/:]+)/);
	return m ? m[1] : '';
}

function valid_ip(s) {
	return type(s) == 'string' && length(s) <= 39 && match(s, /^[0-9a-fA-F.:]+$/) && iptoarr(s) != null;
}

function ip_list(v, field) {
	if (v == null)
		return [];
	if (type(v) != 'array' || length(v) > 4 || length(filter(v, x => !valid_ip(x))))
		return err('invalid', 'До 4 адресов IPv4/IPv6', field);
	return v;
}

// Свой вариант: только https, без кавычек и пробелов; адреса — настоящие IPv4/IPv6, до 4.
function custom_of(c) {
	if (type(c) != 'object')
		return err('invalid', 'custom: объект', 'custom');
	// Управляющие символы — классом [[:cntrl:]]: \x00 в регулярном выражении ucode ломает разбор.
	if (type(c.title) != 'string' || !length(c.title) || length(c.title) > 40 || match(c.title, /[[:cntrl:]"'`\\$<>]/))
		return err('invalid', 'Название до 40 символов', 'custom.title');
	let doh = c.doh;
	if (doh != null && (type(doh) != 'string' || length(doh) > 200 || !match(doh, /^https:\/\/[A-Za-z0-9.-]+(:[0-9]{1,5})?(\/[A-Za-z0-9._~\/-]*)?$/)))
		return err('invalid', 'Адрес DoH вида https://сервер/dns-query', 'custom.doh');
	let boot = ip_list(c.bootstrap, 'custom.bootstrap');
	if (type(boot) == 'object') return boot;
	let plain = ip_list(c.plain, 'custom.plain');
	if (type(plain) == 'object') return plain;
	if (doh == null && !length(plain))
		return err('invalid', 'Нужен адрес DoH или обычные адреса DNS', 'custom');
	// Имя сервера DoH нечем узнать, кроме DNS провайдера (он подменяет ответы) — нужны его адреса.
	if (doh != null && !valid_ip(trim(pr_host(doh), '[]')) && !length(boot))
		return err('invalid', 'Укажите адреса сервера DoH (bootstrap)', 'custom.bootstrap');
	return { title: c.title, resolvers: doh != null ? [ { doh, bootstrap: boot } ] : [], plain };
}

methods.dns_set = {
	args: { preset: 'preset', custom: {} },
	call: function(req) {
		let b = busy(); if (b) return b;
		if (st.job_running('dns'))
			return err('busy', 'Идёт настройка DNS');
		let a = req.args, id;
		if (a.custom != null && length(a.custom)) {
			let c = custom_of(a.custom);
			if (c.error) return c;
			st.ensure_dirs();
			st.write_atomic(dns.CUSTOM, sprintf('%J\n', c));
			id = 'custom';
		} else {
			id = a.preset;
			// «custom» без нового описания — последний заданный свой вариант.
			if (id == 'custom' && st.read_json(dns.CUSTOM, null)) {}
			else if (type(id) != 'string' || !length(filter(dns.presets(), p => p.id == id)))
				return err('invalid', `Вариант: ${join(', ', map(dns.presets(), p => p.id))}`, 'preset');
		}
		let tok = st.job_reserve('dns');
		if (!tok)
			return err('busy', 'Идёт настройка DNS');
		st.write_atomic('/tmp/dpishell/dns_set.json', sprintf('%J\n', { preset: id }));
		spawn('dns_set', tok);
		return { started: true };
	}
};

for (let name in ['dns_analyze', 'dns_enable', 'dns_restore'])
	methods[name] = ((n) => ({
		call: function() {
			let b = busy(); if (b) return b;
			let tok = st.job_reserve('dns');
			if (tok) spawn(n, tok);
			return { started: true };
		}
	}))(name);

// Методы, которые появятся с подбором, проверкой, DNS и диагностикой: пока отвечают «не готово».
for (let name in ['check_now', 'select_start', 'select_cancel', 'select_progress', 'apply', 'dns_status', 'dns_analyze',
                  'dns_enable', 'dns_restore', 'site_check', 'site_check_result', 'diag', 'report', 'conflict_stop', 'core_install'])
	if (!methods[name]) {
		registry.stubs[name] = true;
		methods[name] = { call: function() { return err('failed', 'Ещё не реализовано в этой версии пакета'); } };
	}
registry.methods = methods;

return { dpishell: methods };
