methods.conflict_stop = {
	args: { name: 'name' },
	call: function(req) {
		let e = dg.conflict_stop(req.args.name);
		facts_memo = null;
		return e ? err('invalid', e, 'name') : {};
	}
};

methods.site_check = {
	args: { url: 'url' },
	call: function(req) {
		let u = req.args.url;
		if (type(u) == 'string' && !match(u, /^https?:\/\//))
			u = `https://${u}/`;
		if (type(u) != 'string' || length(u) > 300 || !match(u, /^https?:\/\/[a-z0-9.-]+(:[0-9]{1,5})?(\/[A-Za-z0-9._~%!$&'()*+,;=:@\/?-]*)?$/))
			return err('invalid', 'Адрес вида example.com', 'url');
		let tok = st.job_reserve('site_check');
		if (tok) spawn(`site_check ${q(u)}`, tok);
		return { started: true };
	}
};

methods.site_check_result = {
	call: function() {
		return st.read_json('/tmp/dpishell/site_check.json', { running: false, url: null });
	}
};

methods.dns_status = {
	call: function() {
		let r = dns.status();
		r.checked_at = st.iso(r.checked_at);
		r.job = st.read_json('/tmp/dpishell/dns_job.json', null);
		if (r.job) r.job.at = st.iso(r.job.at);
