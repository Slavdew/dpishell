        { "doh": "https://cloudflare-dns.com/dns-query", "bootstrap": ["1.1.1.1", "1.0.0.1", "2606:4700:4700::1111", "2606:4700:4700::1001"] }
      ],
      "plain": ["8.8.8.8", "1.1.1.1"] },
