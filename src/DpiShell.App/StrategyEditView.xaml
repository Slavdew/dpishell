<UserControl x:Class="DpiShell.App.StrategyEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Правка стратегии (StrategyEditor): название и поля по ролям, проверка на лету. DataContext — StrategyEditor. -->
    <DockPanel Margin="20,16,20,16" Width="640">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" Style="{StaticResource H2}" Margin="0,0,0,2" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Note}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <!-- Итог проверки и кнопки — внизу, поля с прокруткой выше. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasSummary, Converter={StaticResource Vis}}" AutomationProperties.Name="Что мешает сохранить" />
            <TextBlock Text="✓ Параметры в порядке" Style="{StaticResource Hint}" Margin="0,0,0,8" Visibility="{Binding CanSave, Converter={StaticResource Vis}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Style="{StaticResource Primary}" Command="{Binding SaveCmd}" IsDefault="False" />
                <Button Content="Отмена" Command="{Binding CancelCmd}" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Название" Style="{StaticResource Hint}" Margin="0,0,0,2" />
        <TextBox DockPanel.Dock="Top" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" MaxLength="60" Margin="0,0,0,10" AutomationProperties.Name="Название стратегии" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Margin="0,0,0,2">
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Role, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Muted}" />
                                </TextBlock>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="6,4" TextWrapping="Wrap"
                                         AcceptsReturn="True" MinHeight="44" MaxHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Label}" />
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasError, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding HasMissing, Converter={StaticResource Vis}}">
                    <TextBlock Text="Добавить роль:" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding MissingRoles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource LinkButton}" FontFamily="Consolas" FontSize="12" Margin="0,0,8,0"
                                        Command="{Binding DataContext.AddRoleCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Пустое поле — роль не используется. Файлы фейков — только из папки программы, например {fake}/tls_clienthello_www_google_com.bin." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
