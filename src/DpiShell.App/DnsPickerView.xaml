<UserControl x:Class="DpiShell.App.DnsPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DpiShell.App"
             xmlns:l="clr-namespace:DpiShell.App">
    <UserControl.Resources>
        <!-- Ссылка, которую сейчас нельзя нажать, прячем (Hidden — место остаётся, остальные не сдвигаются), а не показываем серой. -->
        <Style x:Key="HideWhenOff" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- «Сравниваю…» остаётся видимой: это ход, а не недоступная ссылка. -->
        <Style x:Key="HideWhenOffIdle" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                        <Condition Binding="{Binding Comparing}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Hidden" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Выбор DNS (DnsPicker): один вид для этого компьютера и для роутера. DataContext — DnsPicker. -->
    <StackPanel>
        <TextBox Text="{Binding CurrentText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontWeight="SemiBold" />
        <!-- Заметка — в том числе имена VPN и виртуальных адаптеров этого компьютера. -->
        <TextBox Text="{Binding Note, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" local:Demo.Sensitive="True"
                 Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />

        <WrapPanel Margin="0,10,0,0">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Width="260" VerticalAlignment="Center" Margin="0,0,8,6"
                      AutomationProperties.Name="{l:T dns.picker.options_name}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- После «Сравнить» — время ответа справа от названия. -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Ping}" Style="{StaticResource Hint}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="ApplyButton" Content="{l:T dns.picker.apply}" Style="{StaticResource Primary}" Command="{Binding ApplyCmd}" />
            <Button Content="{l:T dns.picker.restore}" Command="{Binding RestoreCmd}" Visibility="{Binding CanRestore, Converter={StaticResource Vis}}" />
        </WrapPanel>
        <DockPanel Margin="0,0,0,0">
            <Button DockPanel.Dock="Right" Content="{l:T dns.picker.delete}" Style="{StaticResource LinkButton}" FontSize="13"
                    Command="{Binding RemoveCustomCmd}" CommandParameter="{Binding Selected}"
                    Visibility="{Binding Selected.Custom, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
            <StackPanel>
                <TextBox Text="{Binding SelectedDetail, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}"
                         Visibility="{Binding HasSelectedDetail, Converter={StaticResource Vis}}" />
                <TextBox Text="{Binding SelectedNote, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}"
                         Visibility="{Binding HasSelectedNote, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DockPanel>
        <CheckBox Content="{l:T dns.picker.fallback}" IsChecked="{Binding Fallback}" Margin="0,8,0,0"
                  Visibility="{Binding ShowFallback, Converter={StaticResource Vis}}" />

        <!-- Технические подробности (адреса, IPv4/IPv6, шаблон защищённого DNS, оператор), копирование и сравнение скорости — под «Подробнее» (UX-аудит 5, п. 6). -->
        <Expander Header="{l:T dns.picker.details}" Style="{StaticResource SubBlock}">
            <StackPanel Margin="0,6,0,0">
                <!-- Описание варианта: чтобы вписать вручную в Windows, телефон, роутер. -->
                <ItemsControl ItemsSource="{Binding SelectedInfo}" AutomationProperties.Name="{l:T dns.picker.info_name}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="-4,4,0,0">
                    <Button Content="{l:T dns.picker.copy_ips}" Style="{StaticResource HideWhenOff}" FontSize="13" Command="{Binding CopyIpsCmd}" Margin="0,0,10,0"
                            ToolTip="{l:T dns.picker.copy_ips.tip}" />
                    <Button Content="{l:T dns.picker.copy_doh}" Style="{StaticResource HideWhenOff}" FontSize="13" Command="{Binding CopyDohCmd}" Margin="0,0,10,0" />
                    <Button Content="{Binding CompareText}" Style="{StaticResource HideWhenOffIdle}" FontSize="13" Command="{Binding CompareCmd}"
                            ToolTip="{l:T dns.picker.compare.tip}" />
                    <TextBlock Text="{Binding Copied}" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding HasCopied, Converter={StaticResource Vis}}" />
                </WrapPanel>
                <TextBox Text="{Binding CompareSummary, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,4,0,0"
                         Visibility="{Binding HasCompareSummary, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Expander>

        <Expander Header="{l:T dns.picker.custom}" Style="{StaticResource SubBlock}" IsExpanded="{Binding Adding}">
            <!-- Enter в любом поле — «Добавить». -->
            <Grid Margin="0,6,0,0">
                <Grid.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCustomCmd}" />
                </Grid.InputBindings>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" MaxWidth="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{l:T dns.picker.name}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" AutomationProperties.Name="{l:T dns.picker.name_field}" />
                <TextBlock Grid.Row="1" Text="{l:T dns.picker.ips}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewIps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="{l:T dns.picker.ips.tip}"
                         AutomationProperties.Name="{l:T dns.picker.ips_field}" />
                <TextBlock Grid.Row="2" Text="{l:T dns.picker.doh}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewDoh, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="{l:T dns.picker.doh.tip}"
                         AutomationProperties.Name="{l:T dns.picker.doh_address}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewError, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" Margin="0,0,0,6"
                         Visibility="{Binding HasNewError, Converter={StaticResource Vis}}" />
                <Button Grid.Row="4" Grid.Column="1" Content="{l:T dns.picker.add}" Style="{DynamicResource Small}" Command="{Binding AddCustomCmd}" HorizontalAlignment="Left" />
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>
