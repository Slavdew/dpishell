<UserControl x:Class="DpiShell.App.DnsPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Ссылка, которую сейчас нельзя нажать, прячем (Hidden — место остаётся, остальные не сдвигаются), а не показываем серой. -->
        <Style x:Key="HideWhenOff" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- «Сравниваю…» остаётся видимой: это ход, а не недоступная ссылка. -->
        <Style x:Key="HideWhenOffIdle" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                        <Condition Binding="{Binding Comparing}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Hidden" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Выбор DNS (DnsPicker): один вид для этого компьютера и для роутера. DataContext — DnsPicker. -->
    <StackPanel>
        <TextBlock Text="{Binding CurrentText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />

        <WrapPanel Margin="0,10,0,0">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Width="260" VerticalAlignment="Center" Margin="0,0,8,6"
                      AutomationProperties.Name="Вариант DNS">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- После «Сравнить» — время ответа справа от названия. -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Ping}" Style="{StaticResource Hint}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="ApplyButton" Content="Применить" Style="{StaticResource Primary}" Command="{Binding ApplyCmd}" />
            <Button Content="Вернуть как было" Command="{Binding RestoreCmd}" Visibility="{Binding CanRestore, Converter={StaticResource Vis}}" />
        </WrapPanel>
        <DockPanel Margin="0,0,0,0">
            <Button DockPanel.Dock="Right" Content="Удалить" Style="{StaticResource LinkButton}" FontSize="13"
                    Command="{Binding RemoveCustomCmd}" CommandParameter="{Binding Selected}"
                    Visibility="{Binding Selected.Custom, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
            <StackPanel>
                <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Visibility="{Binding HasSelectedDetail, Converter={StaticResource Vis}}" />
                <!-- Описание варианта: адреса, защищённый DNS, кто держит, заметка — чтобы вписать вручную в Windows, телефон, роутер. -->
                <ItemsControl ItemsSource="{Binding SelectedInfo}" AutomationProperties.Name="Описание варианта DNS">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>
        <WrapPanel Margin="-4,4,0,0">
            <Button Content="Скопировать адреса" Style="{StaticResource HideWhenOff}" FontSize="13" Command="{Binding CopyIpsCmd}" Margin="0,0,10,0"
                    ToolTip="Адреса по одному в строке — вставить вручную в Windows, телефон или роутер" />
            <Button Content="Скопировать адрес защищённого DNS" Style="{StaticResource HideWhenOff}" FontSize="13" Command="{Binding CopyDohCmd}" Margin="0,0,10,0" />
            <Button Content="{Binding CompareText}" Style="{StaticResource HideWhenOffIdle}" FontSize="13" Command="{Binding CompareCmd}"
                    ToolTip="Время ответа защищённого DNS каждого варианта с этого компьютера" />
            <TextBlock Text="{Binding Copied}" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                       Visibility="{Binding HasCopied, Converter={StaticResource Vis}}" />
        </WrapPanel>
        <TextBlock Text="{Binding CompareSummary}" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasCompareSummary, Converter={StaticResource Vis}}" />
        <CheckBox Content="Если защищённый не отвечает — обычный DNS" IsChecked="{Binding Fallback}" Margin="0,8,0,0"
                  Visibility="{Binding ShowFallback, Converter={StaticResource Vis}}" />

        <Expander Header="Свой вариант" IsExpanded="{Binding Adding}" Margin="0,8,0,0">
            <!-- Enter в любом поле — «Добавить». -->
            <Grid Margin="0,6,0,0">
                <Grid.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCustomCmd}" />
                </Grid.InputBindings>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" MaxWidth="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Название" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" AutomationProperties.Name="Название DNS" />
                <TextBlock Grid.Row="1" Text="Адреса (1–2)" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewIps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="Например: 94.140.14.14, 94.140.15.15"
                         AutomationProperties.Name="Адреса DNS" />
                <TextBlock Grid.Row="2" Text="Защищённый (https)" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewDoh, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="Необязательно. Например: https://dns.adguard-dns.com/dns-query"
                         AutomationProperties.Name="Адрес защищённого DNS" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NewError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding HasNewError, Converter={StaticResource Vis}}" />
                <Button Grid.Row="4" Grid.Column="1" Content="Добавить" Style="{DynamicResource Small}" Command="{Binding AddCustomCmd}" HorizontalAlignment="Left" />
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>
