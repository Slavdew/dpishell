<UserControl x:Class="DpiShell.App.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DpiShell.App"
             xmlns:l="clr-namespace:DpiShell.App">
    <!-- «Продвинутый режим» (AdvancedViewModel): переключатель сверху; включён — строки «сайты → стратегия» и выбор для остальных адресов.
         Один вид для ПК и роутера; DataContext — AdvancedViewModel. -->
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{l:T sites.adv.title}" Style="{StaticResource H2}" />
            <local:InfoButton Topic="{x:Static local:InfoTexts.Advanced}" Margin="8,0,0,8" />
        </StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left"
                          AutomationProperties.Name="{l:T sites.adv.title}">
                    <TextBlock Text="{Binding ToggleText}" FontSize="15" FontWeight="SemiBold" />
                </CheckBox>
                <TextBlock Text="{Binding Summary}" Margin="50,4,0,0" Visibility="{Binding Available, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding UnavailableText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="50,4,0,0"
                           Visibility="{Binding NotAvailable, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding StoredText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="50,2,0,0"
                           Visibility="{Binding ShowStored, Converter={StaticResource Vis}}" />

                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowEditor, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="{l:T sites.adv.rows_hint}" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock Text="{l:T sites.adv.no_rows}" Style="{StaticResource Hint}" Margin="14,12" Visibility="{Binding NoRows, Converter={StaticResource Vis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6" MaxHeight="300">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Text="{Binding DomainsText, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="32" MaxHeight="96" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6,4" VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="{l:T sites.adv.row.sites_name}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Choices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Strategy}" Width="200" Margin="10,0,6,0" VerticalAlignment="Top"
                                                          AutomationProperties.Name="{l:T sites.adv.row.strategy_name}" />
                                                <Button Grid.Column="2" Content="✕" Style="{StaticResource LinkButton}" ToolTip="{l:T sites.adv.row.remove}" AutomationProperties.Name="{l:T sites.adv.row.remove}" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.RemoveRowCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <TextBox Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Hint, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="2,2,0,0" local:Demo.Sensitive="True"
                                                           Visibility="{Binding HasHint, Converter={StaticResource Vis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Button Content="{Binding AddText}" Command="{Binding AddRowCmd}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                    <TextBlock Text="{l:T sites.adv.others.title}" FontWeight="SemiBold" Margin="0,14,0,2" />
                    <RadioButton Content="{l:T sites.mode.lists}" IsChecked="{Binding OthersLists}" IsEnabled="{Binding CanEdit}" Margin="0,3,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="{l:T sites.adv.recommended}" Style="{StaticResource Hint}" FontSize="12" Margin="22,0,0,3" />
                    <RadioButton Content="{l:T sites.mode.all}" IsChecked="{Binding OthersAll}" IsEnabled="{Binding CanEdit}" Margin="0,3,0,0" HorizontalAlignment="Left" />
                    <!-- «Для всех сайтов» может сломать банк или госсайт — предупреждение рядом с выбором, а не только после (UX-аудит 7, п. 6). -->
                    <TextBlock Text="{l:T sites.mode.all_warn}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,3" />
                    <RadioButton Content="{l:T sites.adv.others.direct}" IsChecked="{Binding OthersDirect}" IsEnabled="{Binding CanEdit}" Margin="0,3" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding OthersHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <!-- Сохраняет кнопка вкладки «Сайты» (одна на вкладку, с одним статусом «Не сохранено / Сохранено»); здесь только откат. -->
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{l:T sites.adv.discard}" Command="{Binding DiscardCmd}" Visibility="{Binding Dirty, Converter={StaticResource Vis}}" />
                        <Button x:Name="RevertButton" Content="{l:T sites.adv.revert}" Command="{Binding RevertCmd}" />
                    </WrapPanel>
                </StackPanel>

                <TextBox Text="{Binding Message, Mode=OneWay}" Margin="0,8,0,0" Visibility="{Binding HasMessage, Converter={StaticResource Vis}}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource SelectableHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
