<Window x:Class="DpiShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DpiShell.App"
        Title="DpiShell" Height="640" Width="960" MinHeight="480" MinWidth="760"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:ZeroToVisible x:Key="Zero" />
        <local:ZeroToVisible x:Key="NonZero" Invert="True" />
        <local:FalseToVisible x:Key="InvVis" />
        <!-- Кнопки блока роутера: ниже обычных, чтобы блок не теснил список стратегий. -->
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel>
            <!-- Строка состояния -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding Message}" />
            </Border>

            <TabControl Style="{StaticResource Nav}" SelectedIndex="{Binding Page}">

                <!-- ===== Главная ===== -->
                <TabItem Header="Главная">
                    <!-- UX-аудит, «Главная»: одно главное действие — выключатель, итог проверки — в карточке состояния;
                         ниже роутер одной строкой, помехи (раскрыта только самая важная) и, по «Сменить стратегию», список стратегий. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="22" Height="22" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,10,16,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hint}" FontSize="15" Margin="0,2,0,0" />
                                    <!-- Итог «Проверить сейчас»: по группе ✓ или ✗; адреса — в «Подробнее». -->
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasCheck, Converter={StaticResource Vis}}">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding CheckSummary}" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center" />
                                            <ItemsControl ItemsSource="{Binding CheckGroups}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,14,0" TextWrapping="NoWrap"><Run x:Name="M" Text="{Binding Mark, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ok}" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                                <Setter TargetName="M" Property="Foreground" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Browser}" Value="True">
                                                                <Setter TargetName="M" Property="Foreground" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CheckedAt}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <!-- Программа открывает по DoH, браузер по DNS системы — нет: что не так и кнопка защищённого DNS. -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding HasBrowserWarning, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding BrowserWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding RecommendedDnsText}" Command="{Binding FixDnsCmd}" ToolTip="{Binding RecommendedDnsHint}"
                                                    HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding ShowBrowserDnsFix, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                        <Expander Header="Подробнее" Margin="0,6,0,0" Visibility="{Binding CheckRows.Count, Converter={StaticResource NonZero}}">
                                            <ItemsControl ItemsSource="{Binding CheckRows}" ItemTemplate="{StaticResource VerdictRow}" Margin="0,4,0,0" />
                                        </Expander>
                                    </StackPanel>
                                    <!-- Второстепенные действия — ссылками. -->
                                    <WrapPanel Margin="-4,12,0,0">
                                        <Button Content="Проверить сейчас" Style="{StaticResource LinkButton}" Command="{Binding CheckNowCmd}" Margin="0,0,10,0" />
                                        <Button Content="{Binding StrategiesLinkText}" Style="{StaticResource LinkButton}" Command="{Binding ToggleStrategiesCmd}" Margin="0,0,10,0" />
                                        <Button Content="Подобрать на роутере" Style="{StaticResource LinkButton}" Command="{Binding GoSelectCmd}" Margin="0,0,4,0" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.Home}" Margin="4,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <!-- Выключатель. Обход делает роутер — кнопка ПК второстепенная: «Включить и на этом ПК». -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,6,0,0">
                                    <Button ContentTemplate="{StaticResource Shield}" Content="{Binding ToggleText}" Style="{StaticResource Primary}" Command="{Binding ToggleCmd}"
                                            MinWidth="150" Padding="24,11" FontSize="15" Margin="0" Visibility="{Binding PcPrimary, Converter={StaticResource Vis}}" />
                                    <Button ContentTemplate="{StaticResource Shield}" Content="{Binding ToggleText}" Command="{Binding ToggleCmd}" Margin="0"
                                            Visibility="{Binding PcSecondary, Converter={StaticResource Vis}}" ToolTip="Оптимизация уже делает роутер — и для этого ПК тоже" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Роутер с DpiShell найден (router-api §6): одной строкой, действия и предупреждения — на вкладке «Роутер». -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,8" Margin="0,0,0,12" DataContext="{Binding Router}"
                                Visibility="{Binding Found, Converter={StaticResource Vis}}">
                            <StackPanel>
                            <DockPanel>
                                <!-- Ссылки переносятся на новую строку, а не отнимают ширину у заголовка (UX-аудит 5, п. 2). -->
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="360" Margin="12,0,0,0">
                                    <Button Content="Войти" Style="{StaticResource LinkButton}" Command="{Binding LoginCmd}" Margin="8,0,0,0"
                                            Visibility="{Binding NeedLogin, Converter={StaticResource Vis}}" />
                                    <!-- Выключил сторож, кнопка или откат (last_off) — включить снова тут же, на пробу. -->
                                    <Button Content="Подобрать на роутере" Style="{StaticResource LinkButton}" Command="{Binding GoSelectCmd}" Margin="8,0,0,0"
                                            Visibility="{Binding CanReEnable, Converter={StaticResource Vis}}" />
                                    <Button Content="{Binding ReEnableText}" Style="{StaticResource LinkButton}" Command="{Binding ReEnableCmd}" Margin="8,0,0,0"
                                            Visibility="{Binding CanReEnable, Converter={StaticResource Vis}}" />
                                    <Button Content="Подробнее →" Style="{StaticResource LinkButton}" Command="{Binding DataContext.GoRouterCmd, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Margin="8,0,0,0" AutomationProperties.Name="Открыть вкладку «Роутер»" />
                                </WrapPanel>
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RouterEnabled}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!-- Заголовок переносится, а не обрезается (UX-аудит 5, п. 2); число предупреждений — нейтральное, пока оптимизация работает (п. 22). -->
                                <StackPanel VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding HomeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding HomeFixText}" TextWrapping="NoWrap" Margin="10,0,0,0"
                                                   Visibility="{Binding HasHomeFix, Converter={StaticResource Vis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RouterEnabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Выключение без человека — отдельной строкой ниже, целиком (в одну строку не помещается). -->
                                    <TextBlock Text="{Binding HomeLine}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding HomeLine}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOff}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding OffText}" TextWrapping="Wrap" Margin="20,2,0,2"
                                       Visibility="{Binding HasOff, Converter={StaticResource Vis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OffAlert}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- «Сменить стратегию»: сразу под карточкой, выше помех (UX-аудит 2, п. 2) — раскрытый список виден, а не уходит за край окна.
                                     Прокручивается вместе со страницей (колесо мыши — странице). -->
                                <StackPanel x:Name="StrategiesBlock" Visibility="{Binding ShowStrategies, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding StrategyHeader}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding StrategyHeader}" />
                                    <WrapPanel Margin="0,0,0,6" AutomationProperties.Name="Порядок стратегий">
                                        <TextBlock Text="Порядок:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <RadioButton Content="по результату" IsChecked="{Binding SortByResult}" Margin="0,0,14,0" ToolTip="Сначала те, что открыли больше сайтов в последнем прогоне" />
                                        <RadioButton Content="по имени" IsChecked="{Binding SortByName}" ToolTip="ALT2, ALT3 … ALT10, ALT11" />
                                    </WrapPanel>
                                    <ListBox ItemsSource="{Binding StrategyChoices}" SelectedValue="{Binding ChosenStrategyId}" SelectedValuePath="Id"
                                             IsEnabled="{Binding CanChoose}" Margin="0,0,0,10" PreviewMouseWheel="PassWheelToPage" AutomationProperties.Name="Стратегии">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Метка — в строке названия, чтобы статистика под ним шла во всю ширину. -->
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding HasLabel, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AccentText}" TextWrapping="NoWrap" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Tip}" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,1,0,0">
                                                        <!-- Найденную на ПК — на роутер (router-api §6); видно, только если роутер подключён. -->
                                                        <Border DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding DataContext.Router.Connected, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Vis}}">
                                                            <Button Content="Отправить на роутер" Style="{StaticResource LinkButton}" FontSize="12"
                                                                    Command="{Binding DataContext.Router.SendStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Id}"
                                                                    Visibility="{Binding Removable, Converter={StaticResource Vis}}" ToolTip="Отправить на роутер, включить там и проверить" />
                                                        </Border>
                                                        <!-- Стрелка — адреса последнего подбора (как в таблице подбора); щелчок по ней и по адресам стратегию не выбирает. -->
                                                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource RowToggle}" IsChecked="{Binding Expanded}" Margin="-4,0,2,0"
                                                                      Visibility="{Binding HasDetails, Converter={StaticResource Vis}}" ToolTip="Подробнее: адреса последнего подбора" />
                                                        <!-- «Скопировать стратегию»: строка dpishell:1:… в буфер — вставить в DpiShell у другого человека. -->
                                                        <Button DockPanel.Dock="Right" Content="Скопировать стратегию" Style="{StaticResource LinkButton}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.CopyStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding HasParams, Converter={StaticResource Vis}}" ToolTip="Положить стратегию в буфер одной строкой — её можно вставить в DpiShell" />
                                                        <!-- «Параметры»: роли и командная строка winws — щелчок стратегию не выбирает. -->
                                                        <Button DockPanel.Dock="Right" Content="{Binding ParamsLinkText}" Style="{StaticResource LinkButton}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.ToggleParamsCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding HasParams, Converter={StaticResource Vis}}" ToolTip="Точные параметры оптимизации и командная строка winws" />
                                                        <TextBlock Text="{Binding Stats}" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Danger}" FontSize="13" Margin="0,1,0,0"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource Vis}}" />
                                                    <Border Background="Transparent" Margin="18,4,0,4" MouseLeftButtonDown="KeepSelection"
                                                            Visibility="{Binding Expanded, Converter={StaticResource Vis}}">
                                                        <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource VerdictRow}" />
                                                    </Border>
                                                    <StackPanel Margin="0,4,0,4" Background="Transparent" MouseLeftButtonDown="KeepSelection" Visibility="{Binding ShowParams, Converter={StaticResource Vis}}">
                                                        <!-- Невысокий блок с прокруткой: параметры длинные и иначе растягивают список стратегий. -->
                                                        <TextBox Text="{Binding Params, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="6,4" AutomationProperties.Name="Параметры стратегии"
                                                                 MaxHeight="130" VerticalScrollBarVisibility="Auto" />
                                                        <WrapPanel Margin="0,4,0,0">
                                                            <Button Content="Скопировать параметры" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,0,12,0"
                                                                    Command="{Binding DataContext.CopyParamsCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                            <Button Content="{Binding EditText}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,0,12,0"
                                                                    Command="{Binding DataContext.EditStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                                    ToolTip="Готовые стратегии не меняются — сохранится ваша копия" />
                                                            <Button Content="Удалить" Style="{StaticResource LinkButton}" FontSize="12"
                                                                    Command="{Binding DataContext.DeleteStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                                    Visibility="{Binding Removable, Converter={StaticResource Vis}}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Помехи: «Нашлось N помех», раскрыта самая важная, остальные — по «Ещё N». Обновление списков — не помеха, карточкой ниже. -->
                                <DockPanel Margin="0,0,0,8" Visibility="{Binding HasIssuesHeader, Converter={StaticResource Vis}}">
                                    <Button DockPanel.Dock="Right" Content="{Binding IssuesToggleText}" Style="{StaticResource LinkButton}" Command="{Binding ToggleIssuesCmd}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"><Run Text="⚠ " Foreground="{DynamicResource WarnLine}" /><Run Text="{Binding IssuesTitle, Mode=OneWay}" /></TextBlock>
                                </DockPanel>

                                <!-- router-api §6: обход и на ПК, и на роутере — вместе не работают; выключить один. -->
                                <Border Style="{StaticResource Warn}" Visibility="{Binding ShowBothOn, Converter={StaticResource Vis}}">
                                    <StackPanel DataContext="{Binding Router}">
                                        <TextBlock Text="Оптимизация включена и здесь, и на роутере — вместе они ломают сайты." />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Выключить на ПК" Command="{Binding StopPcCmd}" />
                                            <Button Content="Выключить на роутере" Command="{Binding StopRouterCmd}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Warn}" Visibility="{Binding ShowConflicts, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ConflictWarning}" />
                                        <Button ContentTemplate="{StaticResource Shield}" Content="Остановить" Command="{Binding StopConflictsCmd}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Warn}" Visibility="{Binding ShowDns, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="DNS провайдера может подменять ответы — часть сайтов не откроется даже с оптимизацией." />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding RecommendedDnsText}" Command="{Binding FixDnsCmd}" ToolTip="{Binding RecommendedDnsHint}" />
                                            <Button Content="Подробнее → DNS" Style="{StaticResource LinkButton}" Command="{Binding ChooseDnsCmd}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Warn}" Visibility="{Binding ShowVpn, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding VpnWarning}" />
                                        <Button Content="Понятно, не показывать" Style="{StaticResource LinkButton}" Command="{Binding DismissVpnCmd}" HorizontalAlignment="Left" Margin="-4,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Обновление списков (architecture.md «Обновления данных»): видно, только когда у источника данные новее. -->
                                <Border Style="{StaticResource Card}" Padding="14" Visibility="{Binding ShowUpdate, Converter={StaticResource Vis}}">
                                    <DockPanel DataContext="{Binding Updates}">
                                        <!-- Кнопка обновления — только на «Информация и обновления» (UX-аудит 5, п. 19). -->
                                        <Button DockPanel.Dock="Right" Content="К обновлениям →" Style="{StaticResource LinkButton}" Command="{Binding DataContext.GoAboutCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Версии и обновления" />
                                        <TextBlock Text="{Binding AvailableText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ===== Подбор ===== -->
                <TabItem Header="Подбор">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <!-- Где подбирать — только когда роутер подключён (router-api §6). -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" DataContext="{Binding Router}"
                                        Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <TextBlock Text="Где подбирать:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <RadioButton Content="На этом ПК" IsChecked="{Binding SelectOnPc}" Margin="0,0,16,0" IsEnabled="{Binding CanConnect}" />
                                <RadioButton Content="На роутере" IsChecked="{Binding SelectOnRouter}" IsEnabled="{Binding CanConnect}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="Подбор стратегии" Style="{StaticResource H1}" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.Select}" Margin="10,0,0,12" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Что должно открываться" Style="{StaticResource H2}" />
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Режим" Style="{StaticResource H2}" />
                                <RadioButton IsChecked="{Binding Full}" Margin="0,3">
                                    <TextBlock><Run Text="Полный" /><Run Text=" — все стратегии, выбор лучшей" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </RadioButton>
                                <RadioButton IsChecked="{Binding Quick}" Margin="0,3">
                                    <TextBlock><Run Text="Быстрый" /><Run Text=" — до первой рабочей, начиная с прежних" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </RadioButton>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Visibility="{Binding Router.SelectOnPcVisible, Converter={StaticResource Vis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <!-- Порядок таблицы — в той же строке, что и кнопки подбора: отдельная строка съедала место у таблицы. -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,8" AutomationProperties.Name="Порядок стратегий">
                                    <TextBlock Text="Порядок:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <RadioButton Content="по результату" IsChecked="{Binding SortByResult}" Margin="0,0,14,0" />
                                    <RadioButton Content="по имени" IsChecked="{Binding SortByName}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button ContentTemplate="{StaticResource Shield}" Content="Начать подбор" Style="{StaticResource Primary}" Command="{Binding StartSelectCmd}" />
                                    <Button Content="Стоп" Command="{Binding StopSelectCmd}" />
                                </WrapPanel>
                            </DockPanel>
                            <!-- Ход — только во время подбора: пустая полоса без подбора выглядела незавершённой операцией. -->
                            <StackPanel Visibility="{Binding Selecting, Converter={StaticResource Vis}}">
                                <ProgressBar Height="8" Maximum="{Binding SelectProgressMax}" Value="{Binding SelectProgress, Mode=OneWay}" IsIndeterminate="{Binding SelectIndeterminate}" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding SelectProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Лучшая включена — итог одной строкой, «Подробнее» возвращает карточку. -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,8" Visibility="{Binding ResultCompact, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Подробнее" Style="{StaticResource LinkButton}" Command="{Binding ShowResultDetailsCmd}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding AddressNote}" ToolTip="{Binding AddressNote}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding HasAddressNote, Converter={StaticResource Vis}}" /></StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="{Binding ResultFull, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="Применить" Style="{StaticResource Primary}" Command="{Binding ApplyBestCmd}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasBest, Converter={StaticResource Vis}}" />
                                <!-- Вставленная или собранная руками стратегия: проверка сайтов только для неё. -->
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource Primary}" Command="{Binding CheckStrategyCmd}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasPendingCheck, Converter={StaticResource Vis}}"
                                        ToolTip="Открыть ваши сайты через эту стратегию — только через неё" />
                                <StackPanel>
                                    <TextBlock Text="{Binding ResultText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResultHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" /><TextBlock Text="{Binding AddressNote}" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="{Binding HasAddressNote, Converter={StaticResource Vis}}" />
                                    <!-- Глубокий поиск — только когда готовые не помогли со всем (UX-аудит, п. 30). -->
                                    <WrapPanel Margin="0,10,0,0" Visibility="{Binding OfferDeep, Converter={StaticResource Vis}}">
                                        <TextBlock Text="Не нашлось стратегии для всего — можно поискать новые." VerticalAlignment="Center" Margin="0,0,10,8" />
                                        <Button ContentTemplate="{StaticResource Shield}" Content="Искать глубже (до 15 мин)" Command="{Binding StartSearchCmd}"
                                                ToolTip="Программа придумывает и проверяет новые стратегии; сайты и игры всё это время будут прерываться" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding Scores}" SelectedItem="{Binding SelectedScore}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
                                  RowHeaderWidth="0" MinHeight="120" ScrollViewer.CanContentScroll="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="DetailsVisibility" Value="{Binding Expanded, Converter={StaticResource Vis}}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="38,0,12,10">
                                        <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource VerdictRow}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource RowToggle}" IsChecked="{Binding Expanded, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasDetails, Converter={StaticResource Vis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Стратегия" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Метки справа и целиком, обрезается название (в StackPanel метка уезжала за край).
                                                 «лучшая» — словом, как «найдена»: значок звезды в таблице читался непонятным символом. -->
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,4,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasLabel, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                </Border>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsBest, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="лучшая" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Группы" Binding="{Binding Groups}" Width="70" />
                                <DataGridTextColumn Header="Открылось" Binding="{Binding Share}" Width="90" />
                                <DataGridTextColumn Header="Время" Binding="{Binding Avg}" Width="80" />
                                <DataGridTemplateColumn Header="Что не так" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ErrorShown}" ToolTip="{Binding ErrorFull}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ErrorIsProblem}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Выбранная строка: применить или своё (скопировать, изменить, проверить только её). «Вставить» — второстепенная ссылка:
                             строка DpiShell или запуск winws из .bat Flowseal, сначала проверка, потом «Применить». -->
                        <DockPanel Grid.Row="3" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="Вставить стратегию" Style="{StaticResource LinkButton}" FontSize="13" Margin="8,0,0,8" VerticalAlignment="Top"
                                    Command="{Binding PasteStrategyCmd}" ToolTip="Строка dpishell:1:… или запуск winws из .bat Flowseal; сначала проверка, потом «Применить»" />
                            <WrapPanel>
                                <Button ContentTemplate="{StaticResource Shield}" Content="{Binding ApplySelectedText}" Command="{Binding ApplySelectedCmd}" ToolTip="Можно выбрать стратегию в таблице вручную" />
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Center" Visibility="{Binding HasSelectedScore, Converter={StaticResource Vis}}">
                                    <Button Content="Скопировать стратегию" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,10,0" Command="{Binding CopyStrategyCmd}" CommandParameter="{Binding SelectedScore}" />
                                    <Button Content="{Binding SelectedScore.EditText}" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,10,0" Command="{Binding EditStrategyCmd}" CommandParameter="{Binding SelectedScore}" />
                                    <Button Content="Проверить только её" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding CheckStrategyCmd}" CommandParameter="{Binding SelectedScore}" />
                                </StackPanel>
                            </WrapPanel>
                        </DockPanel>
                        </Grid>

                        <!-- Подбор на роутере: группы и режим — те же, ход — select_progress, итог — «Применить на роутере». -->
                        <Grid Grid.Row="2" DataContext="{Binding Router}" Visibility="{Binding SelectOnRouterVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,8" AutomationProperties.Name="Порядок стратегий">
                                        <TextBlock Text="Порядок:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <RadioButton Content="по результату" IsChecked="{Binding SortByResult}" Margin="0,0,14,0" />
                                        <RadioButton Content="по имени" IsChecked="{Binding SortByName}" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Content="Начать подбор на роутере" Style="{StaticResource Primary}" Command="{Binding StartSelectCmd}" />
                                        <Button Content="Стоп" Command="{Binding StopSelectCmd}" />
                                    </WrapPanel>
                                </DockPanel>
                                <TextBlock Text="Подбор идёт на самом роутере — программу можно закрыть. Лучшую стратегию роутер включит сам." Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                <StackPanel Visibility="{Binding Selecting, Converter={StaticResource Vis}}">
                                    <ProgressBar Height="8" Maximum="{Binding SelectProgressMax}" Value="{Binding SelectProgress, Mode=OneWay}" Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding SelectProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,8" Visibility="{Binding ResultCompact, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Подробнее" Style="{StaticResource LinkButton}" Command="{Binding ShowResultDetailsCmd}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding AddressNote}" ToolTip="{Binding AddressNote}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding HasAddressNote, Converter={StaticResource Vis}}" /></StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="{Binding ResultFull, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Применить на роутере" Style="{StaticResource Primary}" Command="{Binding ApplyCmd}"
                                            VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasBest, Converter={StaticResource Vis}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ResultText}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ResultHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" /><TextBlock Text="{Binding AddressNote}" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="{Binding HasAddressNote, Converter={StaticResource Vis}}" />
                                        <Button Content="Искать глубже (до 15 мин)" Command="{Binding StartDeepCmd}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                Visibility="{Binding OfferDeep, Converter={StaticResource Vis}}" ToolTip="Роутер придумывает и проверяет новые стратегии" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Scores}" SelectedItem="{Binding SelectedScore}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
                                      RowHeaderWidth="0" MinHeight="120" ScrollViewer.CanContentScroll="False">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="DetailsVisibility" Value="{Binding Expanded, Converter={StaticResource Vis}}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="38,0,12,10">
                                            <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource VerdictRow}" />
                                            <TextBlock Text="{Binding NoDetailsHint}" Style="{StaticResource Hint}" FontSize="13" Visibility="{Binding NoDetails, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="30" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource RowToggle}" IsChecked="{Binding Expanded, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding CanExpand, Converter={StaticResource Vis}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Стратегия" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Вариант глубокого поиска — с пометкой справа: применить его нельзя, найденное в конце попадёт в стратегии роутера. -->
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource Hint}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsBest, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="лучшая" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Группы" Binding="{Binding Groups}" Width="70" />
                                    <DataGridTextColumn Header="Открылось" Binding="{Binding Share}" Width="90" />
                                    <DataGridTextColumn Header="Время" Binding="{Binding Avg}" Width="80" />
                                    <DataGridTemplateColumn Header="Что не так" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ErrorShown}" ToolTip="{Binding Error}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ErrorIsProblem}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button Content="{Binding ApplySelectedText}" Command="{Binding ApplySelectedCmd}" />
                                <TextBlock Text="Лучшую роутер включает сам; другую можно выбрать в таблице." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Сайты: свои сайты, исключения, «Сайт не открывается», «Для каких сайтов обход» (последние три — только для роутера). ===== -->
                <TabItem Header="Сайты">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <!-- Вкладки «На этом ПК» / «На роутере» — только когда роутер подключён. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" DataContext="{Binding Router}"
                                        Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <RadioButton Content="На этом ПК" IsChecked="{Binding TargetsOnPc}" Margin="0,0,16,0" />
                                <RadioButton Content="На роутере" IsChecked="{Binding TargetsOnRouter}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="Сайты" Style="{StaticResource H1}" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.Sites}" Margin="10,0,0,12" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Grid.RowSpan="3" Visibility="{Binding Router.TargetsOnPcVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <TextBlock Text="Какие списки встроены" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.DomainLists}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Свои сайты" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                               Text="Сайт или адрес на строку. Эти сайты проверяются при подборе и попадают в список оптимизации." />
                                </StackPanel>
                            </DockPanel>
                            <TextBox Grid.Row="1" Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AutomationProperties.Name="Свои сайты"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="14" Padding="8" />
                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="Сохранить" Style="{StaticResource Primary}" Command="{Binding SaveTargetsCmd}" VerticalAlignment="Top" />
                                <!-- Несохранённое видно (UX-аудит 2, п. 15): подбор берёт сохранённое; при уходе с вкладки и перед подбором сохраняется само. -->
                                <TextBlock DockPanel.Dock="Left" Text="Не сохранено" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,8"
                                           Visibility="{Binding TargetsDirty, Converter={StaticResource Vis}}" ToolTip="Подбор учитывает сохранённый список. Сохраню сам перед подбором и при уходе с вкладки." />
                                <TextBlock Text="{Binding TargetsMessage}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                            </DockPanel>
                        </Grid>

                        <!-- Свои сайты и списки роутера (targets_get/set, lists_get/set): с ПК не синхронизируются сами. -->
                        <Grid Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Router}" Visibility="{Binding TargetsOnRouterVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <!-- «Сайт не открывается»: site_check с обходом и без, итог — site_check_result. Сайт сломался — сразу в исключения (там же, ниже). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Сайт не открывается" Style="{StaticResource H2}" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.SiteCheck}" Margin="8,0,0,8" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" Width="280" Padding="6,4" VerticalAlignment="Center"
                                                 ToolTip="Адрес сайта, например example.com" AutomationProperties.Name="Адрес сайта">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SiteCheckCmd}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Content="Проверить" Command="{Binding SiteCheckCmd}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ProgressBar Height="4" IsIndeterminate="{Binding SiteChecking}" Margin="0,8,0,0" Width="280" HorizontalAlignment="Left"
                                                 Visibility="{Binding SiteChecking, Converter={StaticResource Vis}}" />
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSiteResult, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding SiteResult}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SiteHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        <Button Content="Добавить в исключения" Style="{StaticResource Primary}" Command="{Binding AddExcludeCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Visibility="{Binding SiteSuggestExclude, Converter={StaticResource Vis}}" />
                                        <Expander Header="Подробнее" Margin="0,6,0,0" Visibility="{Binding HasSiteDetail, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding SiteDetail}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Режим: «Все сайты, кроме исключений» (по умолчанию) / «По спискам» (mode_set). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Для каких сайтов оптимизация" Style="{StaticResource H2}" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.RouterMode}" Margin="8,0,0,8" />
                                    </StackPanel>
                                    <RadioButton Content="Все сайты" IsChecked="{Binding ModeAll}" IsEnabled="{Binding CanAct}" Margin="0,3" HorizontalAlignment="Left" />
                                    <RadioButton Content="Только из списков" IsChecked="{Binding ModeLists}" IsEnabled="{Binding CanAct}" Margin="0,3" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Одной карточкой: при прокрутке заголовок и подпись не обрезаются посреди текста, кнопка «Сохранить» отделена линией (UX-аудит 5, п. 25). -->
                            <Border Style="{StaticResource Card}">
                            <StackPanel>
                            <TextBlock Text="Свои сайты" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                                       Text="Роутер проверяет эти адреса при подборе — для всех устройств дома. До 50. «Важный» — без него стратегия не считается рабочей." />
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <TextBlock Text="Адресов нет — добавьте или скопируйте с ПК." Style="{StaticResource Hint}" Margin="14,12"
                                               Visibility="{Binding Targets.Count, Converter={StaticResource Zero}}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6" MaxHeight="200">
                                        <ItemsControl ItemsSource="{Binding Targets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" FontFamily="Consolas" Padding="6,4" VerticalContentAlignment="Center"
                                                                 AutomationProperties.Name="Адрес" />
                                                        <CheckBox Grid.Column="1" Content="важный" IsChecked="{Binding Important}" VerticalAlignment="Center" Margin="14,0,10,0" />
                                                        <Button Grid.Column="2" Content="✕" Style="{StaticResource LinkButton}" ToolTip="Убрать" AutomationProperties.Name="Убрать адрес"
                                                                Command="{Binding DataContext.RemoveTargetCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Добавить адрес" Command="{Binding AddTargetCmd}" />
                                <Button Content="Скопировать с ПК" Command="{Binding CopyFromPcCmd}" />
                            </WrapPanel>
                            </StackPanel>
                            </Border>

                            <TextBlock Text="Что оптимизировать и что не трогать" Style="{StaticResource H2}" Margin="0,14,0,0" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Оптимизировать (домен на строку)" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ListGeneralText, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" AcceptsReturn="True" Height="110"
                                             FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="Оптимизировать" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Исключения (оптимизация их не трогает)" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ListExcludeText, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" AcceptsReturn="True" Height="110"
                                             FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="Исключения" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="1" Margin="0,4,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <WrapPanel>
                                    <Button Content="Сохранить на роутере" Style="{StaticResource Primary}" Command="{Binding SaveTargetsCmd}" />
                                    <TextBlock Text="{Binding TargetsMessage}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Игры и программы: запись подключений и профили (ТЗ 13), игровой режим, IP-списки в «Дополнительно» ===== -->
                <TabItem Header="Игры и программы">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Подключения программ (ТЗ 13): простой режим «Настроить под игру», сохранённые профили, для опытных — «Отладка подключений». -->
                            <StackPanel DataContext="{Binding Apps}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Игры и программы" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Apps}" Margin="10,0,0,12" />
                                </StackPanel>
                                <!-- Предупреждение про античиты — одно на вкладку (UX-аудит 5, п. 10). -->
                                <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                        Padding="10,6" Margin="0,-4,0,12" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Anti}" FontSize="13" TextWrapping="Wrap" />
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Настроить под игру" Style="{StaticResource H2}" />
                                        <TextBlock Text="{Binding Intro}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding ShowIntro, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding Status}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasStatus, Converter={StaticResource Vis}}" local:Demo.Sensitive="True" />
                                        <TextBlock Text="{Binding RecText}" FontFamily="Consolas" Margin="0,4,0,0" Visibility="{Binding IsRecording, Converter={StaticResource Vis}}" local:Demo.Sensitive="True" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" local:Demo.Sensitive="True" />
                                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,8,0,0" Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                                        <!-- Драйвер для записи — только по выбору: игры с защитой от читов могут его заметить (AppsViewModel.AdvNoDriver). -->
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowStart, Converter={StaticResource Vis}}">
                                            <CheckBox Content="Записывать и голосовой чат, и игровые серверы (UDP)" IsChecked="{Binding WithDriver}" HorizontalAlignment="Left" />
                                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="26,2,0,0"
                                                       Text="Для этого на время записи нужен драйвер WinDivert. Игры с защитой от читов могут его заметить — не включайте, если не уверены. Без галочки записываются только соединения TCP. Если оптимизация уже включена, драйвер и так работает." />
                                        </StackPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding StartText}" Style="{StaticResource Primary}" Command="{Binding StartCmd}"
                                                    Visibility="{Binding ShowStart, Converter={StaticResource Vis}}" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="Готово" Style="{StaticResource Primary}" Command="{Binding FinishCmd}"
                                                    Visibility="{Binding IsRecording, Converter={StaticResource Vis}}" />
                                            <Button Content="Отмена" Command="{Binding CancelCmd}" Visibility="{Binding IsRecording, Converter={StaticResource Vis}}" />
                                            <Button Content="Да, заработало" Style="{StaticResource Primary}" Command="{Binding YesCmd}" Visibility="{Binding IsCheck, Converter={StaticResource Vis}}" />
                                            <Button Content="Нет" Command="{Binding NoCmd}" Visibility="{Binding IsCheck, Converter={StaticResource Vis}}" />
                                            <Button Content="Стало хуже" Command="{Binding NoCmd}" Visibility="{Binding IsCheck, Converter={StaticResource Vis}}" />
                                            <Button Content="Подробнее →" Style="{StaticResource LinkButton}" Command="{Binding MoreCmd}" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowMore, Converter={StaticResource Vis}}" />
                                        </WrapPanel>
                                        <Border Style="{StaticResource Warn}" Margin="0,10,0,0" Visibility="{Binding ShowOffHint, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding OffHint}" FontSize="13" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="Профили программ" Style="{StaticResource H2}" />
                                        <ItemsControl ItemsSource="{Binding Profiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Другие параметры" Command="{Binding NextCmd}" Margin="0,0,8,0"
                                                                    Visibility="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource Vis}}" />
                                                            <Button ContentTemplate="{StaticResource Shield}" Content="Вернуть как было" Command="{Binding RemoveCmd}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:Demo.Sensitive="True" />
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" local:Demo.Sensitive="True" />
                                                            <TextBlock Style="{StaticResource Hint}"><Run Text="Параметры " /><Run Text="{Binding Variant, Mode=OneWay}" /></TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Отладка подключений: только если в «Настройках» включено «Показывать инструменты для опытных» (или по «Подробнее»). -->
                                <StackPanel Visibility="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Отладка подключений" Style="{StaticResource H1}" FontSize="19" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.Debug}" Margin="10,0,0,12" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Text="Для опытных: запишите, куда подключается программа, оставьте нужное и сохраните профиль. Запись только читает — ничего не меняет и сама остановится через 5 минут." />
                                            <RadioButton Content="Всё, что запустится после «Записать»" IsChecked="{Binding AdvNewProcesses}" Margin="0,3,0,3" IsEnabled="{Binding AdvIdle}" />
                                            <DockPanel Margin="0,3,0,3">
                                                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshProcessesCmd}" Margin="8,0,0,0" IsEnabled="{Binding AdvIdle}" />
                                                <RadioButton Content="Выбранный процесс:" IsChecked="{Binding AdvByProcess}" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding AdvIdle}" />
                                                <ComboBox ItemsSource="{Binding Processes}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedProcess}" IsEnabled="{Binding AdvIdle}" local:Demo.Sensitive="True"
                                                          AutomationProperties.Name="Процесс для записи" />
                                            </DockPanel>
                                            <CheckBox Content="Без драйвера (только TCP)" IsChecked="{Binding AdvNoDriver}" HorizontalAlignment="Left" Margin="0,6,0,0" IsEnabled="{Binding AdvIdle}"
                                                      ToolTip="UDP без драйвера не записать: таблица Windows не знает удалённых адресов UDP." />
                                            <TextBlock Text="Так записываются только соединения TCP, зато игры с защитой от читов не видят лишнего драйвера. Включено по умолчанию." Style="{StaticResource Hint}" Margin="26,2,0,0" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button ContentTemplate="{StaticResource Shield}" Content="Записать" Style="{StaticResource Primary}" Command="{Binding AdvStartCmd}" />
                                                <Button Content="Стоп" Command="{Binding AdvStopCmd}" />
                                                <TextBlock Text="{Binding RecText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,0,8" Visibility="{Binding AdvRecording, Converter={StaticResource Vis}}" local:Demo.Sensitive="True" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
                                        <StackPanel>
                                            <TextBlock Text="Записанные подключения" Style="{StaticResource H2}" />
                                            <TextBlock Text="{Binding RecapNote}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding HasRecapNote, Converter={StaticResource Vis}}" />
                                            <WrapPanel Margin="0,4,0,6">
                                                <Button Content="Отсечь шум" Command="{Binding DenoiseCmd}" ToolTip="Вернуть отметки, как поставила бы программа: без служб Windows, браузеров, локальной сети и старого фона" />
                                                <Button Content="Отметить все" Command="{Binding CheckAllCmd}" />
                                                <Button Content="Снять все" Command="{Binding UncheckAllCmd}" />
                                            </WrapPanel>
                                            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                                      CanUserAddRows="False" MaxHeight="280" MinHeight="90" AutomationProperties.Name="Записанные подключения">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="" Width="32">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Программа" Binding="{Binding Process}" Width="*" ElementStyle="{StaticResource SensitiveCell}" />
                                                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*" ElementStyle="{StaticResource SensitiveCell}" />
                                                    <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="60" />
                                                    <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="48" />
                                                    <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="82" />
                                                    <DataGridTextColumn Header="Убрано, потому что" Binding="{Binding Reason}" Width="1.7*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Название профиля" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding ProfileTitle, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" Padding="6" MaxLength="60" AutomationProperties.Name="Название профиля" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Параметры" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                    <ComboBox ItemsSource="{Binding Variants}" DisplayMemberPath="Title" SelectedIndex="{Binding SelectedVariant}" AutomationProperties.Name="Параметры профиля" />
                                                </StackPanel>
                                            </Grid>
                                            <DockPanel Margin="0,10,0,0">
                                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="Сохранить профиль" Style="{StaticResource Primary}" Command="{Binding SaveCmd}" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Preview}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,0,8" local:Demo.Sensitive="True" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- Карточка «Отладка подключений» скрыта: намёк, где её включить (UX-аудит 5, п. 21). -->
                                <TextBlock Text="Для опытных — в Настройках." Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Visibility="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource InvVis}}" />
                            </StackPanel>

                            <StackPanel DataContext="{Binding Net}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Игровой режим" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Game}" Margin="10,0,0,12" />
                                </StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameOn}" IsEnabled="{Binding GameCanToggle}" HorizontalAlignment="Left">
                                            <TextBlock Text="Игры и голосовые программы" FontSize="15" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding GameStatus}" Margin="50,6,0,0" />
                                        <TextBlock Text="{Binding GameHint}" Style="{StaticResource Hint}" Margin="50,2,0,0" />
                                        <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                                Padding="10,6" Margin="50,10,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="Может вырасти задержка (пинг) в играх и нагрузка на процессор — особенно при торрентах." FontSize="13" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- IP-списки и свои подсети правят редко: профиль под программу заполняет их сам. Идут «Все адреса» — раскрыто, чтобы отсчёт был виден. -->
                                <Expander Header="Дополнительно: IP-списки и свои подсети" Margin="0,6,0,0" IsExpanded="{Binding ListsOpen, Mode=TwoWay}">
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="IP-списки" Style="{StaticResource H1}" FontSize="19" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.IpLists}" Margin="10,0,0,12" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <!-- «Выкл» выключает и игровой режим (Shell.SetIpsetMode): без списка ему нечего ловить — так и сказано. -->
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"><Run Text="Оптимизация сайтов по адресам" /><Run Text=" (" /><Run Text="«Выкл» выключит и игровой режим" /><Run Text=")" /></TextBlock>
                                                <WrapPanel IsEnabled="{Binding CanEdit}">
                                                    <RadioButton Content="Выкл" IsChecked="{Binding IpsetOff}" Margin="0,3,24,3" />
                                                    <RadioButton Content="Только из списков" IsChecked="{Binding IpsetList}" Margin="0,3,24,3" />
                                                </WrapPanel>
                                                <!-- «Все адреса» — проверка с подтверждением, а не третий режим наравне с рабочими (UX-аудит, п. 34). -->
                                                <Button ContentTemplate="{StaticResource Shield}" Content="Проверить, поможет ли оптимизация (10 мин)" Command="{Binding TryAnyCmd}" HorizontalAlignment="Left"
                                                        Margin="0,8,0,0" ToolTip="На 10 минут — оптимизация для любого соединения; сайты в это время могут работать с ошибками"
                                                        Visibility="{Binding AnyActive, Converter={StaticResource InvVis}}" IsEnabled="{Binding CanEdit}" />
                                                <Border Style="{StaticResource Warn}" Margin="0,10,0,0" Visibility="{Binding AnyActive, Converter={StaticResource Vis}}">
                                                    <DockPanel>
                                                        <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="Вернуть сейчас" Command="{Binding StopAnyCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding AnyText}" FontWeight="SemiBold" />
                                                            <TextBlock Text="Сейчас оптимизация идёт для любого соединения — многие сайты могут работать с ошибками." FontSize="13" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Список адресов — для обоих" Style="{StaticResource Hint}" Margin="0,0,0,2" />
                                                        <TextBlock Text="{Binding ListText}" />
                                                        <TextBlock Text="{Binding UpdateNote}" Foreground="{DynamicResource Danger}" FontSize="13" Margin="0,4,0,0"
                                                                   Visibility="{Binding HasUpdateNote, Converter={StaticResource Vis}}" />
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Button ContentTemplate="{StaticResource Shield}" Content="Обновить список" Command="{Binding UpdateListCmd}" />
                                                            <Button ContentTemplate="{StaticResource Shield}" Content="Загрузить из файла…" Command="{Binding LoadFileCmd}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="Свои подсети" Style="{StaticResource H2}" />
                                                <TextBlock Text="{Binding UserHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Добавить к списку" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                        <TextBox Text="{Binding UserText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" local:Demo.Sensitive="True"
                                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="Добавить к списку" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Исключения" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                        <TextBox Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" local:Demo.Sensitive="True"
                                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="Исключения" />
                                                    </StackPanel>
                                                </Grid>
                                                <DockPanel Margin="0,10,0,0">
                                                    <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="Сохранить" Style="{StaticResource Primary}" Command="{Binding SaveUserCmd}" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding UserMessage}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Починить адреса (hosts, 09-features-spec §3; ТЗ 12: примерка строк, свои строки, проверка hosts) ===== -->
                <TabItem Header="Починить адреса">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding Hosts}">
                            <StackPanel.Resources>
                                <!-- Строка вердикта: галочка (только если с ней можно что-то сделать) | «адрес имя» и что выяснила проверка | вердикт и пояснение. -->
                                <DataTemplate x:Key="TryRowTemplate">
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="Выбрать строку"
                                                      Visibility="{Binding CanSelect, Converter={StaticResource Vis}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"><Run Text="{Binding Ip, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Host, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <Expander Header="Подробнее" FontSize="12" Margin="0,2,0,0" Visibility="{Binding HasTechnical, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{Binding Technical}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </Expander>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Width="190" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="muted"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Reason}" FontSize="13" Opacity="0.8" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </StackPanel.Resources>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Починить адреса" Style="{StaticResource H1}" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.Hosts}" Margin="10,0,0,12" />
                            </StackPanel>
                            <!-- Что внутри и когда нужно: название вкладки не говорит ни про hosts, ни про GitHub (UX-аудит 5, п. 8). -->
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,-6,0,8"
                                       Text="Если не качаются файлы с GitHub, не открывается Telegram Web или долго запускается Discord. Работает через файл hosts." />

                            <!-- Якоря: вкладка длинная, разделы свёрнуты — ссылка раскрывает раздел и прокручивает к нему. -->
                            <WrapPanel Margin="0,-6,0,10">
                                <TextBlock Text="Перейти:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Style="{StaticResource LinkButton}" Content="Проверенные адреса" Tag="HostsListSection" Click="HostsAnchor_Click" />
                                <Button Style="{StaticResource LinkButton}" Content="Примерить строки" Tag="HostsTrySection" Click="HostsAnchor_Click" />
                                <Button Style="{StaticResource LinkButton}" Content="Мои строки" Tag="HostsUserSection" Click="HostsAnchor_Click" />
                                <Button Style="{StaticResource LinkButton}" Content="Проверить мой hosts" Tag="HostsAuditSection" Click="HostsAnchor_Click" />
                            </WrapPanel>

                            <!-- Замечания свёрнуты в одну строку «N замечания · Подробнее» (UX-аудит 5, п. 24); раскрываются одним щелчком. -->
                            <Expander Header="{Binding WarningsHeader}" Margin="0,0,0,6" Visibility="{Binding HasWarnings, Converter={StaticResource Vis}}">
                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,4,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                                Padding="10,6" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Expander>

                            <!-- Всё, что DpiShell изменила в hosts, откатывается одной кнопкой; чужие строки остаются теми же байтами. -->
                            <Border Style="{StaticResource Card}" Padding="14,10" Visibility="{Binding HasOurs, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="Вернуть как было" Command="{Binding RestoreAllCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding OursText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- 1. Проверенные адреса: GitHub, Telegram, Discord -->
                            <Border Style="{StaticResource Card}">
                                <Expander x:Name="HostsListSection" IsExpanded="{Binding ListOpen}">
                                    <Expander.Header>
                                        <TextBlock Text="GitHub, Telegram и Discord через проверенные адреса" FontSize="15" FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <DockPanel>
                                            <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="Убрать записи" Command="{Binding RevertCmd}" VerticalAlignment="Top" Margin="12,0,0,0"
                                                    Visibility="{Binding BlockPresent, Converter={StaticResource Vis}}" />
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock Text="Включить" FontSize="15" FontWeight="SemiBold" />
                                            </CheckBox>
                                        </DockPanel>
                                        <TextBlock Text="{Binding OffHint}" Style="{StaticResource Hint}" Margin="50,4,0,0" Visibility="{Binding Disabled, Converter={StaticResource Vis}}" />
                                        <StackPanel Margin="50,4,0,0" Visibility="{Binding Enabled, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding AppliedLines}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Muted}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding Enabled, Converter={StaticResource Vis}}">
                                            <WrapPanel>
                                                <Button ContentTemplate="{StaticResource Shield}" Content="Проверить адреса" Style="{StaticResource Primary}" Command="{Binding CheckCmd}" />
                                                <Button Content="Стоп" Command="{Binding StopCmd}" Visibility="{Binding Checking, Converter={StaticResource Vis}}" />
                                            </WrapPanel>
                                            <StackPanel Visibility="{Binding Checking, Converter={StaticResource Vis}}">
                                                <ProgressBar Height="8" Maximum="{Binding Total}" Value="{Binding Done, Mode=OneWay}" Margin="0,2,0,4" />
                                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,8" TextWrapping="Wrap" Visibility="{Binding HasSummary, Converter={StaticResource Vis}}" />
                                        </StackPanel>

                                        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                                  HeadersVisibility="Column" CanUserAddRows="False" MinHeight="90" PreviewMouseWheel="PassWheelToPage"
                                                  Visibility="{Binding Rows.Count, Converter={StaticResource NonZero}}">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Style.Triggers>
                                                        <!-- Не записываются — серым «не нужно» (architecture.md «Починить адреса (hosts)»). -->
                                                        <DataTrigger Binding="{Binding Install}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <!-- Две строки на ячейку: таблица помещается в окно минимальной ширины без обрезанных слов. -->
                                                <DataGridTemplateColumn Header="Сайт и адрес" Width="1.5*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel ToolTip="{Binding Host}">
                                                                <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                <TextBlock Text="{Binding Ip}" FontSize="13" Opacity="0.75" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Владелец" Width="0.9*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Owner}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Owner}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Проверка" Width="1.3*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Live}" TextWrapping="NoWrap" />
                                                                <TextBlock FontSize="13" Opacity="0.75" TextWrapping="NoWrap"><Run Text="DNS: " /><Run Text="{Binding Dns, Mode=OneWay}" /></TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Итог" Width="2*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel ToolTip="{Binding Reason}">
                                                                <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Reason}" FontSize="13" Opacity="0.75" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Предпросмотр: что именно изменится в hosts, затем «Записать» с подтверждением. -->
                                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14" Visibility="{Binding CanWrite, Converter={StaticResource Vis}}">
                                            <DockPanel>
                                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{Binding ApplyText}" Style="{StaticResource Primary}" Command="{Binding ApplyCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="Что изменится в hosts" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding PreviewLines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <!-- 2. Примерить строки из гайда -->
                            <Border Style="{StaticResource Card}">
                                <Expander x:Name="HostsTrySection" IsExpanded="{Binding TryOpen}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Примерить строки из гайда" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.HostsTry}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                   Text="Вставьте строки вида «адрес имя». Для каждой проверю, отвечает ли адрес, принадлежит ли он этому сайту и открывается ли сайт через DNS. Файл hosts при этом не меняется." />
                                        <TextBlock Text="{Binding ToolsUnavailableText}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ToolsUnavailable, Converter={StaticResource Vis}}" />
                                        <TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AutomationProperties.Name="Строки для примерки"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                                 FontFamily="Consolas" FontSize="14" Padding="8" Height="110" local:Demo.Sensitive="True" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button ContentTemplate="{StaticResource Shield}" Content="Примерить" Style="{StaticResource Primary}" Command="{Binding TryCmd}" />
                                            <Button Content="Стоп" Command="{Binding StopCmd}" Visibility="{Binding Trying, Converter={StaticResource Vis}}" />
                                            <Button Content="Очистить" Command="{Binding ClearTryCmd}" />
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding Trying, Converter={StaticResource Vis}}">
                                            <ProgressBar Height="8" Maximum="{Binding Total}" Value="{Binding Done, Mode=OneWay}" Margin="0,2,0,4" />
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TrySummary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,6" Visibility="{Binding HasTrySummary, Converter={StaticResource Vis}}" />
                                        <ItemsControl ItemsSource="{Binding TryRows}" ItemTemplate="{StaticResource TryRowTemplate}" />
                                        <DockPanel Margin="0,10,0,0" Visibility="{Binding TryRows.Count, Converter={StaticResource NonZero}}">
                                            <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="{Binding WriteSelectedText}" Style="{StaticResource Primary}" Command="{Binding WriteSelectedCmd}" VerticalAlignment="Top" />
                                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8"
                                                       Text="Записываются только строки «Поможет», в отдельный блок «DpiShell user». Адреса со временем меняются — раз в сутки проверю и скажу, если какой-то перестал работать." />
                                        </DockPanel>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <!-- 3. Мои строки -->
                            <Border Style="{StaticResource Card}">
                                <Expander x:Name="HostsUserSection" IsExpanded="{Binding UserOpen}">
                                    <Expander.Header>
                                        <TextBlock Text="Мои строки в hosts" FontSize="15" FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding UserHeader}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding UserRows}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <Button DockPanel.Dock="Right" Content="Убрать" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveUserCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" local:Demo.Sensitive="True" />
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" FontSize="12" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Убрать только мои строки" Command="{Binding RemoveAllUserCmd}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding HasUserRows, Converter={StaticResource Vis}}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="Это строки, которые вы записали через «Примерить строки». Устаревшие адреса сама не убираю — только предупреждаю." />
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <!-- 4. Проверить мой hosts -->
                            <Border Style="{StaticResource Card}">
                                <Expander x:Name="HostsAuditSection" IsExpanded="{Binding AuditOpen}">
                                    <Expander.Header>
                                        <TextBlock Text="Проверить мой hosts" FontSize="15" FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                   Text="Проверю чужие строки вашего файла hosts: какие из них мешают сайтам открываться. Ничего не меняется, пока вы сами не отметите строки и не нажмёте «Закомментировать»." />
                                        <TextBlock Text="{Binding ToolsUnavailableText}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ToolsUnavailable, Converter={StaticResource Vis}}" />
                                        <WrapPanel>
                                            <Button ContentTemplate="{StaticResource Shield}" Content="Проверить мой hosts" Style="{StaticResource Primary}" Command="{Binding AuditCmd}" />
                                            <Button Content="Стоп" Command="{Binding StopCmd}" Visibility="{Binding Auditing, Converter={StaticResource Vis}}" />
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding Auditing, Converter={StaticResource Vis}}">
                                            <ProgressBar Height="8" Maximum="{Binding Total}" Value="{Binding Done, Mode=OneWay}" Margin="0,2,0,4" />
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AuditSummary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,6" Visibility="{Binding HasAuditSummary, Converter={StaticResource Vis}}" />
                                        <ItemsControl ItemsSource="{Binding AuditRows}" ItemTemplate="{StaticResource TryRowTemplate}" />
                                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasProblems, Converter={StaticResource Vis}}">
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding CommentText}" Style="{StaticResource Primary}" Command="{Binding CommentCmd}" />
                                            <Button Content="Выбрать все мешающие" Command="{Binding SelectProblemsCmd}" />
                                        </WrapPanel>
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasOff, Converter={StaticResource Vis}}">
                                            <TextBlock Text="Закомментировано DpiShell" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding OffRows}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" local:Demo.Sensitive="True" />
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" FontSize="12" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="{Binding UncommentText}" Command="{Binding UncommentCmd}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== DNS этого компьютера: проверка подмены и выбор DNS (раньше лежало на «Диагностике» — владелец: неочевидно). ===== -->
                <TabItem Header="DNS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Проверить DNS" Style="{StaticResource LinkButton}" Command="{Binding CheckDnsCmd}" VerticalAlignment="Top" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="DNS" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Dns}" Margin="10,0,0,12" />
                                </StackPanel>
                            </DockPanel>

                            <!-- DNS — один экран: вывод проверки, выбор DNS этого компьютера, таблица — в «Подробнее». -->
                            <Border x:Name="PcDnsCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DnsSummary}" Margin="0,0,0,2" />
                                    <Expander Header="Подробнее: ответы DNS" Margin="0,4,0,0" IsExpanded="{Binding DnsDetailsOpen}" Visibility="{Binding DnsRows.Count, Converter={StaticResource NonZero}}">
                                        <StackPanel Margin="0,6,0,0">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Сайт" Style="{StaticResource Hint}" />
                                                <TextBlock Grid.Column="1" Text="Системный DNS" Style="{StaticResource Hint}" />
                                                <TextBlock Grid.Column="2" Text="Защищённый DNS" Style="{StaticResource Hint}" />
                                                <TextBlock Grid.Column="3" Text="Подменён ответ" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding DnsRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="120" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Host}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding System}" local:Demo.Sensitive="True" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding System}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Doh}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Doh}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Mark}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="Подбор и проверка берут адреса через защищённый DNS, поэтому подмена на их результат не влияет." />
                                        </StackPanel>
                                    </Expander>
                                    <!-- DNS этого компьютера (architecture.md «DNS этого компьютера»): вариант в один клик, «Вернуть как было». -->
                                    <Border x:Name="PcDnsPicker" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DNS этого компьютера" Style="{StaticResource H2}" />
                                            <local:DnsPickerView DataContext="{Binding PcDns}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Роутер подключён — DNS для всей сети настраивается там; блок не дублируем. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding Router.Connected, Converter={StaticResource Vis}}">
                                <TextBlock Text="DNS для всей сети — на вкладке «Роутер»." Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <Button Content="Открыть →" Style="{StaticResource LinkButton}" Command="{Binding GoRouterCmd}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Прокси: системный прокси Windows, свои прокси, «Включить» / «Очистить» / «Вернуть прежний», проверка. ===== -->
                <TabItem Header="Прокси">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource LinkButton}" Command="{Binding Proxy.RefreshCmd}" VerticalAlignment="Top" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="Прокси" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Proxy}" Margin="10,0,0,12" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Что стоит сейчас в Windows: пользователь, машина, службы (WinHTTP). Адреса — чувствительные. -->
                            <Border x:Name="ProxyNowCard" Style="{StaticResource Card}" DataContext="{Binding Proxy}">
                                <StackPanel>
                                    <TextBlock Text="Сейчас в Windows" Style="{StaticResource H2}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Для этого пользователя" Style="{StaticResource Hint}" Margin="0,2" />
                                        <TextBlock Grid.Column="1" Text="{Binding UserLine}" local:Demo.Sensitive="True" TextWrapping="Wrap" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Text="Для всей машины" Style="{StaticResource Hint}" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MachineLine}" local:Demo.Sensitive="True" TextWrapping="Wrap" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Text="Для служб (WinHTTP)" Style="{StaticResource Hint}" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WinHttpLine}" local:Demo.Sensitive="True" TextWrapping="Wrap" Margin="0,2" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Свои прокси: список, «Проверить», форма добавления/изменения. -->
                            <Border x:Name="ProxyListCard" Style="{StaticResource Card}" DataContext="{Binding Proxy}">
                                <StackPanel>
                                    <TextBlock Text="Мои прокси" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ListEmpty, Converter={StaticResource Vis}}"
                                               Text="Список пуст. Добавьте прокси ниже; формат записи, например: Clash Verge — 127.0.0.1:7897." />
                                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="0,0,0,8" PreviewMouseWheel="PassWheelToPage"
                                             AutomationProperties.Name="Мои прокси" Visibility="{Binding ListEmpty, Converter={StaticResource InvVis}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Address}" local:Demo.Sensitive="True" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" local:Demo.Sensitive="True" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" local:Demo.Sensitive="True"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Expander Header="Добавить или изменить" IsExpanded="True">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" MaxWidth="420" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Название" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" local:Demo.Sensitive="True" AutomationProperties.Name="Название прокси" />
                                            <TextBlock Grid.Row="1" Text="Адрес (хост:порт)" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditServer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" local:Demo.Sensitive="True"
                                                     ToolTip="Например: 127.0.0.1:7897 или http=127.0.0.1:7897;https=127.0.0.1:7897" AutomationProperties.Name="Адрес прокси" />
                                            <TextBlock Grid.Row="2" Text="Исключения" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditBypass, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" local:Demo.Sensitive="True"
                                                     ToolTip="Необязательно. Через «;»: &lt;local&gt;;*.example.com" AutomationProperties.Name="Исключения прокси" />
                                            <TextBlock Grid.Row="3" Text="Автонастройка (PAC)" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditPac, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" local:Demo.Sensitive="True"
                                                     ToolTip="Необязательно. Ссылка http:// или https://" AutomationProperties.Name="Адрес автонастройки" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FormError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Visibility="{Binding HasFormError, Converter={StaticResource Vis}}" />
                                            <WrapPanel Grid.Row="5" Grid.Column="1">
                                                <Button Content="Добавить" Style="{DynamicResource Small}" Command="{Binding AddCmd}" Margin="0,0,8,0" />
                                                <Button Content="Сохранить изменения" Style="{DynamicResource Small}" Command="{Binding SaveCmd}" Margin="0,0,8,0" Visibility="{Binding IsSelected, Converter={StaticResource Vis}}" />
                                                <Button Content="Удалить" Style="{DynamicResource Small}" Command="{Binding DeleteCmd}" Margin="0,0,8,0" Visibility="{Binding IsSelected, Converter={StaticResource Vis}}" />
                                                <Button Content="Очистить поля" Style="{StaticResource LinkButton}" Command="{Binding ClearFormCmd}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Применить выбранный: куда, «Включить», «Очистить», «Вернуть прежний», «Проверить». -->
                            <Border x:Name="ProxyApplyCard" Style="{StaticResource Card}" DataContext="{Binding Proxy}">
                                <StackPanel>
                                    <TextBlock Text="Куда применить" Style="{StaticResource H2}" />
                                    <StackPanel Margin="0,0,0,6">
                                        <RadioButton Content="Для этого пользователя" IsChecked="{Binding TargetUser}" Margin="0,0,0,4" ToolTip="Окно меняет само, права администратора не нужны" />
                                        <RadioButton Content="Для этого пользователя, с правами администратора" IsChecked="{Binding TargetUserAdmin}" Margin="0,0,0,4" ToolTip="Меняет помощник; нужен, если окно само изменить не может" />
                                        <RadioButton Content="Для всей машины (права администратора)" IsChecked="{Binding TargetMachine}" ToolTip="Настройки станут общими для всех пользователей этого компьютера" />
                                    </StackPanel>
                                    <CheckBox Content="Ещё и для служб Windows (WinHTTP)" IsChecked="{Binding AlsoWinHttp}" Margin="0,0,0,8"
                                              Visibility="{Binding TargetMachine, Converter={StaticResource Vis}}"
                                              ToolTip="Прокси WinHTTP берут службы и часть программ, которые не читают системный прокси" />
                                    <WrapPanel>
                                        <Button Content="Включить выбранный" Style="{StaticResource Primary}" Command="{Binding EnableCmd}" />
                                        <Button Content="Очистить" Command="{Binding ClearCmd}" ToolTip="Выключить системный прокси; прежний запоминается" />
                                        <Button Content="Вернуть прежний" Command="{Binding RestoreCmd}" Visibility="{Binding HasPrevious, Converter={StaticResource Vis}}" />
                                        <Button Content="Проверить прокси" Command="{Binding CheckCmd}" ToolTip="Открыть через выбранный прокси соединение к двум сайтам" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding PreviousText}" local:Demo.Sensitive="True" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasPrevious, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding CheckText}" local:Demo.Sensitive="True" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasCheck, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>

                            <!-- Короткие честные подсказки о подводных камнях. -->
                            <Border x:Name="ProxyHintsCard" Style="{StaticResource Card}" DataContext="{Binding Proxy}">
                                <StackPanel>
                                    <TextBlock Text="Что стоит знать" Style="{StaticResource H2}" />
                                    <ItemsControl ItemsSource="{Binding Hints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Expander Header="Подробнее" Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding HintsMore}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Диагностика: только проверки и исправления (UX-аудит п. 12); настройки, обновления, помощник — во вкладке «Настройки». ===== -->
                <TabItem Header="Диагностика">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DiagUpdated}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource LinkButton}" Command="{Binding RefreshDiagCmd}" AutomationProperties.Name="{Binding RefreshButtonText}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Значок «обновить» из системного шрифта Windows 10/11 (Segoe Fluent Icons / Segoe MDL2 Assets). -->
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding RefreshButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="Диагностика" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Diag}" Margin="10,0,0,12" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Обход: одна строка, внутренности (драйвер, файлы, метки TCP) — за «Подробнее» (п. 15). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock><Run Text="Оптимизация: " Foreground="{DynamicResource Muted}" /><Run Text="{Binding ServiceText, Mode=OneWay}" /></TextBlock>
                                    <Expander Header="Подробнее" Margin="0,8,0,0">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Драйвер" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Column="1" Text="{Binding DriverText}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Text="Файлы ядра" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreText}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="2" Text="Временные метки TCP" Style="{StaticResource Hint}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TimestampsText}" />
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Warn}" Visibility="{Binding CoreBroken, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="Файлы ядра повреждены — обычно это антивирус." FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Button ContentTemplate="{StaticResource Shield}" Content="Восстановить" Style="{StaticResource Primary}" Command="{Binding RepairCoreCmd}" HorizontalAlignment="Left" />
                                    <!-- Путь не переписывать руками: «Скопировать путь» и сразу «Безопасность Windows» (п. 16). -->
                                    <TextBlock Text="Чтобы не повторилось, добавьте эту папку в исключения антивируса:" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CoreFolder}" local:Demo.Sensitive="True" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding CoreFolder}" />
                                    <Expander Header="Подробнее" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="В Защитнике Windows: «Защита от вирусов и угроз» → «Управление настройками» → «Исключения» → «Добавить» → «Папка» (названия могут отличаться). В другом антивирусе — в его настройках." />
                                    </Expander>
                                    <WrapPanel Margin="-4,6,0,0">
                                        <Button Content="Скопировать путь" Style="{StaticResource LinkButton}" Command="{Binding CopyCoreFolderCmd}" Margin="0,0,10,0" />
                                        <Button Content="Открыть Защитник" Style="{StaticResource LinkButton}" Command="{Binding OpenDefenderCmd}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Похожие программы" Style="{StaticResource H2}" />
                                    <TextBlock Text="Не найдены." Style="{StaticResource Hint}" Visibility="{Binding ConflictList.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding ConflictList}" local:Demo.Sensitive="True" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Могут перехватывать тот же трафик и мешать оптимизации." />
                                    <Button ContentTemplate="{StaticResource Shield}" Content="Остановить" Command="{Binding StopConflictsCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding ConflictList.Count, Converter={StaticResource NonZero}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="VPN" Style="{StaticResource H2}" />
                                    <TextBlock Text="Не найден." Style="{StaticResource Hint}" Visibility="{Binding VpnList.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding VpnList}" local:Demo.Sensitive="True" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="При включённом VPN оптимизация обычно не нужна, а подбор может показать неверный результат." />
                                </StackPanel>
                            </Border>

                            <!-- Проверки окружения (09-features-spec §4): только показываем, что мешает и что сделать. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Что ещё может мешать" Style="{StaticResource H2}" />
                                    <TextBlock Text="Проверяется при обновлении страницы." Style="{StaticResource Hint}" Visibility="{Binding Findings.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="M" Text="{Binding Mark}" FontWeight="Bold" Foreground="{DynamicResource Ok}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Hint}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" local:Demo.Sensitive="True" TextWrapping="Wrap" />
                                                    <!-- «Системный прокси включён» → вкладка «Прокси». -->
                                                    <Button Grid.Column="3" Content="Настроить →" Style="{StaticResource LinkButton}" Margin="10,0,0,0" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.GoProxyCmd, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            Visibility="{Binding HasGo, Converter={StaticResource Vis}}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter TargetName="M" Property="Foreground" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Решение 5: кэш Discord — кнопкой, с подтверждением (открытый Discord закрывается). -->
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Очистить кэш Discord" Command="{Binding ClearDiscordCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Discord долго подключается" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="После смены стратегии Discord может помнить неудачные попытки. Очистка удаляет только его временные файлы — вход и настройки останутся." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Для вопроса о проблеме: журнал. («Роутер: что мешает» — на вкладке «Роутер».) -->
                            <WrapPanel>
                                <Button Content="Папка логов" Command="{Binding OpenLogsCmd}" />
                                <Button Content="Папка результатов" Command="{Binding OpenResultsCmd}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Роутер (router-api §5–6): обход, «Роутер: что мешает», DNS для всей сети (режим и «Сайт не открывается» — на «Сайтах»), «Проверять сам», подключение.
                     Видна всегда (п. 47): роутер не найден — пустое состояние, что можно сделать, и адрес. ===== -->
                <TabItem Header="Роутер">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Router}">
                        <StackPanel>
                            <TextBlock Text="Роутер" Style="{StaticResource H1}" />

                            <!-- Совместимость (router-api §5.4): другая версия на роутере — что не так и что сделать. Обновление программы — отдельно (ссылка на выпуски). -->
                            <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding HasCompat, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CompatText}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="-4,8,0,0">
                                        <Button Content="Обновить роутер" Style="{StaticResource Primary}" Command="{Binding UpdateCmd}" Margin="4,0,8,0"
                                                Visibility="{Binding CompatNeedsRouter, Converter={StaticResource Vis}}" />
                                        <Button Content="Обновить программу →" Style="{StaticResource LinkButton}" Command="{Binding GoUpdatesCmd}" VerticalAlignment="Center" Margin="4,0,8,0"
                                                ToolTip="Вкладка «Информация и обновления»" Visibility="{Binding CompatNeedsApp, Converter={StaticResource Vis}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Обновление DpiShell на роутере (status.update): «Доступно обновление X», «Что нового», «Обновить». -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding ShowUpdate, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding UpdateButtonText}" Style="{StaticResource Primary}" Command="{Binding UpdateCmd}" VerticalAlignment="Center"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding UpdateTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <!-- Шаги (status.update.job.step): «Скачиваю → Устанавливаю → Перезапуск службы → Готово», текущий выделен. -->
                                    <ItemsControl ItemsSource="{Binding UpdateSteps}" Margin="0,6,0,0" Visibility="{Binding HasUpdateSteps, Converter={StaticResource Vis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run x:Name="Step" Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource Muted}" /><Run Text="{Binding Arrow, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                </TextBlock>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Current}" Value="True">
                                                        <Setter TargetName="Step" Property="FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="Step" Property="Foreground" Value="{DynamicResource Text}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Expander Header="Подробнее" Margin="0,6,0,0" Visibility="{Binding HasUpdateLog, Converter={StaticResource Vis}}">
                                        <TextBox Text="{Binding UpdateLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="6,4" Margin="0,4,0,0"
                                                 MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Журнал обновления" />
                                    </Expander>
                                    <Expander Header="Что нового" Margin="0,6,0,0" Visibility="{Binding HasUpdateNotes, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding UpdateNotes}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Пустое состояние: DpiShell на роутере не найден. -->
                            <!-- Пока не искали — «не проверялся» (UX-аудит 2, п. 10); как поставить — ссылка на инструкцию и место под «Установить на роутер» (п. 9). -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Found, Converter={StaticResource InvVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Text="Если у вас роутер с OpenWrt (на многие модели с OpenWrt 25.x можно поставить DpiShell) — тогда оптимизация будет работать для всех устройств дома: телефонов, телевизора, приставки. Без роутера всё работает и на одном этом компьютере." />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="OpenWrt ли у вас: откройте в браузере адрес роутера (обычно 192.168.1.1) — у OpenWrt страница входа называется LuCI." />
                                    <WrapPanel Margin="-4,10,0,0">
                                        <!-- Установка из окна по SSH (router-api §5.4, RouterInstallDialog). -->
                                        <Button Content="Установить на роутер" Style="{StaticResource Primary}" Command="{Binding InstallCmd}" Margin="4,0,8,0"
                                                Visibility="{Binding CanInstall, Converter={StaticResource Vis}}" />
                                        <Button Content="Как поставить на роутер ↗" Style="{StaticResource LinkButton}" Command="{Binding GuideCmd}" VerticalAlignment="Center"
                                                ToolTip="Инструкция на GitHub: docs/router/README.md" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="DpiShell на роутере уже стоит?" />
                                        <Button Content="Найти" Style="{StaticResource LinkButton}" Command="{Binding FindCmd}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Обход на роутере: состояние, предупреждения с «Исправить», действия (на главной — одна строка со ссылкой сюда). -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Found, Converter={StaticResource Vis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,6,12,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RouterEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding HomeTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding HomeDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                                        <!-- Выключение без человека (last_off: сторож, кнопка на корпусе, откат пробы): фраза, «Подробнее» — что не открылось, «Включить снова». -->
                                        <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="4"
                                                Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Left" MaxWidth="640"
                                                Visibility="{Binding HasOff, Converter={StaticResource Vis}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                Visibility="{Binding CanReEnable, Converter={StaticResource Vis}}">
                                                        <Button Content="{Binding ReEnableText}" Style="{StaticResource LinkButton}" Command="{Binding ReEnableCmd}" />
                                                        <Button Content="Подобрать на роутере" Command="{Binding GoSelectCmd}" Margin="8,0,0,0"
                                                                Visibility="{Binding OfferSelectButton, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding OffText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <!-- Подбор после сторожа идёт: полоса хода (текст хода — строкой карточки выше), как у обычного подбора на роутере. -->
                                                <ProgressBar Height="8" Maximum="{Binding SelectProgressMax}" Value="{Binding SelectProgress, Mode=OneWay}" Margin="0,8,0,2"
                                                             Visibility="{Binding WdRunning, Converter={StaticResource Vis}}" />
                                                <!-- Сторож выключил обход: не решаем за человека, а предлагаем подобрать другую стратегию; «Не сейчас» прячет до следующего срабатывания. -->
                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding OfferSelect, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="Подобрать на роутере другую стратегию сейчас?" FontWeight="SemiBold" />
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button Content="Подобрать" Style="{StaticResource Primary}" Command="{Binding GoSelectCmd}" />
                                                        <Button Content="Не сейчас" Command="{Binding DismissOfferCmd}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Expander Header="Подробнее" Margin="0,4,0,0" Visibility="{Binding HasOffDetails, Converter={StaticResource Vis}}">
                                                    <StackPanel Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding OffDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasOffDetail, Converter={StaticResource Vis}}" />
                                                        <ItemsControl ItemsSource="{Binding OffTargets}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                                                        <Run Text="✗" Foreground="{DynamicResource Danger}" /><Run Text=" " /><Run Text="{Binding Url, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                        <!-- Предупреждения роутера: у исправимых (flow_offload, ipv6) — «Исправить», у чужого обхода — «Подробнее». -->
                                        <ItemsControl ItemsSource="{Binding WarningRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left" MaxWidth="640">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="{Binding Fix}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasFix, Converter={StaticResource Vis}}"
                                                                    Command="{Binding DataContext.FixWarningCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Code}" />
                                                            <TextBlock Text="{Binding Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Метки TCP (needs_tcp_timestamps): не смогли включить сами — плашка как у предупреждений и «Включить» со щитом (меняет Windows этого ПК);
                                             включили — серой строкой. Термин — только в подсказке (UX-аудит 2, п. 8). -->
                                        <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="4"
                                                Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left" ToolTip="{x:Static local:RouterViewModel.TimestampsTerm}"
                                                Visibility="{Binding TimestampsNeedAction, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TimestampsNote}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                                                <Button Content="Включить" ContentTemplate="{StaticResource Shield}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding EnableTimestampsCmd}" ToolTip="{x:Static local:RouterViewModel.TimestampsTerm}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding TimestampsNote}" Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   ToolTip="{x:Static local:RouterViewModel.TimestampsTerm}" Visibility="{Binding TimestampsDone, Converter={StaticResource Vis}}" />
                                        <WrapPanel Margin="0,12,0,0" Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                            <Button Content="{Binding ToggleText}" Command="{Binding ToggleCmd}" ToolTip="{Binding MethodsTip}" ToolTipService.ShowOnDisabled="True"
                                                    Visibility="{Binding ShowRouterActions, Converter={StaticResource Vis}}" />
                                            <Button Content="Проверить" Command="{Binding CheckCmd}" ToolTip="{Binding MethodsTip}" ToolTipService.ShowOnDisabled="True" />
                                            <Button Content="Подобрать на роутере" Command="{Binding GoSelectCmd}" ToolTip="{Binding MethodsTip}" ToolTipService.ShowOnDisabled="True"
                                                    Visibility="{Binding ShowRouterActions, Converter={StaticResource Vis}}" />
                                            <Button Content="Остановить подбор" Command="{Binding StopSelectCmd}" Visibility="{Binding WdRunning, Converter={StaticResource Vis}}" />
                                            <Button Click="RouterStrategy_Click" IsEnabled="{Binding CanAct}" ToolTip="Стратегия на роутере" AutomationProperties.Name="Стратегия на роутере"
                                                    Visibility="{Binding ShowRouterActions, Converter={StaticResource Vis}}">
                                                <TextBlock><Run Text="Стратегия" /><Run Text=" ▾" Foreground="{DynamicResource Muted}" /></TextBlock>
                                            </Button>
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding NeedLogin, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                            <TextBlock Text="Войдите на роутер, чтобы управлять оптимизацией на нём." Style="{StaticResource Hint}" />
                                            <Button Content="Войти" Command="{Binding LoginCmd}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- «Роутер: что мешает» (diag, чужие обходы с «Остановить», отчёт; router-api §6) — рядом с плашками состояния. -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Found, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding DiagUpdated}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Content="Сохранить отчёт роутера" Style="{StaticResource LinkButton}" Command="{Binding SaveReportCmd}" Margin="0,0,8,0" />
                                            <Button Content="Проверить снова" Style="{StaticResource LinkButton}" Command="{Binding RefreshDiagCmd}" />
                                        </StackPanel>
                                        <TextBlock Text="Роутер: что мешает" Style="{StaticResource H2}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding DiagHint}" Style="{StaticResource Hint}" Visibility="{Binding ShowDiagHint, Converter={StaticResource Vis}}" />
                                    <StackPanel Visibility="{Binding DiagLoaded, Converter={StaticResource Vis}}">
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Ускорение сети" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding FlowOffloadText}" />
                                                <Button Content="Исправить" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Command="{Binding FixWarningCmd}" CommandParameter="flow_offload"
                                                        Visibility="{Binding FlowOffloadFixable, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="IPv6 у провайдера" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Ipv6Text}" />
                                                <Button Content="Исправить" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Command="{Binding FixWarningCmd}" CommandParameter="ipv6"
                                                        Visibility="{Binding Ipv6Fixable, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="DNS" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DnsText}" local:Demo.Sensitive="True" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="3" Text="Свободно места" Style="{StaticResource Hint}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SpaceText}" />
                                        </Grid>
                                        <TextBlock Text="Похожие программы на роутере" Style="{StaticResource Hint}" Margin="0,12,0,4" />
                                        <TextBlock Text="Не найдены." Visibility="{Binding Conflicts.Count, Converter={StaticResource Zero}}" />
                                        <ItemsControl ItemsSource="{Binding Conflicts}" local:Demo.Sensitive="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <Button DockPanel.Dock="Right" Content="Остановить" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                                                Visibility="{Binding CanStop, Converter={StaticResource Vis}}"
                                                                Command="{Binding DataContext.StopConflictCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}" />
                                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <!-- DNS для всей сети: dns_status, «Проверить», «Включить защищённый DNS», «Вернуть как было» (фоновые задания). -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="DNS для всей сети" Style="{StaticResource H2}" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.RouterDns}" Margin="8,0,0,8" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DnsState}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding DnsLoaded, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding DnsHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding HasDnsHint, Converter={StaticResource Vis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasDnsJob, Converter={StaticResource Vis}}">
                                            <ProgressBar Height="4" Width="60" IsIndeterminate="{Binding DnsRunning}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Visibility="{Binding DnsRunning, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding DnsJobText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Проверить" Command="{Binding DnsCheckCmd}" />
                                            <!-- Старый пакет на роутере (без dns_presets) — одна кнопка, как раньше. -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding DnsSingleButton, Converter={StaticResource Vis}}">
                                                <Button Content="Включить защищённый DNS" Style="{StaticResource Primary}" Command="{Binding DnsEnableCmd}"
                                                        Visibility="{Binding DnsCanEnable, Converter={StaticResource Vis}}" />
                                                <Button Content="Вернуть как было" Command="{Binding DnsRestoreCmd}"
                                                        Visibility="{Binding DnsProtected, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <!-- Варианты для всей сети — тот же выбор, что для этого компьютера (свои — общие). -->
                                        <local:DnsPickerView x:Name="RouterDnsPicker" DataContext="{Binding DnsPick}" Margin="0,10,0,0"
                                                             Visibility="{Binding DataContext.DnsPresetsAvailable, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource Vis}}" />
                                        <Expander Header="Подробнее" IsExpanded="{Binding DnsDetailsOpen}" Visibility="{Binding DnsServers.Count, Converter={StaticResource NonZero}}">
                                            <ItemsControl ItemsSource="{Binding DnsServers}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Hint}" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- «Проверять сам» и автоподбор (schedule_set) — на роутере, на ПК фоновой проверки нет. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Проверять сам" Style="{StaticResource H2}" />
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Проверять сайты" IsChecked="{Binding ScheduleEnabled}" IsEnabled="{Binding CanAct}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding Source={x:Static local:RouterViewModel.ScheduleOptions}}" DisplayMemberPath="Title" SelectedValuePath="Hours"
                                                      SelectedValue="{Binding ScheduleHours}" IsEnabled="{Binding ScheduleEditable}" Width="180" Margin="14,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Как часто проверять" />
                                        </StackPanel>
                                        <TextBlock Text="При неудаче роутер переключится на запасную стратегию." Style="{StaticResource Hint}" Margin="26,4,0,0" />
                                        <CheckBox Content="Если не помогло — подобрать заново" IsChecked="{Binding AutoSelect}" IsEnabled="{Binding ScheduleEditable}"
                                                  Margin="0,10,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="Подбор 2–3 мин, не чаще раза в 6 ч; на это время сайты на всех устройствах будут прерываться." Style="{StaticResource Hint}"
                                                   Margin="26,4,0,0" TextWrapping="Wrap" />
                                        <!-- Сторож (schedule.watchdog, status.watchdog): аварийный выключатель на самом роутере. -->
                                        <StackPanel Visibility="{Binding WatchdogAvailable, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <CheckBox Content="Сторож: выключать оптимизацию, если с ней пропал интернет" IsChecked="{Binding WatchdogEnabled}" IsEnabled="{Binding CanAct}"
                                                          VerticalAlignment="Center" />
                                                <local:InfoButton Topic="{x:Static local:InfoTexts.RouterWatchdog}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding WatchdogLine}" Style="{StaticResource Hint}" Margin="26,4,0,0"
                                                       Visibility="{Binding HasWatchdogLine, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Подключение: адрес и вход (раньше — карточка в конце «Диагностики»). Пароль — в диалоге «Войти». -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Подключение" Style="{StaticResource H2}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Найти" Command="{Binding FindCmd}" />
                                        <Button Content="Войти…" Style="{StaticResource Primary}" Command="{Binding LoginCmd}" Visibility="{Binding NeedLogin, Converter={StaticResource Vis}}" />
                                        <Button Content="Сменить пароль…" Command="{Binding LoginCmd}" Visibility="{Binding Connected, Converter={StaticResource Vis}}" />
                                        <!-- Установка по SSH: пакета нет — «Установить на роутер», есть — «Установить заново» (починить сломанную установку). -->
                                        <Button Content="{Binding InstallText}" Command="{Binding InstallCmd}" Visibility="{Binding Found, Converter={StaticResource Vis}}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Searched, Converter={StaticResource Vis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConnectionOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Пароль переиспользуется везде (вход, установка, удаление, обновление по SSH); видно, что он сохранён, и его можно забыть. -->
                                    <WrapPanel Margin="0,4,0,0" Visibility="{Binding HasSavedPassword, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding SavedPasswordText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        <TextBlock Text=" · " Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        <Button Content="Забыть" Style="{StaticResource LinkButton}" Command="{Binding ForgetPasswordCmd}" VerticalAlignment="Center"
                                                ToolTip="Стереть сохранённый пароль роутера с этого компьютера" />
                                    </WrapPanel>
                                    <!-- Адрес — в «Дополнительно», как в окне входа: обычно его определяют сами (UX-аудит 2, п. 10). -->
                                    <Expander Header="Дополнительно: адрес роутера" Margin="0,8,0,0" IsExpanded="{Binding AddressCustom, Mode=OneTime}">
                                        <StackPanel Margin="0,4,0,0">
                                            <RadioButton Content="{Binding AutoAddressText}" IsChecked="{Binding AddressAuto}" Margin="0,3" HorizontalAlignment="Left" local:Demo.Sensitive="True" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <RadioButton Content="Свой:" IsChecked="{Binding AddressCustom}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Text="{Binding CustomAddress, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="6,4" IsEnabled="{Binding AddressCustom}" local:Demo.Sensitive="True"
                                                         ToolTip="IP или имя роутера, например 192.168.1.1" AutomationProperties.Name="Адрес роутера">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding FindCmd}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                    <Button Content="Проверить обновления" Style="{StaticResource LinkButton}" Command="{Binding UpdateCheckCmd}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Visibility="{Binding Connected, Converter={StaticResource Vis}}" />
                                    <!-- Удаление — спокойно и не на виду: ссылкой внизу карточки, подтверждение — в диалоге (RouterUninstallDialog). -->
                                    <Button Content="Удалить DpiShell с роутера…" Style="{StaticResource LinkButton}" Command="{Binding UninstallCmd}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Visibility="{Binding Found, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Настройки (UX-аудит п. 12): работа, вид, обновления, помощник, данные, удаление. ===== -->
                <TabItem Header="Настройки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Настройки" Style="{StaticResource H1}" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Работа" Style="{StaticResource H2}" />
                                    <!-- Режим службы (п. 4 аудита): настройка «на один раз», не действие главной. -->
                                    <CheckBox Content="Оптимизация работает, даже когда программа закрыта" IsChecked="{Binding ServiceMode}" IsEnabled="{Binding CanChoose}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RunModeHint}" Style="{StaticResource Hint}" Margin="26,2,0,0" />
                                    <!-- Автозапуск окна при входе (architecture.md «Окно, трей, автозапуск»): ключ Run пользователя, окно — в трее. -->
                                    <CheckBox Content="Запускать вместе с Windows (в трее)" IsChecked="{Binding Autostart.Enabled}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Autostart.Hint}" Style="{StaticResource Hint}" Margin="26,2,0,0" />
                                    <TextBlock Text="При закрытии окна" Style="{StaticResource Hint}" Margin="0,12,0,2" />
                                    <WrapPanel>
                                        <RadioButton Content="Сворачивать в трей" IsChecked="{Binding CloseTray}" Margin="0,3,24,3" />
                                        <RadioButton Content="Закрывать программу" IsChecked="{Binding CloseExit}" Margin="0,3,24,3" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CloseHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="{Binding HasCloseHint, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Для опытных" Style="{StaticResource H2}" />
                                    <CheckBox Content="Показывать инструменты для опытных" IsChecked="{Binding ShowAdvancedSetting}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    <TextBlock Text="Сейчас это «Отладка подключений» на вкладке «Игры и программы»: запись подключений программы, выбор нужных и сохранение профиля." Style="{StaticResource Hint}" Margin="26,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Оформление" Style="{StaticResource H2}" />
                                    <WrapPanel>
                                        <RadioButton Content="Как в Windows" IsChecked="{Binding ThemeAuto}" Margin="0,3,24,3" />
                                        <RadioButton Content="Светлое" IsChecked="{Binding ThemeLight}" Margin="0,3,24,3" />
                                        <RadioButton Content="Тёмное" IsChecked="{Binding ThemeDark}" Margin="0,3,24,3" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Роутер: сохранённый пароль виден и здесь, рядом с остальными данными на этом компьютере. -->
                            <Border Style="{StaticResource Card}" DataContext="{Binding Router}" Visibility="{Binding HasSavedPassword, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="Роутер" Style="{StaticResource H2}" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding SavedPasswordText}" VerticalAlignment="Center" />
                                        <TextBlock Text=" · " VerticalAlignment="Center" />
                                        <Button Content="Забыть" Style="{StaticResource LinkButton}" Command="{Binding ForgetPasswordCmd}" VerticalAlignment="Center"
                                                ToolTip="Стереть сохранённый пароль роутера с этого компьютера" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Откат всего: список из журналов (помощника и окна), «Отменить всё», отчёт по пунктам. Над «Очисткой и удалением». -->
                            <Border Style="{StaticResource Card}" Margin="0,18,0,0" DataContext="{Binding Changes}" x:Name="ChangesCard">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="Отменить всё" Command="{Binding UndoAllCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Text="Что сделала DpiShell" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Вернутся значения, которые были до DpiShell; ваши более поздние правки не трогаем." />
                                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0" Visibility="{Binding HasItems, Converter={StaticResource Vis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" local:Demo.Sensitive="True" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding HelperNote}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasHelperNote, Converter={StaticResource Vis}}" />
                                    <!-- Отчёт: вернул / уже было как раньше / не тронул (изменено после нас) / не смог — с причиной. -->
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasReport, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Report}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,3">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,8,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Mark}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Mark}" Value="fail"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" local:Demo.Sensitive="True" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Question}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasQuestion, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Удаление — отдельно, спокойным стилем, с тем, как вернуть (UX-аудит, «Опасные действия», п. 18–19). -->
                            <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                                <StackPanel>
                                    <TextBlock Text="Очистка и удаление" Style="{StaticResource H2}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="Очистить историю" Command="{Binding ClearHistoryCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="Результаты подборов, статистика и логи. Свои сайты и найденные стратегии останутся." />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="Удалить службу оптимизации" Command="{Binding RemoveServiceCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="Останавливает и убирает службу оптимизации и драйвер WinDivert, возвращает настройки Windows, которые меняла программа. Вернуть — «Включить» на главной." />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding CanUninstallHelper, Converter={StaticResource Vis}}">
                                        <Button DockPanel.Dock="Right" Content="Удалить помощника" Command="{Binding UninstallHelperCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="Помощник — служба, которая делает изменения с правами администратора. Без него окно только для просмотра; при первом действии программа предложит поставить его снова (один запрос прав)." />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Информация и обновления: версии и обновления (проверка раз в день, списки ставит помощник, программа — ссылкой на релиз), сведения и лицензии. ===== -->
                <TabItem AutomationProperties.Name="Информация и обновления">
                    <!-- Не влезает в пункт меню одной строкой (ширина 168) — перенос по смыслу, без многоточия. -->
                    <TabItem.Header>
                        <TextBlock>Информация<LineBreak />и обновления</TextBlock>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Информация и обновления" Style="{StaticResource H1}" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Версия" Style="{StaticResource H2}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Программа" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersionText}" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="1" Text="Помощник" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="{Binding HelperText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="Помощник — служба, которая делает изменения с правами администратора." Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="Данные" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Updates.StatusText}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="3" Text="Ядро zapret (bol-van)" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <StackPanel Grid.Row="3" Grid.Column="1">
                                            <TextBlock Text="{Binding CoreRowText}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="Восстановить" Command="{Binding RepairCoreCmd}" HorizontalAlignment="Left"
                                                    Visibility="{Binding CoreBroken, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Text="DpiShell на роутере" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" DataContext="{Binding Router}">
                                            <TextBlock Text="{Binding PackageVersionText}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                            <TextBlock Text="{Binding PackageUpdateText}" FontWeight="SemiBold" Margin="0,2,0,2"
                                                       Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" />
                                            <WrapPanel>
                                                <Button Content="{Binding UpdateButtonText}" Style="{StaticResource Primary}" Command="{Binding UpdateCmd}"
                                                        Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" />
                                                <Button Content="Установить на роутер" Style="{StaticResource LinkButton}" Command="{Binding InstallCmd}"
                                                        Visibility="{Binding ShowPackageInstall, Converter={StaticResource Vis}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <!-- Ядро, установленное на роутере (status.core.installed_version, роутер 0.2.0-r8); нет входа или старый роутер — строки нет. -->
                                        <TextBlock Grid.Row="5" Text="Ядро на роутере" Style="{StaticResource Hint}" Margin="0,2,16,2" Visibility="{Binding Router.HasRouterCore, Converter={StaticResource Vis}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Router.RouterCoreText}" TextWrapping="Wrap" Margin="0,2,0,2"
                                                   Visibility="{Binding Router.HasRouterCore, Converter={StaticResource Vis}}" />
                                    </Grid>
                                    <Button Content="{Binding FixHelperText}" Command="{Binding FixHelperCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding HasHelperProblem, Converter={StaticResource Vis}}" />

                                    <!-- Обновления данных (architecture.md «Обновления данных»). Списки и программа — разными словами (UX-аудит 2, п. 13). -->
                                    <StackPanel DataContext="{Binding Updates}">
                                        <!-- Блок «Списки» — только когда есть новые (одна кнопка); блок «Программа» — одна главная кнопка по состоянию (UX-аудит 5, п. 3). -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding DataAvailable, Converter={StaticResource Vis}}">
                                            <TextBlock Text="Списки" Style="{StaticResource Hint}" />
                                            <TextBlock Text="{Binding AvailableText}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="Обновить списки" Style="{StaticResource Primary}" Command="{Binding InstallCmd}"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Программа" Style="{StaticResource Hint}" Margin="0,14,0,0" />
                                        <!-- Программа: подписанное описание выпуска получено — «Что нового» и «Обновить до X» (права не нужны);
                                             не получено — подсказка и ссылка на страницу релизов. -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding AppReleaseReady, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding AppReleaseTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <StackPanel Margin="0,6,0,0" Visibility="{Binding HasAppNotes, Converter={StaticResource Vis}}">
                                                <TextBlock Text="Что нового" Style="{StaticResource Hint}" Margin="0,0,0,2" />
                                                <ItemsControl ItemsSource="{Binding AppNotes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Mode=OneWay, StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,1,0,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="Файл проверяется по подписи и контрольной сумме, права администратора не нужны. Текущая версия остаётся рядом — к ней можно вернуться." />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AppOsNote}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding HasAppOsNote, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding AppText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding AppHintOnly, Converter={StaticResource Vis}}" />
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding AppBusy, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite">
                                            <TextBlock Text="{Binding AppProgressText}" TextWrapping="Wrap" />
                                            <ProgressBar Height="6" IsIndeterminate="True" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AppNotice}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                                   Visibility="{Binding HasAppNotice, Converter={StaticResource Vis}}" />
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasAppError, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Assertive">
                                            <TextBlock Text="{Binding AppErrorShort}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
                                            <Expander Header="Подробнее" Margin="0,2,0,0" Visibility="{Binding HasAppErrorMore, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding AppErrorMore}" Style="{StaticResource Hint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" />
                                            </Expander>
                                            <Button Content="Повторить" Command="{Binding RetryCmd}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <!-- Ручное скачивание — не рядом с главной кнопкой, а под «Подробнее». -->
                                        <Expander Header="Подробнее" Margin="0,6,0,0" Visibility="{Binding AppHintOnly, Converter={StaticResource Vis}}">
                                            <Button Content="{Binding AppButtonText}" Command="{Binding OpenReleaseCmd}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                        </Expander>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="{Binding AppUpdateButtonText}" Style="{StaticResource Primary}" Command="{Binding UpdateAppCmd}"
                                                    Visibility="{Binding AppReleaseReady, Converter={StaticResource Vis}}" />
                                            <Button Content="Проверить обновления" Command="{Binding CheckCmd}"
                                                    Visibility="{Binding ShowCheckButton, Converter={StaticResource Vis}}" />
                                            <Button Content="{Binding RollbackText}" Command="{Binding RollbackCmd}" ToolTip="Запустить прежнюю версию, она сохранена рядом"
                                                    Visibility="{Binding CanRollback, Converter={StaticResource Vis}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Информация" Style="{StaticResource H2}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="DpiShell — на основе " VerticalAlignment="Center" />
                                        <Button Content="zapret (bol-van) ↗" Style="{StaticResource LinkButton}" Command="{Binding OpenZapretCmd}" VerticalAlignment="Center" Margin="0" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Репозиторий: " VerticalAlignment="Center" />
                                        <Button Content="github.com/Slavdew/dpishell ↗" Style="{StaticResource LinkButton}" Command="{Binding OpenRepoCmd}" VerticalAlignment="Center" Margin="0" />
                                    </WrapPanel>
                                    <TextBlock Text="Лицензия — MIT." Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Лицензии сторонних компонентов — в файле THIRD-PARTY-NOTICES.txt рядом с программой." />
                                    <Button Content="Открыть лицензии" Command="{Binding OpenNoticesCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding HasNotices, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Проба включения на роутере (router-api §5.2 confirm_s): сайты с ПК не открылись или проверить нельзя — «Всё работает?»;
             отсчёт — по left_s на часах этого ПК. Видна на любой вкладке, над тостом. -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="190,0,0,104" MaxWidth="620" Padding="16,10,12,10" CornerRadius="8"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" DataContext="{Binding Router}"
                Visibility="{Binding TrialVisible, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Assertive">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding TrialText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <WrapPanel Margin="-4,8,0,0" Visibility="{Binding TrialAsk, Converter={StaticResource Vis}}">
                    <Button Content="Да, оставить" Style="{StaticResource Primary}" Command="{Binding TrialKeepCmd}" Margin="4,0,8,0" />
                    <Button Content="Вернуть как было" Command="{Binding TrialRevertCmd}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding TrialCountdown}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Тост: итог обратимого действия с «Вернуть» (DNS этого ПК) и ошибки операций (красная рамка), над строкой состояния.
             Сам скрывается, но не пока над ним мышь (UX-аудит 2, п. 14, 16). -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="190,0,0,44" MaxWidth="560" Padding="16,10,10,10" CornerRadius="8"
                Background="{DynamicResource Surface}" MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave"
                Visibility="{Binding HasToast, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButton}" Command="{Binding CloseToastCmd}" VerticalAlignment="Center"
                        Foreground="{DynamicResource Muted}" Margin="4,0,0,0" ToolTip="Закрыть" AutomationProperties.Name="Закрыть сообщение" />
                <Button DockPanel.Dock="Right" Content="{Binding ToastAction}" ContentTemplate="{StaticResource Shield}" Command="{Binding ToastCmd}" VerticalAlignment="Center"
                        Margin="12,0,0,0" Visibility="{Binding HasToastAction, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Загрузка ядра при старте -->
        <Grid Background="{DynamicResource Page}" Visibility="{Binding ShowOverlay, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="DpiShell" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding LoadingText}" Margin="0,0,0,14" />
                    <ProgressBar Height="6" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadFailed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <!-- Не ответил или отвечает дольше 10 с — выход с первого экрана (UX-аудит, п. 46). -->
                    <WrapPanel Margin="0,4,0,0" Visibility="{Binding ShowLoadActions, Converter={StaticResource Vis}}">
                        <Button Content="Повторить" Style="{StaticResource Primary}" Command="{Binding RetryCmd}" />
                        <Button Content="Открыть без помощника" Command="{Binding OpenWithoutHelperCmd}" ToolTip="Окно — только для просмотра; помощник подключится сам, когда ответит" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
