<Window x:Class="DpiShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DpiShell.App"
        Title="DpiShell" Height="640" Width="960" MinHeight="480" MinWidth="760"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:ZeroToVisible x:Key="Zero" />
        <local:ZeroToVisible x:Key="NonZero" Invert="True" />
        <local:FalseToVisible x:Key="InvVis" />
        <!-- Кнопки блока роутера: ниже обычных, чтобы блок не теснил список стратегий. -->
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel>
            <!-- Строка состояния -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding Message}" />
            </Border>

            <TabControl Style="{StaticResource Nav}" SelectedIndex="{Binding Page}">

                <!-- ===== Главная ===== -->
                <TabItem Header="Главная">
                    <!-- UX-аудит, «Главная»: одно главное действие — выключатель, итог проверки — в карточке состояния;
                         ниже роутер одной строкой, помехи (раскрыта только самая важная) и, по «Сменить стратегию», список стратегий. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="22" Height="22" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,10,16,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hint}" FontSize="15" Margin="0,2,0,0" />
                                    <!-- Итог «Проверить сейчас»: по группе ✓ или ✗; адреса — в «Подробнее». -->
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasCheck, Converter={StaticResource Vis}}">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding CheckSummary}" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center" />
                                            <ItemsControl ItemsSource="{Binding CheckGroups}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,14,0" TextWrapping="NoWrap"><Run x:Name="M" Text="{Binding Mark, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ok}" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                                <Setter TargetName="M" Property="Foreground" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CheckedAt}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <Expander Header="Подробнее" Margin="0,6,0,0">
                                            <ItemsControl ItemsSource="{Binding CheckRows}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="M" Text="{Binding Mark}" FontWeight="Bold" Foreground="{DynamicResource Ok}" />
                                                            <TextBlock Grid.Column="1" TextWrapping="NoWrap" Margin="0,0,10,0">
                                                                <Run Text="{Binding Group, Mode=OneWay}" /><Run Text=" · " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="2" Text="{Binding Url}" Style="{StaticResource Hint}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Url}" />
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                                <Setter TargetName="M" Property="Foreground" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                    <!-- Второстепенные действия — ссылками. -->
                                    <WrapPanel Margin="-4,12,0,0">
                                        <Button Content="Проверить сейчас" Style="{StaticResource LinkButton}" Command="{Binding CheckNowCmd}" Margin="0,0,10,0" />
                                        <Button Content="{Binding StrategiesLinkText}" Style="{StaticResource LinkButton}" Command="{Binding ToggleStrategiesCmd}" Margin="0,0,10,0" />
                                        <Button Content="Подобрать заново" Style="{StaticResource LinkButton}" Command="{Binding GoSelectCmd}" Margin="0,0,4,0" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.Home}" Margin="4,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <!-- Выключатель. Обход делает роутер — кнопка ПК второстепенная: «Включить и на этом ПК». -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,6,0,0">
                                    <Button ContentTemplate="{StaticResource Shield}" Content="{Binding ToggleText}" Style="{StaticResource Primary}" Command="{Binding ToggleCmd}"
                                            MinWidth="150" Padding="24,11" FontSize="15" Margin="0" Visibility="{Binding PcPrimary, Converter={StaticResource Vis}}" />
                                    <Button ContentTemplate="{StaticResource Shield}" Content="{Binding ToggleText}" Command="{Binding ToggleCmd}" Margin="0"
                                            Visibility="{Binding PcSecondary, Converter={StaticResource Vis}}" ToolTip="Обход уже делает роутер — и для этого ПК тоже" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Роутер с DpiShell найден (router-api §6): одной строкой, действия и предупреждения — на вкладке «Роутер». -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,8" Margin="0,0,0,12" DataContext="{Binding Router}"
                                Visibility="{Binding Found, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Войти" Style="{StaticResource LinkButton}" Command="{Binding LoginCmd}" Margin="8,0,0,0"
                                            Visibility="{Binding NeedLogin, Converter={StaticResource Vis}}" />
                                    <Button Content="Подробнее →" Style="{StaticResource LinkButton}" Command="{Binding DataContext.GoRouterCmd, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Margin="8,0,0,0" AutomationProperties.Name="Открыть вкладку «Роутер»" />
                                </StackPanel>
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RouterEnabled}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding HomeTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding HomeFixText}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,10,0"
                                           Visibility="{Binding HasHomeFix, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding HomeDetail}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip="{Binding HomeDetail}" />
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- «Сменить стратегию»: сразу под карточкой, выше помех (UX-аудит 2, п. 2) — раскрытый список виден, а не уходит за край окна.
                                     Прокручивается вместе со страницей (колесо мыши — странице). -->
                                <StackPanel x:Name="StrategiesBlock" Visibility="{Binding ShowStrategies, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding StrategyHeader}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding StrategyHeader}" />
                                    <ListBox ItemsSource="{Binding StrategyChoices}" SelectedValue="{Binding ChosenStrategyId}" SelectedValuePath="Id"
                                             IsEnabled="{Binding CanChoose}" Margin="0,0,0,10" PreviewMouseWheel="PassWheelToPage" AutomationProperties.Name="Стратегии">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Метка — в строке названия, чтобы статистика под ним шла во всю ширину. -->
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding Found, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="найдена поиском" FontSize="12" Foreground="{DynamicResource AccentText}" TextWrapping="NoWrap" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,1,0,0">
                                                        <!-- Найденную на ПК — на роутер (router-api §6); видно, только если роутер подключён. -->
                                                        <Border DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding DataContext.Router.Connected, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Vis}}">
                                                            <Button Content="Отправить на роутер" Style="{StaticResource LinkButton}" FontSize="12"
                                                                    Command="{Binding DataContext.Router.SendStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Id}"
                                                                    Visibility="{Binding Found, Converter={StaticResource Vis}}" ToolTip="Отправить на роутер, включить там и проверить" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Stats}" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Помехи: «Нашлось N помех», раскрыта самая важная, остальные — по «Ещё N». Обновление списков — не помеха, карточкой ниже. -->
                                <DockPanel Margin="0,0,0,8" Visibility="{Binding HasIssuesHeader, Converter={StaticResource Vis}}">
                                    <Button DockPanel.Dock="Right" Content="{Binding IssuesToggleText}" Style="{StaticResource LinkButton}" Command="{Binding ToggleIssuesCmd}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"><Run Text="⚠ " Foreground="{DynamicResource WarnLine}" /><Run Text="{Binding IssuesTitle, Mode=OneWay}" /></TextBlock>
                                </DockPanel>

                                <!-- router-api §6: обход и на ПК, и на роутере — вместе не работают; выключить один. -->
                                <Border Style="{StaticResource Warn}" Visibility="{Binding ShowBothOn, Converter={StaticResource Vis}}">
                                    <StackPanel DataContext="{Binding Router}">
                                        <TextBlock Text="Обход включён и здесь, и на роутере — вместе они ломают сайты." />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Выключить на ПК" Command="{Binding StopPcCmd}" />
                                            <Button Content="Выключить на роутере" Command="{Binding StopRouterCmd}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Warn}" Visibility="{Binding ShowConflicts, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ConflictWarning}" />
                                        <Button ContentTemplate="{StaticResource Shield}" Content="Остановить" Command="{Binding StopConflictsCmd}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Warn}" Visibility="{Binding ShowDns, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="DNS провайдера подменяет адреса сайтов. В браузере сайты могут работать, а Discord и другие программы — нет." />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding RecommendedDnsText}" Command="{Binding FixDnsCmd}" ToolTip="{Binding RecommendedDnsHint}" />
                                            <Button Content="Другой DNS" Style="{StaticResource LinkButton}" Command="{Binding ChooseDnsCmd}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Warn}" Visibility="{Binding ShowVpn, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding VpnWarning}" />
                                        <Button Content="Понятно, не показывать" Style="{StaticResource LinkButton}" Command="{Binding DismissVpnCmd}" HorizontalAlignment="Left" Margin="-4,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Обновление списков (architecture.md «Обновления данных»): видно, только когда у источника данные новее. -->
                                <Border Style="{StaticResource Card}" Padding="14" Visibility="{Binding ShowUpdate, Converter={StaticResource Vis}}">
                                    <DockPanel DataContext="{Binding Updates}">
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="Обновить списки" Command="{Binding InstallCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding AvailableText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ===== Подбор ===== -->
                <TabItem Header="Подбор">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <!-- Где подбирать — только когда роутер подключён (router-api §6). -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" DataContext="{Binding Router}"
                                        Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <TextBlock Text="Где подбирать:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <RadioButton Content="На этом ПК" IsChecked="{Binding SelectOnPc}" Margin="0,0,16,0" IsEnabled="{Binding CanConnect}" />
                                <RadioButton Content="На роутере" IsChecked="{Binding SelectOnRouter}" IsEnabled="{Binding CanConnect}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="Подбор стратегии" Style="{StaticResource H1}" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.Select}" Margin="10,0,0,12" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Что должно открываться" Style="{StaticResource H2}" />
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Режим" Style="{StaticResource H2}" />
                                <RadioButton IsChecked="{Binding Full}" Margin="0,3">
                                    <TextBlock><Run Text="Полный" /><Run Text=" — все стратегии, выбор лучшей" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </RadioButton>
                                <RadioButton IsChecked="{Binding Quick}" Margin="0,3">
                                    <TextBlock><Run Text="Быстрый" /><Run Text=" — до первой рабочей, начиная с прежних" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </RadioButton>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Visibility="{Binding Router.SelectOnPcVisible, Converter={StaticResource Vis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <WrapPanel>
                                <Button ContentTemplate="{StaticResource Shield}" Content="Начать подбор" Style="{StaticResource Primary}" Command="{Binding StartSelectCmd}" />
                                <Button Content="Стоп" Command="{Binding StopSelectCmd}" />
                            </WrapPanel>
                            <!-- Ход — только во время подбора: пустая полоса без подбора выглядела незавершённой операцией. -->
                            <StackPanel Visibility="{Binding Selecting, Converter={StaticResource Vis}}">
                                <ProgressBar Height="8" Maximum="{Binding SelectProgressMax}" Value="{Binding SelectProgress, Mode=OneWay}" IsIndeterminate="{Binding SelectIndeterminate}" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding SelectProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="Применить" Style="{StaticResource Primary}" Command="{Binding ApplyBestCmd}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasBest, Converter={StaticResource Vis}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding ResultText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResultHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                    <!-- Глубокий поиск — только когда готовые не помогли со всем (UX-аудит, п. 30). -->
                                    <WrapPanel Margin="0,10,0,0" Visibility="{Binding OfferDeep, Converter={StaticResource Vis}}">
                                        <TextBlock Text="Не нашлось стратегии для всего — можно поискать новые." VerticalAlignment="Center" Margin="0,0,10,8" />
                                        <Button ContentTemplate="{StaticResource Shield}" Content="Искать глубже (до 15 мин)" Command="{Binding StartSearchCmd}"
                                                ToolTip="Программа придумывает и проверяет новые стратегии; сайты и игры всё это время будут прерываться" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding Scores}" SelectedItem="{Binding SelectedScore}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
                                  RowHeaderWidth="0" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Стратегия" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Метки справа и целиком, обрезается название (в StackPanel метка уезжала за край).
                                                 «лучшая» — словом, как «найдена»: значок звезды в таблице читался непонятным символом. -->
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,4,0" VerticalAlignment="Center"
                                                        Visibility="{Binding Found, Converter={StaticResource Vis}}" ToolTip="Найдена глубоким поиском">
                                                    <TextBlock Text="найдена" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                </Border>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsBest, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="лучшая" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Группы" Binding="{Binding Groups}" Width="70" />
                                <DataGridTextColumn Header="Открылось" Binding="{Binding Share}" Width="90" />
                                <DataGridTextColumn Header="Время" Binding="{Binding Avg}" Width="80" />
                                <DataGridTemplateColumn Header="Ошибка" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Error}" ToolTip="{Binding ErrorFull}" Foreground="{DynamicResource Danger}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                            <Button ContentTemplate="{StaticResource Shield}" Content="Применить выбранную" Command="{Binding ApplySelectedCmd}" />
                            <TextBlock Text="Можно выбрать стратегию в таблице вручную." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                        </WrapPanel>
                        </Grid>

                        <!-- Подбор на роутере: группы и режим — те же, ход — select_progress, итог — «Применить на роутере». -->
                        <Grid Grid.Row="2" DataContext="{Binding Router}" Visibility="{Binding SelectOnRouterVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Начать подбор на роутере" Style="{StaticResource Primary}" Command="{Binding StartSelectCmd}" />
                                    <Button Content="Стоп" Command="{Binding StopSelectCmd}" />
                                </WrapPanel>
                                <TextBlock Text="Подбор идёт на самом роутере — программу можно закрыть. Лучшую стратегию роутер включит сам." Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                <StackPanel Visibility="{Binding Selecting, Converter={StaticResource Vis}}">
                                    <ProgressBar Height="8" Maximum="{Binding SelectProgressMax}" Value="{Binding SelectProgress, Mode=OneWay}" Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding SelectProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Применить на роутере" Style="{StaticResource Primary}" Command="{Binding ApplyCmd}"
                                            VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasBest, Converter={StaticResource Vis}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ResultText}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ResultHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                        <Button Content="Искать глубже (до 15 мин)" Command="{Binding StartDeepCmd}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                Visibility="{Binding OfferDeep, Converter={StaticResource Vis}}" ToolTip="Роутер придумывает и проверяет новые стратегии" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Scores}" SelectedItem="{Binding SelectedScore}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
                                      RowHeaderWidth="0" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Стратегия" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Вариант глубокого поиска — с пометкой справа: применить его нельзя, найденное в конце попадёт в стратегии роутера. -->
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource Hint}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsBest, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="лучшая" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Группы" Binding="{Binding Groups}" Width="70" />
                                    <DataGridTextColumn Header="Открылось" Binding="{Binding Share}" Width="90" />
                                    <DataGridTextColumn Header="Время" Binding="{Binding Avg}" Width="80" />
                                    <DataGridTemplateColumn Header="Ошибка" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Error}" ToolTip="{Binding Error}" Foreground="{DynamicResource Danger}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button Content="Применить выбранную" Command="{Binding ApplySelectedCmd}" />
                                <TextBlock Text="Лучшую роутер включает сам; другую можно выбрать в таблице." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Свои адреса ===== -->
                <TabItem Header="Свои адреса">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <!-- Вкладки «На этом ПК» / «На роутере» — только когда роутер подключён. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" DataContext="{Binding Router}"
                                        Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <RadioButton Content="На этом ПК" IsChecked="{Binding TargetsOnPc}" Margin="0,0,16,0" />
                                <RadioButton Content="На роутере" IsChecked="{Binding TargetsOnRouter}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="Свои адреса" Style="{StaticResource H1}" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.Targets}" Margin="10,0,0,12" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Grid.RowSpan="3" Visibility="{Binding Router.TargetsOnPcVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <TextBlock Text="Списки доменов" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.DomainLists}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="Сайт или адрес на строку. Эти сайты проверяются при подборе и открываются через обход." />
                            </DockPanel>
                            <TextBox Grid.Row="1" Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AutomationProperties.Name="Свои адреса"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="14" Padding="8" />
                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="Сохранить" Style="{StaticResource Primary}" Command="{Binding SaveTargetsCmd}" VerticalAlignment="Top" />
                                <!-- Несохранённое видно (UX-аудит 2, п. 15): подбор берёт сохранённое; при уходе с вкладки и перед подбором сохраняется само. -->
                                <TextBlock DockPanel.Dock="Left" Text="Не сохранено" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,8"
                                           Visibility="{Binding TargetsDirty, Converter={StaticResource Vis}}" ToolTip="Подбор учитывает сохранённый список. Сохраню сам перед подбором и при уходе с вкладки." />
                                <TextBlock Text="{Binding TargetsMessage}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                            </DockPanel>
                        </Grid>

                        <!-- Свои адреса и списки роутера (targets_get/set, lists_get/set): с ПК не синхронизируются сами. -->
                        <Grid Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Router}" Visibility="{Binding TargetsOnRouterVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Роутер проверяет эти адреса при подборе — для всех устройств дома. До 50. «Важный» — без него стратегия не считается рабочей." />
                            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <TextBlock Text="Адресов нет — добавьте или скопируйте с ПК." Style="{StaticResource Hint}" Margin="14,12"
                                               Visibility="{Binding Targets.Count, Converter={StaticResource Zero}}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6">
                                        <ItemsControl ItemsSource="{Binding Targets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="6,4" VerticalContentAlignment="Center"
                                                                 AutomationProperties.Name="Адрес" />
                                                        <CheckBox Grid.Column="1" Content="важный" IsChecked="{Binding Important}" VerticalAlignment="Center" Margin="14,0,10,0" />
                                                        <Button Grid.Column="2" Content="✕" Style="{StaticResource LinkButton}" ToolTip="Убрать" AutomationProperties.Name="Убрать адрес"
                                                                Command="{Binding DataContext.RemoveTargetCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Expander Grid.Row="2" Header="Списки роутера: что обходить и исключения" Margin="0,10,0,0">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Обходить (домен на строку)" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ListGeneralText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110"
                                                 FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="Обходить" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Исключения (обход их не трогает)" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ListExcludeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110"
                                                 FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="Исключения" />
                                    </StackPanel>
                                </Grid>
                            </Expander>
                            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button Content="Сохранить на роутере" Style="{StaticResource Primary}" Command="{Binding SaveTargetsCmd}" />
                                <Button Content="Добавить адрес" Command="{Binding AddTargetCmd}" />
                                <Button Content="Скопировать с ПК" Command="{Binding CopyFromPcCmd}" />
                                <TextBlock Text="{Binding TargetsMessage}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Игры и IP-списки (09-features-spec §1–2) =====
                     Один экран: игровой режим работает только по IP-списку — зависимость видна сразу, и «включил IP-список сам» не сюрприз. -->
                <TabItem Header="Игры и IP-списки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding Net}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Игровой режим" Style="{StaticResource H1}" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.Game}" Margin="10,0,0,12" />
                            </StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameOn}" IsEnabled="{Binding GameCanToggle}" HorizontalAlignment="Left">
                                        <TextBlock Text="Игры и голосовые программы" FontSize="15" FontWeight="SemiBold" />
                                    </CheckBox>
                                    <TextBlock Text="{Binding GameStatus}" Margin="50,6,0,0" />
                                    <TextBlock Text="{Binding GameHint}" Style="{StaticResource Hint}" Margin="50,2,0,0" />
                                    <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                            Padding="10,6" Margin="50,10,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="Может вырасти задержка (пинг) в играх и нагрузка на процессор — особенно при торрентах." FontSize="13" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="IP-списки" Style="{StaticResource H1}" FontSize="19" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.IpLists}" Margin="10,0,0,12" />
                            </StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Обход по адресам" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                    <WrapPanel IsEnabled="{Binding CanEdit}">
                                        <RadioButton Content="Выкл" IsChecked="{Binding IpsetOff}" Margin="0,3,24,3" />
                                        <RadioButton Content="Только из списков" IsChecked="{Binding IpsetList}" Margin="0,3,24,3" />
                                    </WrapPanel>
                                    <!-- «Все адреса» — проверка с подтверждением, а не третий режим наравне с рабочими (UX-аудит, п. 34). -->
                                    <Button ContentTemplate="{StaticResource Shield}" Content="Проверить, поможет ли обход (10 мин)" Command="{Binding TryAnyCmd}" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" ToolTip="На 10 минут — обход для любого соединения; сайты в это время могут работать с ошибками"
                                            Visibility="{Binding AnyActive, Converter={StaticResource InvVis}}" IsEnabled="{Binding CanEdit}" />
                                    <Border Style="{StaticResource Warn}" Margin="0,10,0,0" Visibility="{Binding AnyActive, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="Вернуть сейчас" Command="{Binding StopAnyCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding AnyText}" FontWeight="SemiBold" />
                                                <TextBlock Text="Сейчас обход идёт для любого соединения — многие сайты могут работать с ошибками." FontSize="13" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Список адресов" Style="{StaticResource Hint}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding ListText}" />
                                            <TextBlock Text="{Binding UpdateNote}" Foreground="{DynamicResource Danger}" FontSize="13" Margin="0,4,0,0"
                                                       Visibility="{Binding HasUpdateNote, Converter={StaticResource Vis}}" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button ContentTemplate="{StaticResource Shield}" Content="Обновить список" Command="{Binding UpdateListCmd}" />
                                                <Button ContentTemplate="{StaticResource Shield}" Content="Загрузить из файла…" Command="{Binding LoadFileCmd}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Свои подсети" Style="{StaticResource H2}" />
                                    <TextBlock Text="{Binding UserHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Добавить к списку" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding UserText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110"
                                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="Добавить к списку" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Исключения" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110"
                                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="Исключения" />
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="Сохранить" Style="{StaticResource Primary}" Command="{Binding SaveUserCmd}" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding UserMessage}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Починить адреса (hosts, 09-features-spec §3) ===== -->
                <TabItem Header="Починить адреса">
                    <Grid DataContext="{Binding Hosts}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Починить адреса" Style="{StaticResource H1}" />
                            <local:InfoButton Topic="{x:Static local:InfoTexts.Hosts}" Margin="10,0,0,12" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="Вернуть как было" Command="{Binding RevertCmd}" VerticalAlignment="Top" Margin="12,0,0,0"
                                            Visibility="{Binding BlockPresent, Converter={StaticResource Vis}}" />
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="GitHub, Telegram и Discord через проверенные адреса" FontSize="15" FontWeight="SemiBold" />
                                    </CheckBox>
                                </DockPanel>
                                <TextBlock Text="{Binding OffHint}" Style="{StaticResource Hint}" Margin="50,4,0,0" Visibility="{Binding Disabled, Converter={StaticResource Vis}}" />
                                <StackPanel Margin="50,4,0,0" Visibility="{Binding Enabled, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding StatusText}" />
                                    <ItemsControl ItemsSource="{Binding AppliedLines}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Muted}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                                    Padding="10,6" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding}" FontSize="13" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Visibility="{Binding Enabled, Converter={StaticResource Vis}}">
                            <WrapPanel>
                                <Button ContentTemplate="{StaticResource Shield}" Content="Проверить адреса" Style="{StaticResource Primary}" Command="{Binding CheckCmd}" />
                                <Button Content="Стоп" Command="{Binding StopCmd}" Visibility="{Binding Checking, Converter={StaticResource Vis}}" />
                            </WrapPanel>
                            <StackPanel Visibility="{Binding Checking, Converter={StaticResource Vis}}">
                                <ProgressBar Height="8" Maximum="{Binding Total}" Value="{Binding Done, Mode=OneWay}" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,8" Visibility="{Binding HasSummary, Converter={StaticResource Vis}}" />
                        </StackPanel>

                        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" CanUserAddRows="False" MinHeight="90"
                                  Visibility="{Binding Rows.Count, Converter={StaticResource NonZero}}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <!-- Не записываются — серым «не нужно» (architecture.md «Починить адреса (hosts)»). -->
                                        <DataTrigger Binding="{Binding Install}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Две строки на ячейку: таблица помещается в окно минимальной ширины без обрезанных слов. -->
                                <DataGridTemplateColumn Header="Сайт и адрес" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Host}">
                                                <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Ip}" FontSize="13" Opacity="0.75" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Владелец" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Owner}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Owner}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Проверка" Width="1.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Live}" TextWrapping="NoWrap" />
                                                <TextBlock FontSize="13" Opacity="0.75" TextWrapping="NoWrap"><Run Text="DNS: " /><Run Text="{Binding Dns, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Итог" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Reason}">
                                                <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Reason}" FontSize="13" Opacity="0.75" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Предпросмотр: что именно изменится в hosts, затем «Записать» с подтверждением. -->
                        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14" Visibility="{Binding CanWrite, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{Binding ApplyText}" Style="{StaticResource Primary}" Command="{Binding ApplyCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="Что изменится в hosts" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding PreviewLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== Диагностика: только проверки и исправления (UX-аудит п. 12); настройки, обновления, помощник — во вкладке «Настройки». ===== -->
                <TabItem Header="Диагностика">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DiagUpdated}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource LinkButton}" Command="{Binding RefreshDiagCmd}" AutomationProperties.Name="{Binding RefreshButtonText}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Значок «обновить» из системного шрифта Windows 10/11 (Segoe Fluent Icons / Segoe MDL2 Assets). -->
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding RefreshButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="Диагностика" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Diag}" Margin="10,0,0,12" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Обход: одна строка, внутренности (драйвер, файлы, метки TCP) — за «Подробнее» (п. 15). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock><Run Text="Обход: " Foreground="{DynamicResource Muted}" /><Run Text="{Binding ServiceText, Mode=OneWay}" /></TextBlock>
                                    <Expander Header="Подробнее" Margin="0,8,0,0">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Драйвер" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Column="1" Text="{Binding DriverText}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Text="Файлы обхода" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreText}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="2" Text="Временные метки TCP" Style="{StaticResource Hint}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TimestampsText}" />
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Warn}" Visibility="{Binding CoreBroken, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="Файлы обхода повреждены — обычно это антивирус." FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Button ContentTemplate="{StaticResource Shield}" Content="Восстановить" Style="{StaticResource Primary}" Command="{Binding RepairCoreCmd}" HorizontalAlignment="Left" />
                                    <!-- Путь не переписывать руками: «Скопировать путь» и сразу «Безопасность Windows» (п. 16). -->
                                    <TextBlock Margin="0,4,0,0" Text="Чтобы не повторилось, добавьте папку в исключения Защитника: «Защита от вирусов и угроз» → «Управление настройками» → «Исключения» → «Добавить» → «Папка»." />
                                    <TextBlock Text="{Binding CoreFolder}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding CoreFolder}" />
                                    <WrapPanel Margin="-4,6,0,0">
                                        <Button Content="Скопировать путь" Style="{StaticResource LinkButton}" Command="{Binding CopyCoreFolderCmd}" Margin="0,0,10,0" />
                                        <Button Content="Открыть Защитник" Style="{StaticResource LinkButton}" Command="{Binding OpenDefenderCmd}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Другие программы обхода" Style="{StaticResource H2}" />
                                    <TextBlock Text="Не найдены." Style="{StaticResource Hint}" Visibility="{Binding ConflictList.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding ConflictList}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Они перехватывают тот же трафик. Закройте или удалите их, иначе обход работать не будет." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="VPN" Style="{StaticResource H2}" />
                                    <TextBlock Text="Не найден." Style="{StaticResource Hint}" Visibility="{Binding VpnList.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding VpnList}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="При включённом VPN обход обычно не нужен, а подбор показывает неверный результат." />
                                </StackPanel>
                            </Border>

                            <!-- Проверки окружения (09-features-spec §4): только показываем, что мешает и что сделать. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Что ещё может мешать" Style="{StaticResource H2}" />
                                    <TextBlock Text="Проверяется при обновлении страницы." Style="{StaticResource Hint}" Visibility="{Binding Findings.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="M" Text="{Binding Mark}" FontWeight="Bold" Foreground="{DynamicResource Ok}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Hint}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter TargetName="M" Property="Foreground" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Решение 5: кэш Discord — кнопкой, с подтверждением (открытый Discord закрывается). -->
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Очистить кэш Discord" Command="{Binding ClearDiscordCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Discord долго подключается" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="После смены стратегии Discord может помнить неудачные попытки. Очистка удаляет только его временные файлы — вход и настройки останутся." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- DNS — один экран (аудит, сноска к «Вкладкам»): вывод проверки, выбор DNS этого компьютера, таблица — в «Подробнее» (п. 17). -->
                            <Border x:Name="PcDnsCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Проверить DNS" Style="{StaticResource LinkButton}" Command="{Binding CheckDnsCmd}" VerticalAlignment="Top" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="DNS" Style="{StaticResource H2}" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.Dns}" Margin="8,0,0,6" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding DnsSummary}" Margin="0,0,0,2" />
                                    <Expander Header="Подробнее: ответы DNS" Margin="0,4,0,0" Visibility="{Binding DnsRows.Count, Converter={StaticResource NonZero}}">
                                        <StackPanel Margin="0,6,0,0">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Сайт" Style="{StaticResource Hint}" />
                                                <TextBlock Grid.Column="1" Text="Системный DNS" Style="{StaticResource Hint}" />
                                                <TextBlock Grid.Column="2" Text="Защищённый DNS" Style="{StaticResource Hint}" />
                                                <TextBlock Grid.Column="3" Text="Подмена" Style="{StaticResource Hint}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding DnsRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="80" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Host}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding System}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding System}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Doh}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Doh}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Mark}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="Подбор и проверка берут адреса через защищённый DNS, поэтому подмена на их результат не влияет." />
                                        </StackPanel>
                                    </Expander>
                                    <!-- DNS этого компьютера (architecture.md «DNS этого компьютера»): вариант в один клик, «Вернуть как было». -->
                                    <Border x:Name="PcDnsPicker" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DNS этого компьютера" Style="{StaticResource H2}" />
                                            <local:DnsPickerView DataContext="{Binding PcDns}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Роутер: diag, чужие обходы с «Остановить», отчёт (router-api §6). -->
                            <Border Style="{StaticResource Card}" DataContext="{Binding Router}" Visibility="{Binding Found, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding DiagUpdated}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Content="Сохранить отчёт роутера" Style="{StaticResource LinkButton}" Command="{Binding SaveReportCmd}" Margin="0,0,8,0" />
                                            <Button Content="Проверить снова" Style="{StaticResource LinkButton}" Command="{Binding RefreshDiagCmd}" />
                                        </StackPanel>
                                        <TextBlock Text="Роутер: что мешает" Style="{StaticResource H2}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding DiagHint}" Style="{StaticResource Hint}" Visibility="{Binding ShowDiagHint, Converter={StaticResource Vis}}" />
                                    <StackPanel Visibility="{Binding DiagLoaded, Converter={StaticResource Vis}}">
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Ускорение сети" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding FlowOffloadText}" />
                                                <Button Content="Исправить" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Command="{Binding FixWarningCmd}" CommandParameter="flow_offload"
                                                        Visibility="{Binding FlowOffloadFixable, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="IPv6 у провайдера" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Ipv6Text}" />
                                                <Button Content="Исправить" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Command="{Binding FixWarningCmd}" CommandParameter="ipv6"
                                                        Visibility="{Binding Ipv6Fixable, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="DNS" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DnsText}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="3" Text="Свободно места" Style="{StaticResource Hint}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SpaceText}" />
                                        </Grid>
                                        <TextBlock Text="Другие программы обхода на роутере" Style="{StaticResource Hint}" Margin="0,12,0,4" />
                                        <TextBlock Text="Не найдены." Visibility="{Binding Conflicts.Count, Converter={StaticResource Zero}}" />
                                        <ItemsControl ItemsSource="{Binding Conflicts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <Button DockPanel.Dock="Right" Content="Остановить" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                                                Visibility="{Binding CanStop, Converter={StaticResource Vis}}"
                                                                Command="{Binding DataContext.StopConflictCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}" />
                                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Для вопроса о проблеме: журнал. -->
                            <WrapPanel>
                                <Button Content="Папка логов" Command="{Binding OpenLogsCmd}" />
                                <Button Content="Папка результатов" Command="{Binding OpenResultsCmd}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Роутер (router-api §5–6): обход, режим, «Сайт не открывается», DNS для всей сети, «Проверять сам», подключение.
                     Видна всегда (п. 47): роутер не найден — пустое состояние, что можно сделать, и адрес. ===== -->
                <TabItem Header="Роутер">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Router}">
                        <StackPanel>
                            <TextBlock Text="Роутер" Style="{StaticResource H1}" />

                            <!-- Пустое состояние: DpiShell на роутере не найден. -->
                            <!-- Пока не искали — «не проверялся» (UX-аудит 2, п. 10); как поставить — ссылка на инструкцию и место под «Установить на роутер» (п. 9). -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Found, Converter={StaticResource InvVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Text="Если у вас роутер с OpenWrt, на него можно поставить DpiShell — тогда обход будет работать для всех устройств дома: телефонов, телевизора, приставки. Без роутера всё работает и на одном этом компьютере." />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="OpenWrt ли у вас: откройте в браузере адрес роутера (обычно 192.168.1.1) — у OpenWrt страница входа называется LuCI." />
                                    <WrapPanel Margin="-4,10,0,0">
                                        <!-- Установка из окна по SSH (router-api §5.4): кнопка появится, когда окно задаст Router.InstallCmd. -->
                                        <Button Content="Установить на роутер" Style="{StaticResource Primary}" Command="{Binding InstallCmd}" Margin="4,0,8,0"
                                                Visibility="{Binding CanInstall, Converter={StaticResource Vis}}" />
                                        <Button Content="Как поставить на роутер ↗" Style="{StaticResource LinkButton}" Command="{Binding GuideCmd}" VerticalAlignment="Center"
                                                ToolTip="Инструкция на GitHub: docs/router/README.md" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="DpiShell на роутере уже стоит? Нажмите «Найти» ниже." />
                                </StackPanel>
                            </Border>

                            <!-- Обход на роутере: состояние, предупреждения с «Исправить», действия (на главной — одна строка со ссылкой сюда). -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Found, Converter={StaticResource Vis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,6,12,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RouterEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding HomeTitle}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HomeDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                                        <!-- Предупреждения роутера: у исправимых (flow_offload, ipv6) — «Исправить», у чужого обхода — «Подробнее». -->
                                        <ItemsControl ItemsSource="{Binding WarningRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Button Content="{Binding Fix}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasFix, Converter={StaticResource Vis}}"
                                                                    Command="{Binding DataContext.FixWarningCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Code}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Метки TCP (needs_tcp_timestamps): не смогли включить сами — плашка как у предупреждений и «Включить» со щитом (меняет Windows этого ПК);
                                             включили — серой строкой. Термин — только в подсказке (UX-аудит 2, п. 8). -->
                                        <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="4"
                                                Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left" ToolTip="{x:Static local:RouterViewModel.TimestampsTerm}"
                                                Visibility="{Binding TimestampsNeedAction, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TimestampsNote}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                                                <Button Content="Включить" ContentTemplate="{StaticResource Shield}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding EnableTimestampsCmd}" ToolTip="{x:Static local:RouterViewModel.TimestampsTerm}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding TimestampsNote}" Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   ToolTip="{x:Static local:RouterViewModel.TimestampsTerm}" Visibility="{Binding TimestampsDone, Converter={StaticResource Vis}}" />
                                        <WrapPanel Margin="0,12,0,0" Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                            <Button Content="{Binding ToggleText}" Command="{Binding ToggleCmd}" />
                                            <Button Content="Проверить" Command="{Binding CheckCmd}" />
                                            <Button Content="Подобрать на роутере" Command="{Binding GoSelectCmd}" />
                                            <Button Click="RouterStrategy_Click" IsEnabled="{Binding CanAct}" ToolTip="Стратегия на роутере" AutomationProperties.Name="Стратегия на роутере">
                                                <TextBlock><Run Text="Стратегия" /><Run Text=" ▾" Foreground="{DynamicResource Muted}" /></TextBlock>
                                            </Button>
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding NeedLogin, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                            <TextBlock Text="Войдите на роутер, чтобы управлять обходом на нём." Style="{StaticResource Hint}" />
                                            <Button Content="Войти" Command="{Binding LoginCmd}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <!-- Режим: «Все сайты, кроме исключений» (по умолчанию) / «По спискам» (mode_set). -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Для каких сайтов обход" Style="{StaticResource H2}" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.RouterMode}" Margin="8,0,0,8" />
                                        </StackPanel>
                                        <RadioButton Content="Все сайты" IsChecked="{Binding ModeAll}" IsEnabled="{Binding CanAct}" Margin="0,3" HorizontalAlignment="Left" />
                                        <RadioButton Content="Только из списков" IsChecked="{Binding ModeLists}" IsEnabled="{Binding CanAct}" Margin="0,3" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- «Сайт не открывается»: site_check с обходом и без, итог — site_check_result. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Сайт не открывается" Style="{StaticResource H2}" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.SiteCheck}" Margin="8,0,0,8" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}" Width="280" Padding="6,4" VerticalAlignment="Center"
                                                     ToolTip="Адрес сайта, например example.com" AutomationProperties.Name="Адрес сайта">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding SiteCheckCmd}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Content="Проверить" Command="{Binding SiteCheckCmd}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ProgressBar Height="4" IsIndeterminate="{Binding SiteChecking}" Margin="0,8,0,0" Width="280" HorizontalAlignment="Left"
                                                     Visibility="{Binding SiteChecking, Converter={StaticResource Vis}}" />
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSiteResult, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding SiteResult}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SiteHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <Button Content="Добавить в исключения" Style="{StaticResource Primary}" Command="{Binding AddExcludeCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    Visibility="{Binding SiteSuggestExclude, Converter={StaticResource Vis}}" />
                                            <Expander Header="Подробнее" Margin="0,6,0,0" Visibility="{Binding HasSiteDetail, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding SiteDetail}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- DNS для всей сети: dns_status, «Проверить», «Включить защищённый DNS», «Вернуть как было» (фоновые задания). -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="DNS для всей сети" Style="{StaticResource H2}" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.RouterDns}" Margin="8,0,0,8" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DnsState}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding DnsLoaded, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding DnsHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding HasDnsHint, Converter={StaticResource Vis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasDnsJob, Converter={StaticResource Vis}}">
                                            <ProgressBar Height="4" Width="60" IsIndeterminate="{Binding DnsRunning}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Visibility="{Binding DnsRunning, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding DnsJobText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Проверить" Command="{Binding DnsCheckCmd}" />
                                            <!-- Старый пакет на роутере (без dns_presets) — одна кнопка, как раньше. -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding DnsSingleButton, Converter={StaticResource Vis}}">
                                                <Button Content="Включить защищённый DNS" Style="{StaticResource Primary}" Command="{Binding DnsEnableCmd}"
                                                        Visibility="{Binding DnsCanEnable, Converter={StaticResource Vis}}" />
                                                <Button Content="Вернуть как было" Command="{Binding DnsRestoreCmd}"
                                                        Visibility="{Binding DnsProtected, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <!-- Варианты для всей сети — тот же выбор, что для этого компьютера (свои — общие). -->
                                        <local:DnsPickerView x:Name="RouterDnsPicker" DataContext="{Binding DnsPick}" Margin="0,10,0,0"
                                                             Visibility="{Binding DataContext.DnsPresetsAvailable, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource Vis}}" />
                                        <Expander Header="Подробнее" Visibility="{Binding DnsServers.Count, Converter={StaticResource NonZero}}">
                                            <ItemsControl ItemsSource="{Binding DnsServers}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Hint}" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- «Проверять сам» и автоподбор (schedule_set) — на роутере, на ПК фоновой проверки нет. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Проверять сам" Style="{StaticResource H2}" />
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Проверять сайты" IsChecked="{Binding ScheduleEnabled}" IsEnabled="{Binding CanAct}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding Source={x:Static local:RouterViewModel.ScheduleOptions}}" DisplayMemberPath="Title" SelectedValuePath="Hours"
                                                      SelectedValue="{Binding ScheduleHours}" IsEnabled="{Binding ScheduleEditable}" Width="180" Margin="14,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Как часто проверять" />
                                        </StackPanel>
                                        <TextBlock Text="При неудаче роутер переключится на запасную стратегию." Style="{StaticResource Hint}" Margin="26,4,0,0" />
                                        <CheckBox Content="Если не помогло — подобрать заново" IsChecked="{Binding AutoSelect}" IsEnabled="{Binding ScheduleEditable}"
                                                  Margin="0,10,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="Подбор 2–3 мин, не чаще раза в 6 ч; на это время сайты на всех устройствах будут прерываться." Style="{StaticResource Hint}"
                                                   Margin="26,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Подключение: адрес и вход (раньше — карточка в конце «Диагностики»). Пароль — в диалоге «Войти». -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Подключение" Style="{StaticResource H2}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Найти" Command="{Binding FindCmd}" />
                                        <Button Content="Войти…" Style="{StaticResource Primary}" Command="{Binding LoginCmd}" Visibility="{Binding NeedLogin, Converter={StaticResource Vis}}" />
                                        <Button Content="Сменить пароль…" Command="{Binding LoginCmd}" Visibility="{Binding Connected, Converter={StaticResource Vis}}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Searched, Converter={StaticResource Vis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConnectionOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Адрес — в «Дополнительно», как в окне входа: обычно его определяют сами (UX-аудит 2, п. 10). -->
                                    <Expander Header="Дополнительно: адрес роутера" Margin="0,8,0,0" IsExpanded="{Binding AddressCustom, Mode=OneTime}">
                                        <StackPanel Margin="0,4,0,0">
                                            <RadioButton Content="{Binding AutoAddressText}" IsChecked="{Binding AddressAuto}" Margin="0,3" HorizontalAlignment="Left" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <RadioButton Content="Свой:" IsChecked="{Binding AddressCustom}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Text="{Binding CustomAddress, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="6,4" IsEnabled="{Binding AddressCustom}"
                                                         ToolTip="IP или имя роутера, например 192.168.1.1" AutomationProperties.Name="Адрес роутера">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding FindCmd}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Настройки (UX-аудит п. 12): работа, вид, обновления, помощник, данные, удаление. ===== -->
                <TabItem Header="Настройки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Настройки" Style="{StaticResource H1}" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Работа" Style="{StaticResource H2}" />
                                    <!-- Режим службы (п. 4 аудита): настройка «на один раз», не действие главной. -->
                                    <CheckBox Content="Работать, даже когда окно закрыто" IsChecked="{Binding ServiceMode}" IsEnabled="{Binding CanChoose}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RunModeHint}" Style="{StaticResource Hint}" Margin="26,2,0,0" />
                                    <!-- Автозапуск окна при входе (architecture.md «Окно, трей, автозапуск»): ключ Run пользователя, окно — в трее. -->
                                    <CheckBox Content="Запускать вместе с Windows (в трее)" IsChecked="{Binding Autostart.Enabled}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Autostart.Hint}" Style="{StaticResource Hint}" Margin="26,2,0,0" />
                                    <TextBlock Text="При закрытии окна" Style="{StaticResource Hint}" Margin="0,12,0,2" />
                                    <WrapPanel>
                                        <RadioButton Content="Сворачивать в трей" IsChecked="{Binding CloseTray}" Margin="0,3,24,3" />
                                        <RadioButton Content="Закрывать программу" IsChecked="{Binding CloseExit}" Margin="0,3,24,3" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CloseHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="{Binding HasCloseHint, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Оформление" Style="{StaticResource H2}" />
                                    <WrapPanel>
                                        <RadioButton Content="Как в Windows" IsChecked="{Binding ThemeAuto}" Margin="0,3,24,3" />
                                        <RadioButton Content="Светлое" IsChecked="{Binding ThemeLight}" Margin="0,3,24,3" />
                                        <RadioButton Content="Тёмное" IsChecked="{Binding ThemeDark}" Margin="0,3,24,3" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Обновления данных (architecture.md «Обновления данных»): проверка раз в день, установка — помощник; программа — ссылкой на релиз. -->
                            <Border Style="{StaticResource Card}" DataContext="{Binding Updates}">
                                <StackPanel>
                                    <TextBlock Text="Обновления" Style="{StaticResource H2}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" />
                                    <TextBlock Text="{Binding AvailableText}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding DataAvailable, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding AppText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding AppAvailable, Converter={StaticResource Vis}}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <!-- Списки и программа — разными словами (UX-аудит 2, п. 13). -->
                                        <Button ContentTemplate="{StaticResource Shield}" Content="Обновить списки" Style="{StaticResource Primary}" Command="{Binding InstallCmd}"
                                                Visibility="{Binding DataAvailable, Converter={StaticResource Vis}}" />
                                        <Button Content="{Binding AppButtonText}" Command="{Binding OpenReleaseCmd}"
                                                Visibility="{Binding AppAvailable, Converter={StaticResource Vis}}" />
                                        <Button Content="Проверить обновления" Command="{Binding CheckCmd}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- О программе и помощник (helper-protocol): версия, состояние, переустановка. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="О программе" Style="{StaticResource H2}" />
                                    <TextBlock Text="{Binding AboutText}" Style="{StaticResource Hint}" />
                                    <Button Content="{Binding FixHelperText}" Command="{Binding FixHelperCmd}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="{Binding HasHelperProblem, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>

                            <!-- Удаление — отдельно, спокойным стилем, с тем, как вернуть (UX-аудит, «Опасные действия», п. 18–19). -->
                            <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                                <StackPanel>
                                    <TextBlock Text="Очистка и удаление" Style="{StaticResource H2}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="Очистить историю" Command="{Binding ClearHistoryCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="Результаты подборов, статистика и логи. Свои адреса и найденные стратегии останутся." />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="Удалить службу полностью" Command="{Binding RemoveServiceCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="Служба обхода и драйвер WinDivert. Обход перестанет работать; вернуть — кнопкой «Включить» на главной." />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding CanUninstallHelper, Converter={StaticResource Vis}}">
                                        <Button DockPanel.Dock="Right" Content="Удалить помощника" Command="{Binding UninstallHelperCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="Окно останется только для просмотра. Вернуть — при первом действии программа предложит поставить помощника снова (один запрос прав)." />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Тост: итог обратимого действия с «Вернуть» (DNS этого ПК) и ошибки операций (красная рамка), над строкой состояния.
             Сам скрывается, но не пока над ним мышь (UX-аудит 2, п. 14, 16). -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="190,0,0,44" MaxWidth="560" Padding="16,10,10,10" CornerRadius="8"
                Background="{DynamicResource Surface}" MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave"
                Visibility="{Binding HasToast, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButton}" Command="{Binding CloseToastCmd}" VerticalAlignment="Center"
                        Foreground="{DynamicResource Muted}" Margin="4,0,0,0" ToolTip="Закрыть" AutomationProperties.Name="Закрыть сообщение" />
                <Button DockPanel.Dock="Right" Content="{Binding ToastAction}" ContentTemplate="{StaticResource Shield}" Command="{Binding ToastCmd}" VerticalAlignment="Center"
                        Margin="12,0,0,0" Visibility="{Binding HasToastAction, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Загрузка ядра при старте -->
        <Grid Background="{DynamicResource Page}" Visibility="{Binding ShowOverlay, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="DpiShell" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding LoadingText}" Margin="0,0,0,14" />
                    <ProgressBar Height="6" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadFailed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <!-- Не ответил или отвечает дольше 10 с — выход с первого экрана (UX-аудит, п. 46). -->
                    <WrapPanel Margin="0,4,0,0" Visibility="{Binding ShowLoadActions, Converter={StaticResource Vis}}">
                        <Button Content="Повторить" Style="{StaticResource Primary}" Command="{Binding RetryCmd}" />
                        <Button Content="Открыть без помощника" Command="{Binding OpenWithoutHelperCmd}" ToolTip="Окно — только для просмотра; помощник подключится сам, когда ответит" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
