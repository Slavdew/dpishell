<Window x:Class="DpiShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DpiShell.App"
        xmlns:l="clr-namespace:DpiShell.App"
        Title="DpiShell" Height="640" Width="960" MinHeight="480" MinWidth="760"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:ZeroToVisible x:Key="Zero" />
        <local:ZeroToVisible x:Key="NonZero" Invert="True" />
        <local:FalseToVisible x:Key="InvVis" />
        <!-- Кнопки блока роутера: ниже обычных, чтобы блок не теснил список стратегий. -->
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel>
            <!-- Строка состояния -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding Message}" />
            </Border>

            <TabControl Style="{StaticResource Nav}" SelectedIndex="{Binding Page}" local:Nav.Collapsed="{Binding NavCollapsed}">

                <!-- ===== Главная (вариант A макета prototypes/combined, снимки A-*, A2-*) ===== -->
                <TabItem Header="{l:T common.nav.home}" AutomationProperties.Name="{l:T common.nav.home}" local:Nav.Icon="{StaticResource Ic.home}">
                    <!-- Карточка статуса: круглый значок, заголовок по общему итогу, итог проверки, одна большая кнопка ПК, служба; строки «Этот ПК» и «Роутер»
                         со стратегиями и значками состояния; под карточкой — плитки сайтов или панель подробностей; внизу — «Проверяется само». -->
                    <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="20,18,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Круглый значок состояния: галочка / роутер / питание / «!» / крестик / стрелка (идёт действие). -->
                                        <Grid Width="64" Height="64" VerticalAlignment="Top" Margin="0,0,16,0">
                                            <Ellipse x:Name="HeroOrb">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Track}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="on"><Setter Property="Fill" Value="{DynamicResource OkSoft}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="router"><Setter Property="Fill" Value="{DynamicResource OkSoft}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="partial"><Setter Property="Fill" Value="{DynamicResource WarnSoft}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="error"><Setter Property="Fill" Value="{DynamicResource DangerSoft}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="busy"><Setter Property="Fill" Value="{DynamicResource AccentSoft}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Path Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource HomeIcon.Power}" />
                                                        <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="on">
                                                                <Setter Property="Data" Value="{StaticResource HomeIcon.Checkmark}" /><Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="router">
                                                                <Setter Property="Data" Value="{StaticResource HomeIcon.Router}" /><Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="partial">
                                                                <Setter Property="Data" Value="{StaticResource HomeIcon.Warning}" /><Setter Property="Fill" Value="{DynamicResource WarnText}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="error">
                                                                <Setter Property="Data" Value="{StaticResource HomeIcon.Dismiss}" /><Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HeroState}" Value="busy">
                                                                <Setter Property="Data" Value="{StaticResource HomeIcon.ArrowClockwise}" /><Setter Property="Fill" Value="{DynamicResource AccentText}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,4,12,0">
                                            <TextBlock Text="{Binding StatusTitle}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Hint}" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <!-- Одна большая кнопка ПК: цветом — только когда нужно действие (выключено и роутер не ведёт). Под ней — служба (решение владельца). -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding ToggleText}" Style="{StaticResource Primary}" Command="{Binding ToggleCmd}"
                                                    MinWidth="190" Padding="24,12" FontSize="15" Margin="0" Visibility="{Binding PcAccent, Converter={StaticResource Vis}}" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding ToggleText}" Command="{Binding ToggleCmd}"
                                                    MinWidth="190" Padding="24,12" FontSize="15" Margin="0" Visibility="{Binding PcPlain, Converter={StaticResource Vis}}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                <Button ContentTemplate="{StaticResource Shield}" Content="{l:T home.service.install}" Command="{Binding InstallServiceCmd}" Padding="10,4" FontSize="13" Margin="0"
                                                        ToolTip="{l:T home.service.install.tip}" Visibility="{Binding ShowInstallService, Converter={StaticResource Vis}}" />
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowServiceInstalled, Converter={StaticResource Vis}}">
                                                    <Path Data="{StaticResource HomeIcon.Checkmark}" Fill="{DynamicResource Ok}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ServiceStateText}" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding ServiceStateTip}"
                                                               ToolTipService.IsEnabled="{Binding HasServiceStateTip}" />
                                                </StackPanel>
                                                <local:InfoButton Topic="{x:Static local:InfoTexts.Service}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                    </Grid>
                                    <!-- Две строки на всю ширину — от левого края круглого значка; стратегии — справа одной колонкой друг под другом. -->
                                    <Grid Margin="20,16,20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- Этот ПК -->
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource Ok}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{l:T home.pc.label}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="NoWrap" />
                                        <!-- Состояние переносится, значок — сразу за текстом (в строке текста). -->
                                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" ToolTip="{Binding PcStateTip}"><Run Text="{Binding PcStateText, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Center"><Button Style="{StaticResource BadgeButton}" Command="{Binding TogglePcPanelCmd}" ToolTip="{Binding PcHealthTip}"
                                                    AutomationProperties.Name="{Binding PcHealthTip}"><ContentControl Content="{Binding PcHealth}" ContentTemplate="{StaticResource HealthIcon}" Focusable="False" /></Button></InlineUIContainer></TextBlock>
                                        <TextBlock Grid.Column="3" Text="{l:T home.strategy.label}" Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" TextWrapping="NoWrap" />
                                        <Border Grid.Column="4" Background="{DynamicResource InputBack}" BorderBrush="{DynamicResource InputLine}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,3" VerticalAlignment="Center">
                                            <TextBox Text="{Binding PcStrategyText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" TextWrapping="NoWrap"
                                                     ToolTip="{Binding PcStrategyText}" AutomationProperties.Name="{l:T home.strategy.pc_aria}" />
                                        </Border>
                                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Margin="8,0,0,0" Command="{Binding CopyPcStrategyCmd}"
                                                ToolTip="{l:T home.copy}" AutomationProperties.Name="{l:T home.copy}">
                                            <Path Data="{StaticResource HomeIcon.Copy}" Fill="{DynamicResource Text}" Width="16" Height="16" Stretch="Uniform" />
                                        </Button>

                                        <!-- Роутер: строки нет, когда роутер не найден или «Показывать роутер» снят (Router.Found). -->
                                        <Ellipse Grid.Row="1" Width="9" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="{Binding ShowRouterRow, Converter={StaticResource Vis}}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Router.RouterEnabled}" Value="True"><Setter Property="Fill" Value="{DynamicResource Ok}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Button Grid.Row="1" Grid.Column="1" Content="{l:T home.router.label}" Style="{StaticResource LinkButton}" Command="{Binding GoRouterCmd}" FontSize="14" FontWeight="SemiBold"
                                                Margin="-4,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{l:T home.router.details.aria}" AutomationProperties.Name="{l:T home.router.details.aria}"
                                                Visibility="{Binding ShowRouterRow, Converter={StaticResource Vis}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                                   Visibility="{Binding ShowRouterRow, Converter={StaticResource Vis}}" ToolTip="{Binding RouterStateTip}"><Run Text="{Binding RouterStateText, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Center"><Button Style="{StaticResource BadgeButton}" Command="{Binding ToggleRouterPanelCmd}" ToolTip="{Binding RouterHealthTip}"
                                                    AutomationProperties.Name="{Binding RouterHealthTip}" Visibility="{Binding ShowRouterHealth, Converter={StaticResource Vis}}"><ContentControl Content="{Binding RouterHealth}" ContentTemplate="{StaticResource HealthIcon}" Focusable="False" /></Button></InlineUIContainer></TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{l:T home.strategy.label}" Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" TextWrapping="NoWrap"
                                                   Visibility="{Binding ShowRouterStrategy, Converter={StaticResource Vis}}" />
                                        <Button Grid.Row="1" Grid.Column="4" Click="RouterStrategy_Click" IsEnabled="{Binding Router.CanAct}" Padding="8,5" Margin="0,3" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"
                                                ToolTip="{l:T router.strategy_tip}" AutomationProperties.Name="{l:T router.strategy_tip}" Visibility="{Binding ShowRouterStrategy, Converter={StaticResource Vis}}">
                                            <DockPanel Width="182">
                                                <Path DockPanel.Dock="Right" Data="{StaticResource HomeIcon.ChevronDown}" Fill="{DynamicResource Muted}" Width="12" Height="12" Stretch="Uniform" Margin="6,0,0,0" />
                                                <TextBlock Text="{Binding RouterStrategyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding RouterStrategyText}" />
                                            </DockPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="5" Style="{StaticResource IconButton}" Margin="8,0,0,0" Command="{Binding Router.CopyCurrentParamsCmd}"
                                                ToolTip="{l:T home.router.copy_params}" AutomationProperties.Name="{l:T home.router.copy_params}"
                                                Visibility="{Binding ShowRouterStrategy, Converter={StaticResource Vis}}">
                                            <Path Data="{StaticResource HomeIcon.Copy}" Fill="{DynamicResource Text}" Width="16" Height="16" Stretch="Uniform" />
                                        </Button>
                                        <!-- Под строкой роутера, от колонки состояния: фраза о выключении без человека и действия роутера (охват только колонок без Auto — без цикла раскладки у переносимого текста). -->
                                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3">
                                            <!-- Выключение без человека (сторож, кнопка, откат пробы) — фразой под строкой роутера. -->
                                            <TextBlock Text="{Binding Router.OffText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding Router.HasOff, Converter={StaticResource Vis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Router.OffAlert}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Действия роутера — тише кнопки ПК. -->
                                            <WrapPanel Margin="0,8,0,0" Visibility="{Binding ShowRouterRow, Converter={StaticResource Vis}}">
                                                <Button Content="{Binding Router.ToggleText}" Command="{Binding Router.ToggleCmd}" Style="{StaticResource Small}" ToolTip="{Binding Router.MethodsTip}"
                                                        ToolTipService.ShowOnDisabled="True" Visibility="{Binding ShowRouterToggle, Converter={StaticResource Vis}}" />
                                                <Button Content="{Binding Router.ReEnableText}" Command="{Binding Router.ReEnableCmd}" Style="{StaticResource Small}"
                                                        Visibility="{Binding ShowRouterReEnable, Converter={StaticResource Vis}}" />
                                                <Button Content="{l:T home.check_router}" Command="{Binding Router.CheckCmd}" Style="{StaticResource Small}" ToolTip="{Binding Router.MethodsTip}"
                                                        ToolTipService.ShowOnDisabled="True" Visibility="{Binding ShowRouterCheck, Converter={StaticResource Vis}}" />
                                                <Button Content="{l:T home.find_on_router}" Command="{Binding Router.GoSelectCmd}" Style="{StaticResource Small}" ToolTip="{Binding Router.MethodsTip}"
                                                        ToolTipService.ShowOnDisabled="True" Visibility="{Binding ShowRouterSelect, Converter={StaticResource Vis}}" />
                                                <Button Content="{l:T router.login}" Command="{Binding Router.LoginCmd}" Style="{StaticResource Small}"
                                                        Visibility="{Binding ShowRouterLogin, Converter={StaticResource Vis}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Второстепенное — внизу карточки: «Проверить сейчас», ссылки, «Сайт не открывается?» → «Проверить сайт». -->
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,10,20,12">
                                        <StackPanel>
                                            <WrapPanel>
                                                <Button Command="{Binding CheckNowCmd}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource HomeIcon.ArrowClockwise}" Fill="{DynamicResource Text}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{l:T home.check_now}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- Не открылось — путь на экран «Подбор» прямо здесь (UX-аудит 7, п. 3). -->
                                                <Button Content="{Binding RetrySelectText}" Style="{StaticResource LinkButton}" Command="{Binding GoSelectCmd}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                        ToolTip="{l:T home.retry_select.tip}" />
                                                <Button Content="{Binding StrategiesLinkText}" Style="{StaticResource LinkButton}" Command="{Binding ToggleStrategiesCmd}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{l:T home.site_fix}" Style="{StaticResource LinkButton}" Command="{Binding ToggleDirectCmd}" Margin="0,0,4,0"
                                                            Visibility="{Binding ShowSiteFix, Converter={StaticResource Vis}}" />
                                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Home}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </WrapPanel>
                                            <!-- «Проверить сайт» (п. 15, решение владельца): поле и «Проверить»; итог строкой; сломала оптимизация — «Добавить в исключения». -->
                                            <StackPanel Margin="0,10,0,0" Visibility="{Binding DirectOpen, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{l:T home.sitecheck.title}" FontWeight="SemiBold" FontSize="13" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <TextBox Text="{Binding DirectSite, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" Width="260" Padding="6,4" VerticalAlignment="Center" Margin="0,0,8,4"
                                                             ToolTip="{l:T home.direct.site.tip}" AutomationProperties.Name="{l:T home.direct.site.aria}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Enter" Command="{Binding SiteCheckCmd}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <Button Content="{l:T home.sitecheck.button}" Command="{Binding SiteCheckCmd}" Margin="0,0,0,4" VerticalAlignment="Center" />
                                                </WrapPanel>
                                                <DockPanel Margin="0,4,0,0" Visibility="{Binding HasSiteCheckLine, Converter={StaticResource Vis}}">
                                                    <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="{l:T home.sitecheck.add}" Command="{Binding OpenDirectCmd}" Style="{StaticResource Small}"
                                                            Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowAddExclude, Converter={StaticResource Vis}}" />
                                                    <!-- Режим «Только из списков», сайта в них нет — «Добавить в список оптимизации» (свои сайты ПК / список роутера), затем перепроверка. -->
                                                    <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="{l:T home.sitecheck.add_list}" Command="{Binding AddToListCmd}" Style="{StaticResource Small}"
                                                            Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowAddToList, Converter={StaticResource Vis}}" />
                                                    <ContentControl Content="{Binding SiteCheckHealth}" ContentTemplate="{StaticResource HealthIcon}" VerticalAlignment="Center" Margin="0,0,8,0" Focusable="False" />
                                                    <TextBlock Text="{Binding SiteCheckLine}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </StackPanel>
                                            <TextBox Text="{Binding DirectMessage, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,6,0,0"
                                                     Visibility="{Binding HasDirectMessage, Converter={StaticResource Vis}}" />
                                            <!-- «Проверить снова» (аудит С-16): тот же сайт ещё раз — после добавления в список, в исключения или просто повторно. -->
                                            <Button Content="{l:T home.sitecheck.again}" Style="{StaticResource LinkButton}" Command="{Binding SiteAgainCmd}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    Visibility="{Binding ShowSiteAgain, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- «Показать стратегии»: сразу под карточкой — раскрытый список виден, а не уходит за край окна (UX-аудит 2, п. 2). -->
                            <StackPanel x:Name="StrategiesBlock" Visibility="{Binding ShowStrategies, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding StrategyHeader}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding StrategyHeader}" />
                                <WrapPanel Margin="0,0,0,6" AutomationProperties.Name="{l:T home.order.aria}">
                                    <TextBlock Text="{l:T home.order.label}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <RadioButton Content="{l:T home.order.by_result}" IsChecked="{Binding SortByResult}" Margin="0,0,14,0" ToolTip="{l:T home.order.by_result.tip}" />
                                    <RadioButton Content="{l:T home.order.by_name}" IsChecked="{Binding SortByName}" ToolTip="{l:T home.order.by_name.tip}" />
                                </WrapPanel>
                                <!-- Список недоступен — сказать почему, а не просто посерить (UX-аудит 6, п. 11). -->
                                <TextBlock Text="{Binding ChooseBlockedText}" Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                           Visibility="{Binding CanChoose, Converter={StaticResource InvVis}}" />
                                <ListBox ItemsSource="{Binding StrategyChoices}" SelectedValue="{Binding ChosenStrategyId}" SelectedValuePath="Id"
                                         IsEnabled="{Binding CanChoose}" Margin="0,0,0,12" PreviewMouseWheel="PassWheelToPage" AutomationProperties.Name="{l:T home.list.aria}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Метка — в строке названия, чтобы статистика под ним шла во всю ширину. -->
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding HasLabel, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AccentText}" TextWrapping="NoWrap" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" ToolTip="{Binding Tip}" />
                                                </DockPanel>
                                                <DockPanel Margin="0,1,0,0">
                                                    <!-- Найденную на ПК — на роутер (router-api §6); видно, только если роутер подключён. -->
                                                    <Border DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding DataContext.Router.Connected, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Vis}}">
                                                        <Button Content="{l:T home.send_to_router}" Style="{StaticResource LinkButton}" FontSize="12"
                                                                Command="{Binding DataContext.Router.SendStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Id}"
                                                                Visibility="{Binding Removable, Converter={StaticResource Vis}}" ToolTip="{l:T home.send_to_router.tip}" />
                                                    </Border>
                                                    <!-- Стрелка — адреса последнего подбора (как в таблице подбора); щелчок по ней и по адресам стратегию не выбирает. -->
                                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource RowToggle}" IsChecked="{Binding Expanded}" Margin="-4,0,2,0"
                                                                  Visibility="{Binding HasDetails, Converter={StaticResource Vis}}" ToolTip="{l:T home.expand.tip}" />
                                                    <!-- «Скопировать стратегию»: строка dpishell:1:… в буфер — вставить в DpiShell у другого человека. -->
                                                    <Button DockPanel.Dock="Right" Content="{l:T home.copy}" Style="{StaticResource LinkButton}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.CopyStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding HasParams, Converter={StaticResource Vis}}" ToolTip="{l:T home.copy.tip}" />
                                                    <!-- «Параметры»: роли и командная строка winws — щелчок стратегию не выбирает. -->
                                                    <Button DockPanel.Dock="Right" Content="{Binding ParamsLinkText}" Style="{StaticResource LinkButton}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ToggleParamsCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding HasParams, Converter={StaticResource Vis}}" ToolTip="{l:T home.params.tip}" />
                                                    <TextBlock Text="{Binding Stats}" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Danger}" FontSize="13" Margin="0,1,0,0"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource Vis}}" />
                                                <Border Background="Transparent" Margin="18,4,0,4" MouseLeftButtonDown="KeepSelection"
                                                        Visibility="{Binding Expanded, Converter={StaticResource Vis}}">
                                                    <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource VerdictRow}" />
                                                </Border>
                                                <StackPanel Margin="0,4,0,4" Background="Transparent" MouseLeftButtonDown="KeepSelection" Visibility="{Binding ParamsVisible, Converter={StaticResource Vis}}">
                                                    <!-- Невысокий блок с прокруткой: параметры длинные и иначе растягивают список стратегий. -->
                                                    <TextBox Text="{Binding Params, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="6,4" AutomationProperties.Name="{l:T home.params.aria}"
                                                             MaxHeight="130" VerticalScrollBarVisibility="Auto" />
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <Button Content="{l:T home.params.copy}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,0,12,0"
                                                                Command="{Binding DataContext.CopyParamsCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                        <Button Content="{Binding EditText}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,0,12,0"
                                                                Command="{Binding DataContext.EditStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                                ToolTip="{Binding EditTip}" />
                                                        <Button Content="{l:T home.delete}" Style="{StaticResource LinkButton}" FontSize="12"
                                                                Command="{Binding DataContext.DeleteStrategyCmd, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding Removable, Converter={StaticResource Vis}}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Плитки сайтов: YouTube, Discord, «Свои сайты»; четвёртая — когда проверено и «Подробнее» (строки по адресам). -->
                            <Grid Margin="0,0,0,12" Visibility="{Binding ShowTiles, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource SiteTileTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Grid Grid.Column="1" MinHeight="72">
                                    <Rectangle Stroke="{DynamicResource ButtonLine}" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="8" RadiusY="8" />
                                    <StackPanel Margin="14,10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TilesMeta}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" />
                                        <Button Content="{l:T common.more}" Style="{StaticResource LinkButton}" Command="{Binding ToggleCheckDetailsCmd}" HorizontalAlignment="Left" Margin="-4,2,0,0"
                                                Visibility="{Binding HasCheckDetails, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <!-- «Подробнее» у плиток: ⚠ про браузер и строки проверки по адресам (как было в карточке). -->
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" Visibility="{Binding ShowCheckDetails, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,6" Visibility="{Binding HasBrowserWarning, Converter={StaticResource Vis}}">
                                        <TextBox Text="{Binding BrowserWarning, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding CheckRows}" ItemTemplate="{StaticResource VerdictRow}" />
                                </StackPanel>
                            </Border>

                            <!-- Панель на месте плиток: «Этот ПК: …» / «Роутер: …», пункты ✓ / ! / ✗ с кнопкой исправления; «← К сайтам» возвращает плитки. -->
                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12" Visibility="{Binding ShowPanel, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Style="{StaticResource LinkButton}" Command="{Binding ClosePanelCmd}" FontSize="14" Margin="-4,0,12,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="{l:T home.panel.back}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource HomeIcon.ArrowLeft}" Fill="{DynamicResource AccentText}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{l:T home.panel.back}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding PanelTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PanelItems}" ItemTemplate="{StaticResource HealthRow}" Focusable="False" />
                                </StackPanel>
                            </Border>

                            <!-- «Проверяется само»: что программа проверяет сама и как часто; две колонки, длинное переносится во второй. -->
                            <Border Style="{StaticResource Card}" Padding="18,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="{StaticResource HomeIcon.ArrowClockwise}" Fill="{DynamicResource AccentText}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:T home.auto.title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding AutoRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" FontSize="13" Margin="0,0,16,0" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Подбор ===== -->
                <TabItem Header="{l:T common.nav.select}" AutomationProperties.Name="{l:T common.nav.select}" local:Nav.Icon="{StaticResource Ic.wand}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <!-- Где подбирать — только когда роутер подключён (router-api §6). -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" DataContext="{Binding Router}"
                                        Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <TextBlock Text="{l:T select.where.label}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <RadioButton Content="{l:T select.where.pc}" IsChecked="{Binding SelectOnPc}" Margin="0,0,16,0" IsEnabled="{Binding CanConnect}" />
                                <RadioButton Content="{l:T select.where.router}" IsChecked="{Binding SelectOnRouter}" IsEnabled="{Binding CanConnect}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="{l:T select.title}" Style="{StaticResource H1}" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.Select}" Margin="10,0,0,12" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T select.groups.title}" Style="{StaticResource H2}" />
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{l:T select.mode.title}" Style="{StaticResource H2}" />
                                <RadioButton IsChecked="{Binding Full}" Margin="0,3">
                                    <TextBlock><Run Text="{l:T select.mode.full}" /><Run Text="{l:T select.mode.full_hint}" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </RadioButton>
                                <RadioButton IsChecked="{Binding Quick}" Margin="0,3">
                                    <TextBlock><Run Text="{l:T select.mode.quick}" /><Run Text="{l:T select.mode.quick_hint}" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </RadioButton>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Visibility="{Binding Router.SelectOnPcVisible, Converter={StaticResource Vis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <!-- Порядок таблицы — в той же строке, что и кнопки подбора: отдельная строка съедала место у таблицы. -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,8" AutomationProperties.Name="{l:T select.order.aria}">
                                    <TextBlock Text="{l:T select.order.label}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <RadioButton Content="{l:T select.order.by_result}" IsChecked="{Binding SortByResult}" Margin="0,0,14,0" />
                                    <RadioButton Content="{l:T select.order.by_name}" IsChecked="{Binding SortByName}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button ContentTemplate="{StaticResource Shield}" Content="{l:T select.start}" Style="{StaticResource Primary}" Command="{Binding StartSelectCmd}" />
                                    <Button Content="{l:T select.stop}" Command="{Binding StopSelectCmd}" />
                                </WrapPanel>
                            </DockPanel>
                            <!-- Ход — только во время подбора: пустая полоса без подбора выглядела незавершённой операцией. -->
                            <StackPanel Visibility="{Binding Selecting, Converter={StaticResource Vis}}">
                                <ProgressBar Height="8" Maximum="{Binding SelectProgressMax}" Value="{Binding SelectProgress, Mode=OneWay}" IsIndeterminate="{Binding SelectIndeterminate}" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding SelectProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Лучшая включена — итог одной строкой, «Подробнее» возвращает карточку. -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,8" Visibility="{Binding ResultCompact, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T common.more}" Style="{StaticResource LinkButton}" Command="{Binding ShowResultDetailsCmd}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding AddressNote}" ToolTip="{Binding AddressNote}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding HasAddressNote, Converter={StaticResource Vis}}" /></StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8" Visibility="{Binding ResultFull, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <!-- «Применить» — всегда главная кнопка карточки; уже работает — словами вместо кнопки (UX-аудит 6, п. 8). -->
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{l:T select.apply}" Style="{StaticResource Primary}" Command="{Binding ApplyBestCmd}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasBest, Converter={StaticResource Vis}}" />
                                <TextBlock DockPanel.Dock="Right" Text="{l:T select.already}" FontWeight="SemiBold" Foreground="{DynamicResource Ok}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding ResultApplied, Converter={StaticResource Vis}}" />
                                <!-- Глубокий поиск — одной кнопкой справа, а не отдельной строкой: таблице остаётся высота. -->
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{l:T select.deep}" Command="{Binding StartSearchCmd}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding OfferDeep, Converter={StaticResource Vis}}"
                                        ToolTip="{l:T select.deep.tip}" />
                                <!-- Вставленная или собранная руками стратегия: проверка сайтов только для неё. -->
                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{l:T select.check}" Style="{StaticResource Primary}" Command="{Binding CheckStrategyCmd}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasPendingCheck, Converter={StaticResource Vis}}"
                                        ToolTip="{l:T select.check.tip}" />
                                <StackPanel>
                                    <TextBox Text="{Binding ResultText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="16" FontWeight="SemiBold" ToolTip="{Binding ResultTip}" />
                                    <TextBox Text="{Binding ResultHint, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,4,0,0" /><TextBox Text="{Binding AddressNote, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,4,0,0" Visibility="{Binding HasAddressNote, Converter={StaticResource Vis}}" />
                                    <!-- Глубокий поиск — только когда готовые не помогли со всем (UX-аудит, п. 30); фраза — цифрой, что не открылось (UX-аудит 6, п. 9). -->
                                    <TextBlock Text="{Binding DeepText}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding OfferDeep, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding Scores}" SelectedItem="{Binding SelectedScore}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
                                  RowHeaderWidth="0" MinHeight="120" ScrollViewer.CanContentScroll="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="DetailsVisibility" Value="{Binding Expanded, Converter={StaticResource Vis}}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="38,0,12,10">
                                        <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource VerdictRow}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource RowToggle}" IsChecked="{Binding Expanded, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasDetails, Converter={StaticResource Vis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T select.col.strategy}" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Метки справа и целиком, обрезается название (в StackPanel метка уезжала за край).
                                                 «лучшая» — словом, как «найдена»: значок звезды в таблице читался непонятным символом. -->
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,4,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasLabel, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                </Border>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsBest, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{l:T select.best_mark}" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                </Border>
                                                <!-- Не обрезается: длинная смешанная переносится, состав — в подсказке. -->
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding Tip}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T select.col.services}" Binding="{Binding Groups}" Width="70" />
                                <DataGridTextColumn Header="{l:T select.col.addresses}" Binding="{Binding Share}" Width="90" />
                                <DataGridTextColumn Header="{l:T select.col.time}" Binding="{Binding Avg}" Width="80" />
                                <DataGridTemplateColumn Header="{l:T select.col.problem}" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ErrorShown}" ToolTip="{Binding ErrorFull}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ErrorIsProblem}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Выбранная строка: применить или своё (скопировать, изменить, проверить только её). «Вставить» — второстепенная ссылка:
                             строка DpiShell или запуск winws из .bat Flowseal, сначала проверка, потом «Применить». -->
                        <DockPanel Grid.Row="3" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="{l:T select.paste}" Style="{StaticResource LinkButton}" FontSize="13" Margin="8,0,0,8" VerticalAlignment="Top"
                                    Command="{Binding PasteStrategyCmd}" ToolTip="{l:T select.paste.tip}" />
                            <WrapPanel>
                                <Button ContentTemplate="{StaticResource Shield}" Content="{Binding ApplySelectedText}" Command="{Binding ApplySelectedCmd}" ToolTip="{l:T select.apply_selected.tip}" />
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Center" Visibility="{Binding HasSelectedScore, Converter={StaticResource Vis}}">
                                    <Button Content="{l:T select.copy}" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,10,0" Command="{Binding CopyStrategyCmd}" CommandParameter="{Binding SelectedScore}" />
                                    <Button Content="{Binding SelectedScore.EditText}" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,10,0" Command="{Binding EditStrategyCmd}" CommandParameter="{Binding SelectedScore}" />
                                    <Button Content="{l:T select.check_one}" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding CheckStrategyCmd}" CommandParameter="{Binding SelectedScore}" />
                                </StackPanel>
                            </WrapPanel>
                        </DockPanel>
                        </Grid>

                        <!-- Подбор на роутере: группы и режим — те же, ход — select_progress, итог — «Применить на роутере». -->
                        <Grid Grid.Row="2" DataContext="{Binding Router}" Visibility="{Binding SelectOnRouterVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,8" AutomationProperties.Name="{l:T select.order.aria}">
                                        <TextBlock Text="{l:T select.order.label}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <RadioButton Content="{l:T select.order.by_result}" IsChecked="{Binding SortByResult}" Margin="0,0,14,0" />
                                        <RadioButton Content="{l:T select.order.by_name}" IsChecked="{Binding SortByName}" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Content="{l:T select.router.start}" Style="{StaticResource Primary}" Command="{Binding StartSelectCmd}" />
                                        <Button Content="{l:T select.stop}" Command="{Binding StopSelectCmd}" />
                                    </WrapPanel>
                                </DockPanel>
                                <TextBlock Text="{l:T select.router.note}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                <StackPanel Visibility="{Binding Selecting, Converter={StaticResource Vis}}">
                                    <ProgressBar Height="8" Maximum="{Binding SelectProgressMax}" Value="{Binding SelectProgress, Mode=OneWay}" Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding SelectProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,8" Visibility="{Binding ResultCompact, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:T common.more}" Style="{StaticResource LinkButton}" Command="{Binding ShowResultDetailsCmd}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding AddressNote}" ToolTip="{Binding AddressNote}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding HasAddressNote, Converter={StaticResource Vis}}" /></StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="{Binding ResultFull, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:T select.router.apply}" Style="{StaticResource Primary}" Command="{Binding ApplyCmd}"
                                            VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasBest, Converter={StaticResource Vis}}" />
                                    <StackPanel>
                                        <TextBox Text="{Binding ResultText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding ResultHint, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,4,0,0" /><TextBox Text="{Binding AddressNote, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,4,0,0" Visibility="{Binding HasAddressNote, Converter={StaticResource Vis}}" />
                                        <Button Content="{l:T select.deep}" Command="{Binding StartDeepCmd}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                Visibility="{Binding OfferDeep, Converter={StaticResource Vis}}" ToolTip="{l:T select.router.deep.tip}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Scores}" SelectedItem="{Binding SelectedScore}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
                                      RowHeaderWidth="0" MinHeight="120" ScrollViewer.CanContentScroll="False">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="DetailsVisibility" Value="{Binding Expanded, Converter={StaticResource Vis}}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="38,0,12,10">
                                            <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource VerdictRow}" />
                                            <TextBlock Text="{Binding NoDetailsHint}" Style="{StaticResource Hint}" FontSize="13" Visibility="{Binding NoDetails, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="30" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource RowToggle}" IsChecked="{Binding Expanded, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding CanExpand, Converter={StaticResource Vis}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{l:T select.col.strategy}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Вариант глубокого поиска — с пометкой справа: применить его нельзя, найденное в конце попадёт в стратегии роутера. -->
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource Hint}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsBest, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{l:T select.best_mark}" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T select.col.services}" Binding="{Binding Groups}" Width="70" />
                                    <DataGridTextColumn Header="{l:T select.col.addresses}" Binding="{Binding Share}" Width="90" />
                                    <DataGridTextColumn Header="{l:T select.col.time}" Binding="{Binding Avg}" Width="80" />
                                    <DataGridTemplateColumn Header="{l:T select.col.problem}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ErrorShown}" ToolTip="{Binding Error}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ErrorIsProblem}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button Content="{Binding ApplySelectedText}" Command="{Binding ApplySelectedCmd}" />
                                <TextBlock Text="{l:T select.router.best_note}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Сайты: свои сайты, исключения, «Сайт не открывается», «Для каких сайтов обход» (последние три — только для роутера). ===== -->
                <TabItem Header="{l:T common.nav.sites}" AutomationProperties.Name="{l:T common.nav.sites}" local:Nav.Icon="{StaticResource Ic.globe}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <!-- Вкладки «На этом ПК» / «На роутере» — только когда роутер подключён. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" DataContext="{Binding Router}"
                                        Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <RadioButton Content="{l:T sites.target.pc}" IsChecked="{Binding TargetsOnPc}" Margin="0,0,16,0" />
                                <RadioButton Content="{l:T sites.target.router}" IsChecked="{Binding TargetsOnRouter}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="{l:T sites.title}" Style="{StaticResource H1}" />
                                <local:InfoButton Topic="{x:Static local:InfoTexts.Sites}" Margin="10,0,0,12" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Grid.RowSpan="3" Visibility="{Binding Router.TargetsOnPcVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,10">
                            <DockPanel Margin="0,4,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <TextBlock Text="{l:T sites.builtin_lists}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.DomainLists}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T sites.my.title}" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                               Text="{l:T sites.my.hint}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBox Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AutomationProperties.Name="{l:T sites.my.title}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Height="150"
                                     FontFamily="Consolas" FontSize="14" Padding="8" />
                            <!-- Простой список исключений ПК (UX-аудит 7, п. 5): сюда же сайт попадает с Главной по «Сайт не открывается?». Строки «Напрямую» продвинутого режима — отдельно. -->
                            <TextBlock Text="{l:T sites.exclude.title}" Style="{StaticResource H2}" Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,2" Text="{l:T sites.exclude.caption}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="{l:T sites.exclude.hint}" />
                            <TextBox Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AutomationProperties.Name="{l:T sites.exclude.title}" local:Demo.Sensitive="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Height="100"
                                     FontFamily="Consolas" FontSize="14" Padding="8" />
                            <TextBox Text="{Binding ExcludeMessage, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,4,0,0" />
                            <!-- Продвинутый режим «сайты → стратегия» — после «Своих сайтов» и «Исключений» (аудит перед бетой, С-17): выключен по умолчанию (docs/research/mixed-strategies.md §6). -->
                            <local:AdvancedView DataContext="{Binding AdvancedPc}" Margin="0,14,0,0" />
                            </StackPanel>
                            </ScrollViewer>
                            <!-- Одна кнопка и один статус на вкладку (UX-аудит 6, п. 2): сохраняет и свои сайты, и строки «Свои настройки для сайтов». -->
                            <Border Grid.Row="1" Margin="0,4,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="{l:T sites.save}" Style="{StaticResource Primary}" Command="{Binding SaveSitesCmd}" VerticalAlignment="Top" />
                                    <!-- Несохранённое видно (UX-аудит 2, п. 15): подбор берёт сохранённое; при уходе с вкладки и перед подбором свои сайты сохраняются сами. -->
                                    <TextBlock DockPanel.Dock="Left" Text="{l:T sites.dirty}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,8"
                                               Visibility="{Binding SitesDirty, Converter={StaticResource Vis}}" ToolTip="{l:T sites.dirty.tip}" />
                                    <TextBlock DockPanel.Dock="Left" Text="{l:T sites.saved}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,8,8"
                                               Visibility="{Binding SitesSaved, Converter={StaticResource Vis}}" />
                                    <TextBox Text="{Binding TargetsMessage, Mode=OneWay}" Style="{StaticResource SelectableHint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Свои сайты и списки роутера (targets_get/set, lists_get/set): с ПК не синхронизируются сами. -->
                        <Grid Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Router}" Visibility="{Binding TargetsOnRouterVisible, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <!-- «Сайт не открывается»: site_check с обходом и без, итог — site_check_result. Сайт сломался — сразу в исключения (там же, ниже). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:T sites.check.title}" Style="{StaticResource H2}" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.SiteCheck}" Margin="8,0,0,8" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" Width="280" Padding="6,4" VerticalAlignment="Center"
                                                 ToolTip="{l:T sites.check.url_tip}" AutomationProperties.Name="{l:T sites.check.url_name}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SiteCheckCmd}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Content="{l:T sites.check.button}" Command="{Binding SiteCheckCmd}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ProgressBar Height="4" IsIndeterminate="{Binding SiteChecking}" Margin="0,8,0,0" Width="280" HorizontalAlignment="Left"
                                                 Visibility="{Binding SiteChecking, Converter={StaticResource Vis}}" />
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSiteResult, Converter={StaticResource Vis}}">
                                        <TextBox Text="{Binding SiteResult, Mode=OneWay}" Style="{StaticResource SelectableText}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SiteHint, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,2,0,0" />
                                        <Button Content="{l:T sites.check.add_exclude}" Style="{StaticResource Primary}" Command="{Binding AddExcludeCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Visibility="{Binding SiteSuggestExclude, Converter={StaticResource Vis}}" />
                                        <!-- «Только из списков», сайта в списках роутера нет и он не открывается — в свой список user-general (как страница роутера), затем проверка заново. -->
                                        <Button Content="{l:T home.sitecheck.add_list}" Style="{StaticResource Primary}" Command="{Binding AddListCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Visibility="{Binding SiteSuggestList, Converter={StaticResource Vis}}" />
                                        <Button Content="{l:T home.sitecheck.again}" Style="{StaticResource LinkButton}" Command="{Binding SiteAgainCmd}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Visibility="{Binding ShowSiteAgain, Converter={StaticResource Vis}}" />
                                        <Expander Header="{l:T common.more}" Visibility="{Binding HasSiteDetail, Converter={StaticResource Vis}}">
                                            <TextBox Text="{Binding SiteDetail, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,4,0,0" />
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Продвинутый режим на роутере (advanced_get/advanced_set, договор §5.2): строки «сайты → стратегия», остальные адреса. -->
                            <local:AdvancedView DataContext="{Binding Advanced}" />

                            <!-- Режим: «Все сайты, кроме исключений» (по умолчанию) / «По спискам» (mode_set). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:T sites.mode.title}" Style="{StaticResource H2}" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.RouterMode}" Margin="8,0,0,8" />
                                    </StackPanel>
                                    <RadioButton Content="{l:T sites.mode.lists}" IsChecked="{Binding ModeLists}" IsEnabled="{Binding CanAct}" Margin="0,3" HorizontalAlignment="Left" />
                                    <RadioButton Content="{l:T sites.mode.all}" IsChecked="{Binding ModeAll}" IsEnabled="{Binding CanAct}" Margin="0,3,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="{l:T sites.mode.all_warn}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,3" />
                                    <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Одной карточкой: при прокрутке заголовок и подпись не обрезаются посреди текста, кнопка «Сохранить» отделена линией (UX-аудит 5, п. 25). -->
                            <Border Style="{StaticResource Card}">
                            <StackPanel>
                            <TextBlock Text="{l:T sites.my.title}" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                                       Text="{l:T sites.router.my.hint}" />
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <TextBlock Text="{l:T sites.router.targets_empty}" Style="{StaticResource Hint}" Margin="14,12"
                                               Visibility="{Binding Targets.Count, Converter={StaticResource Zero}}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6" MaxHeight="200">
                                        <ItemsControl ItemsSource="{Binding Targets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" FontFamily="Consolas" Padding="6,4" VerticalContentAlignment="Center"
                                                                 AutomationProperties.Name="{l:T sites.router.target.name}" />
                                                        <CheckBox Grid.Column="1" Content="{l:T sites.router.target.important}" IsChecked="{Binding Important}" VerticalAlignment="Center" Margin="14,0,10,0" />
                                                        <Button Grid.Column="2" Content="✕" Style="{StaticResource LinkButton}" ToolTip="{l:T sites.router.target.remove}" AutomationProperties.Name="{l:T sites.router.target.remove_name}"
                                                                Command="{Binding DataContext.RemoveTargetCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{l:T sites.router.add}" Command="{Binding AddTargetCmd}" />
                                <Button Content="{l:T sites.router.copy_from_pc}" Command="{Binding CopyFromPcCmd}" />
                            </WrapPanel>
                            </StackPanel>
                            </Border>

                            <TextBlock Text="{l:T sites.router.lists.title}" Style="{StaticResource H2}" Margin="0,14,0,0" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T sites.router.lists.general}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ListGeneralText, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" AcceptsReturn="True" Height="110"
                                             FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="{l:T sites.router.lists.general_name}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T sites.router.lists.exclude}" Style="{StaticResource Hint}" Margin="0,0,0,0" />
                                    <TextBlock Text="{l:T sites.exclude.caption}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ListExcludeText, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" AcceptsReturn="True" Height="110"
                                             FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="{l:T sites.router.lists.exclude_name}" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="1" Margin="0,4,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <WrapPanel>
                                    <Button Content="{l:T sites.router.save}" Style="{StaticResource Primary}" Command="{Binding SaveTargetsCmd}" />
                                    <TextBlock Text="{l:T sites.dirty}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,8"
                                               Visibility="{Binding SitesDirty, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{l:T sites.saved}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,8,8"
                                               Visibility="{Binding SitesSaved, Converter={StaticResource Vis}}" />
                                    <TextBox Text="{Binding TargetsMessage, Mode=OneWay}" Style="{StaticResource SelectableHint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Игры и программы: запись подключений и профили (ТЗ 13), игровой режим, IP-списки в «Дополнительно» ===== -->
                <TabItem Header="{l:T common.nav.apps}" AutomationProperties.Name="{l:T common.nav.apps}" local:Nav.Icon="{StaticResource Ic.games}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Подключения программ (ТЗ 13): простой режим «Настроить под игру», сохранённые профили, для опытных — «Отладка подключений». -->
                            <StackPanel DataContext="{Binding Apps}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T apps.title}" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Apps}" Margin="10,0,0,12" />
                                </StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:T apps.setup.title}" Style="{StaticResource H2}" />
                                        <TextBlock Text="{Binding Intro}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding ShowIntro, Converter={StaticResource Vis}}" />
                                        <TextBox Text="{Binding Status, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="{Binding HasStatus, Converter={StaticResource Vis}}" local:Demo.Sensitive="True" />
                                        <TextBlock Text="{Binding RecText}" FontFamily="Consolas" Margin="0,4,0,0" Visibility="{Binding IsRecording, Converter={StaticResource Vis}}" local:Demo.Sensitive="True" />
                                        <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,4,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" local:Demo.Sensitive="True" />
                                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,8,0,0" Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                                        <!-- Драйвер для записи — только по выбору: игры с защитой от читов могут его заметить (AppsViewModel.AdvNoDriver). -->
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowStart, Converter={StaticResource Vis}}">
                                            <CheckBox Content="{l:T apps.rec.udp}" IsChecked="{Binding WithDriver}" HorizontalAlignment="Left" />
                                            <!-- Коротко: решение «нужна мне UDP или нет» не должно тонуть в четырёх строках про драйвер (UX-аудит 7, п. 15). -->
                                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="26,2,0,0"
                                                       Text="{l:T apps.rec.udp_hint}" />
                                            <Expander Header="{l:T common.more}" Margin="22,6,0,0" FontSize="13">
                                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="4,2,0,0"
                                                           Text="{l:T apps.rec.udp_more}" />
                                            </Expander>
                                        </StackPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <!-- Профиль сохранён, а оптимизация выключена — включить тут же, не уходя на Главную (UX-аудит 7, п. 16); тогда она главная, «Настроить ещё одну игру» — обычная. -->
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{l:T apps.enable}" Style="{StaticResource Primary}" Command="{Binding EnableCmd}"
                                                    Visibility="{Binding ShowEnablePrimary, Converter={StaticResource Vis}}" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding StartText}" Style="{StaticResource Primary}" Command="{Binding StartCmd}"
                                                    Visibility="{Binding ShowStartPrimary, Converter={StaticResource Vis}}" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{Binding StartText}" Command="{Binding StartCmd}"
                                                    Visibility="{Binding ShowStartPlain, Converter={StaticResource Vis}}" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{l:T apps.rec.done}" Style="{StaticResource Primary}" Command="{Binding FinishCmd}"
                                                    Visibility="{Binding IsRecording, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T common.cancel}" Command="{Binding CancelCmd}" Visibility="{Binding IsRecording, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T apps.check.yes}" Style="{StaticResource Primary}" Command="{Binding YesCmd}" Visibility="{Binding IsCheck, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T apps.check.no}" Command="{Binding NoCmd}" Visibility="{Binding IsCheck, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T apps.check.worse}" Command="{Binding NoCmd}" Visibility="{Binding IsCheck, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T apps.more}" Style="{StaticResource LinkButton}" Command="{Binding MoreCmd}" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowMore, Converter={StaticResource Vis}}" />
                                        </WrapPanel>
                                        <Border Style="{StaticResource Warn}" Margin="0,10,0,0" Visibility="{Binding ShowOffHint, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding OffHint}" FontSize="13" TextWrapping="Wrap" />
                                        </Border>
                                        <!-- Пока ждём «Заработало?» — обычная кнопка под подсказкой «оптимизация выключена». -->
                                        <Button ContentTemplate="{StaticResource Shield}" Content="{l:T apps.enable}" Command="{Binding EnableCmd}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding ShowEnablePlain, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Предупреждение про античиты — под карточкой «Настроить под игру», а не над ней: человек пришёл не из-за античита (UX-аудит 7, п. 15). -->
                                <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                        Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Anti}" FontSize="13" TextWrapping="Wrap" />
                                </Border>

                                <Border Style="{StaticResource Card}" Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="{l:T apps.profiles.title}" Style="{StaticResource H2}" />
                                        <ItemsControl ItemsSource="{Binding Profiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="{l:T apps.profile.other_variant}" Command="{Binding NextCmd}" Margin="0,0,8,0"
                                                                    Visibility="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource Vis}}" />
                                                            <Button ContentTemplate="{StaticResource Shield}" Content="{l:T apps.profile.revert}" Command="{Binding RemoveCmd}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:Demo.Sensitive="True" />
                                                            <TextBox Text="{Binding Summary, Mode=OneWay}" Style="{StaticResource SelectableHint}" local:Demo.Sensitive="True" />
                                                            <TextBox Text="{Binding VariantLabel, Mode=OneWay}" Style="{StaticResource SelectableHint}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Отладка подключений: только если в «Настройках» включено «Показывать инструменты для опытных» (или по «Подробнее»). -->
                                <StackPanel Visibility="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{l:T apps.debug.title}" Style="{StaticResource H1}" FontSize="19" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.Debug}" Margin="10,0,0,12" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Text="{l:T apps.debug.hint}" />
                                            <RadioButton Content="{l:T apps.debug.new_processes}" IsChecked="{Binding AdvNewProcesses}" Margin="0,3,0,3" IsEnabled="{Binding AdvIdle}" />
                                            <DockPanel Margin="0,3,0,3">
                                                <Button DockPanel.Dock="Right" Content="{l:T apps.debug.refresh}" Command="{Binding RefreshProcessesCmd}" Margin="8,0,0,0" IsEnabled="{Binding AdvIdle}" />
                                                <RadioButton Content="{l:T apps.debug.selected_process}" IsChecked="{Binding AdvByProcess}" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding AdvIdle}" />
                                                <ComboBox ItemsSource="{Binding Processes}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedProcess}" IsEnabled="{Binding AdvIdle}" local:Demo.Sensitive="True"
                                                          AutomationProperties.Name="{l:T apps.debug.process_name}" />
                                            </DockPanel>
                                            <CheckBox Content="{l:T apps.debug.no_driver}" IsChecked="{Binding AdvNoDriver}" HorizontalAlignment="Left" Margin="0,6,0,0" IsEnabled="{Binding AdvIdle}"
                                                      ToolTip="{l:T apps.debug.no_driver_tip}" />
                                            <TextBlock Text="{l:T apps.debug.no_driver_hint}" Style="{StaticResource Hint}" Margin="26,2,0,0" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button ContentTemplate="{StaticResource Shield}" Content="{l:T apps.debug.record}" Style="{StaticResource Primary}" Command="{Binding AdvStartCmd}" />
                                                <Button Content="{l:T apps.debug.stop}" Command="{Binding AdvStopCmd}" />
                                                <TextBlock Text="{Binding RecText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,0,8" Visibility="{Binding AdvRecording, Converter={StaticResource Vis}}" local:Demo.Sensitive="True" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
                                        <StackPanel>
                                            <TextBlock Text="{l:T apps.debug.recorded.title}" Style="{StaticResource H2}" />
                                            <TextBox Text="{Binding RecapNote, Mode=OneWay}" Style="{StaticResource SelectableHint}" Visibility="{Binding HasRecapNote, Converter={StaticResource Vis}}" />
                                            <WrapPanel Margin="0,4,0,6">
                                                <Button Content="{l:T apps.debug.denoise}" Command="{Binding DenoiseCmd}" ToolTip="{l:T apps.debug.denoise_tip}" />
                                                <Button Content="{l:T apps.debug.check_all}" Command="{Binding CheckAllCmd}" />
                                                <Button Content="{l:T apps.debug.uncheck_all}" Command="{Binding UncheckAllCmd}" />
                                            </WrapPanel>
                                            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                                      CanUserAddRows="False" MaxHeight="280" MinHeight="90" AutomationProperties.Name="{l:T apps.debug.recorded.title}">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="" Width="32">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="{l:T apps.debug.col.process}" Binding="{Binding Process}" Width="*" ElementStyle="{StaticResource SensitiveCell}" />
                                                    <DataGridTextColumn Header="{l:T apps.debug.col.address}" Binding="{Binding Address}" Width="*" ElementStyle="{StaticResource SensitiveCell}" />
                                                    <DataGridTextColumn Header="{l:T apps.debug.col.port}" Binding="{Binding Port}" Width="60" />
                                                    <DataGridTextColumn Header="{l:T apps.debug.col.type}" Binding="{Binding Kind}" Width="48" />
                                                    <DataGridTextColumn Header="{l:T apps.debug.col.state}" Binding="{Binding State}" Width="82" />
                                                    <DataGridTextColumn Header="{l:T apps.debug.col.reason}" Binding="{Binding Reason}" Width="1.7*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T apps.debug.profile_name}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding ProfileTitle, UpdateSourceTrigger=PropertyChanged}" local:Demo.Sensitive="True" Padding="6" MaxLength="60" AutomationProperties.Name="{l:T apps.debug.profile_name}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{l:T apps.debug.variant}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                    <ComboBox ItemsSource="{Binding Variants}" DisplayMemberPath="Title" SelectedIndex="{Binding SelectedVariant}" AutomationProperties.Name="{l:T apps.debug.variant_name}" />
                                                </StackPanel>
                                            </Grid>
                                            <DockPanel Margin="0,10,0,0">
                                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="{l:T apps.debug.save_profile}" Style="{StaticResource Primary}" Command="{Binding SaveCmd}" VerticalAlignment="Top" />
                                                <TextBox Text="{Binding Preview, Mode=OneWay}" Style="{StaticResource SelectableHint}" VerticalAlignment="Center" Margin="4,0,0,8" local:Demo.Sensitive="True" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- Карточка «Отладка подключений» скрыта: намёк, где её включить (UX-аудит 5, п. 21). -->
                                <TextBlock Text="{l:T apps.debug.hidden_hint}" Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Visibility="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource InvVis}}" />
                            </StackPanel>

                            <StackPanel DataContext="{Binding Net}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T apps.game.title}" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Game}" Margin="10,0,0,12" />
                                </StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameOn}" IsEnabled="{Binding GameCanToggle}" HorizontalAlignment="Left">
                                            <TextBlock Text="{l:T apps.game.switch}" FontSize="15" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding GameStatus}" Margin="50,6,0,0" />
                                        <TextBlock Text="{Binding GameHint}" Style="{StaticResource Hint}" Margin="50,2,0,0" />
                                        <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                                Padding="10,6" Margin="50,10,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{l:T apps.game.warn}" FontSize="13" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- IP-списки и свои подсети правят редко: профиль под программу заполняет их сам. Идут «Все адреса» — раскрыто, чтобы отсчёт был виден. -->
                                <Expander Header="{l:T apps.more_tools}" IsExpanded="{Binding ListsOpen, Mode=TwoWay}">
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{l:T apps.ipset.title}" Style="{StaticResource H1}" FontSize="19" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.IpLists}" Margin="10,0,0,12" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <!-- «Выкл» выключает и игровой режим (Shell.SetIpsetMode): без списка ему нечего ловить — так и сказано. -->
                                                <TextBlock Text="{l:T apps.ipset.mode_caption}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                <WrapPanel IsEnabled="{Binding CanEdit}">
                                                    <RadioButton Content="{l:T apps.ipset.off}" IsChecked="{Binding IpsetOff}" Margin="0,3,24,3" />
                                                    <RadioButton Content="{l:T apps.ipset.lists}" IsChecked="{Binding IpsetList}" Margin="0,3,24,3" />
                                                </WrapPanel>
                                                <!-- «Все адреса» — проверка с подтверждением, а не третий режим наравне с рабочими (UX-аудит, п. 34). -->
                                                <Button ContentTemplate="{StaticResource Shield}" Content="{l:T apps.ipset.try_any}" Command="{Binding TryAnyCmd}" HorizontalAlignment="Left"
                                                        Margin="0,8,0,0" ToolTip="{l:T apps.ipset.try_any_tip}"
                                                        Visibility="{Binding AnyActive, Converter={StaticResource InvVis}}" IsEnabled="{Binding CanEdit}" />
                                                <Border Style="{StaticResource Warn}" Margin="0,10,0,0" Visibility="{Binding AnyActive, Converter={StaticResource Vis}}">
                                                    <DockPanel>
                                                        <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{l:T apps.ipset.stop_any}" Command="{Binding StopAnyCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding AnyText}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{l:T apps.ipset.any_warn}" FontSize="13" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T apps.ipset.list_caption}" Style="{StaticResource Hint}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding ListText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                                        <TextBox Text="{Binding UpdateNote, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" FontSize="13" Margin="0,4,0,0"
                                                                   Visibility="{Binding HasUpdateNote, Converter={StaticResource Vis}}" />
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Button ContentTemplate="{StaticResource Shield}" Content="{l:T apps.ipset.update}" Command="{Binding UpdateListCmd}" />
                                                            <Button ContentTemplate="{StaticResource Shield}" Content="{l:T apps.ipset.load_file}" Command="{Binding LoadFileCmd}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{l:T apps.subnets.title}" Style="{StaticResource H2}" />
                                                <TextBlock Text="{Binding UserHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T apps.subnets.add_label}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                        <TextBox Text="{Binding UserText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" local:Demo.Sensitive="True"
                                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="{l:T apps.subnets.add_label}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{l:T apps.subnets.exclude_label}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                        <TextBox Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" local:Demo.Sensitive="True"
                                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6" TextWrapping="NoWrap" AutomationProperties.Name="{l:T apps.subnets.exclude_label}" />
                                                    </StackPanel>
                                                </Grid>
                                                <DockPanel Margin="0,10,0,0">
                                                    <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="{l:T apps.subnets.save}" Style="{StaticResource Primary}" Command="{Binding SaveUserCmd}" VerticalAlignment="Top" />
                                                    <TextBox Text="{Binding UserMessage, Mode=OneWay}" Style="{StaticResource SelectableHint}" VerticalAlignment="Center" Margin="4,0,0,8" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Сеть: DNS → Прокси → Починить адреса — сворачиваемые блоки (по умолчанию свёрнуты); в заголовке — значок и строка состояния.
                     Содержимое блоков — прежние вкладки «DNS», «Прокси», «Починить адреса». ===== -->
                <TabItem Header="{l:T common.nav.net}" AutomationProperties.Name="{l:T common.nav.net}" local:Nav.Icon="{StaticResource Ic.network_check}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="{Binding NetToggleAllText}" Style="{StaticResource LinkButton}" Command="{Binding NetToggleAllCmd}" VerticalAlignment="Top" />
                                <TextBlock Text="{l:T common.nav.net}" Style="{StaticResource H1}" />
                            </DockPanel>
                            <TextBlock Text="{l:T net.intro}" Style="{StaticResource Hint}" Margin="0,-6,0,6" />

                            <Expander x:Name="NetDnsBlock" Style="{StaticResource NetBlock}" IsExpanded="{Binding DnsBlockOpen}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource Ic.server}" Fill="{DynamicResource AccentText}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="{l:T common.nav.dns}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <local:InfoButton Grid.Column="2" Topic="{x:Static local:InfoTexts.Dns}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding NetDnsStatus}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{Binding NetDnsStatus}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>

                                    <!-- DNS — один экран: вывод проверки, выбор DNS этого компьютера, таблица — в «Подробнее». -->
                                    <Border x:Name="PcDnsCard" Style="{StaticResource Inset}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="{l:T dns.check}" Style="{StaticResource LinkButton}" Command="{Binding CheckDnsCmd}" VerticalAlignment="Top" Margin="12,0,0,0" />
        <TextBlock Text="{Binding DnsSummary}" />
        </DockPanel>
                                            <Expander Header="{l:T dns.details}" Style="{StaticResource SubBlock}" IsExpanded="{Binding DnsDetailsOpen}" Visibility="{Binding DnsRows.Count, Converter={StaticResource NonZero}}">
                                                <StackPanel Margin="0,6,0,0">
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{l:T dns.col.site}" Style="{StaticResource Hint}" />
                                                        <TextBlock Grid.Column="1" Text="{l:T dns.col.system}" Style="{StaticResource Hint}" />
                                                        <TextBlock Grid.Column="2" Text="{l:T dns.col.secure}" Style="{StaticResource Hint}" />
                                                        <TextBlock Grid.Column="3" Text="{l:T dns.col.spoofed}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding DnsRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="120" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Host}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding System}" local:Demo.Sensitive="True" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding System}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Doh}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Doh}" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding Mark}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                               Text="{l:T dns.details.note}" />
                                                </StackPanel>
                                            </Expander>
                                            <!-- DNS этого компьютера (architecture.md «DNS этого компьютера»): вариант в один клик, «Вернуть как было». -->
                                            <Border x:Name="PcDnsPicker" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{l:T dns.pc.title}" Style="{StaticResource H2}" />
                                                    <local:DnsPickerView DataContext="{Binding PcDns}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Роутер подключён — DNS для всей сети настраивается там; блок не дублируем. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding Router.Connected, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{l:T dns.router_note}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        <Button Content="{l:T dns.open}" Style="{StaticResource LinkButton}" Command="{Binding GoRouterCmd}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="NetProxyBlock" Style="{StaticResource NetBlock}" IsExpanded="{Binding ProxyBlockOpen}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource Ic.arrow_routing}" Fill="{DynamicResource AccentText}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="{l:T common.nav.proxy}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <local:InfoButton Grid.Column="2" Topic="{x:Static local:InfoTexts.Proxy}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding NetProxyStatus}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{Binding NetProxyStatus}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
        <Button Content="{l:T proxy.refresh}" Style="{StaticResource LinkButton}" Command="{Binding Proxy.RefreshCmd}" HorizontalAlignment="Right" Margin="0,0,0,4" />

                                    <!-- Что стоит сейчас в Windows: пользователь, машина, службы (WinHTTP). Адреса — чувствительные. -->
                                    <Border x:Name="ProxyNowCard" Style="{StaticResource Inset}" DataContext="{Binding Proxy}">
                                        <StackPanel>
                                            <TextBlock Text="{l:T proxy.now.title}" Style="{StaticResource H2}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{l:T proxy.for_user}" Style="{StaticResource Hint}" Margin="0,2" />
                                                <TextBox Grid.Column="1" Text="{Binding UserLine, Mode=OneWay}" Style="{StaticResource SelectableText}" local:Demo.Sensitive="True" Margin="0,2" />
                                                <TextBlock Grid.Row="1" Text="{l:T proxy.for_machine}" Style="{StaticResource Hint}" Margin="0,2" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MachineLine, Mode=OneWay}" Style="{StaticResource SelectableText}" local:Demo.Sensitive="True" Margin="0,2" />
                                                <TextBlock Grid.Row="2" Text="{l:T proxy.for_services}" Style="{StaticResource Hint}" Margin="0,2" ToolTip="{l:T proxy.for_services.tip}" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WinHttpLine, Mode=OneWay}" Style="{StaticResource SelectableText}" local:Demo.Sensitive="True" Margin="0,2" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Свои прокси: список, «Проверить», форма добавления/изменения. -->
                                    <Border x:Name="ProxyListCard" Style="{StaticResource Inset}" DataContext="{Binding Proxy}">
                                        <StackPanel>
                                            <TextBlock Text="{l:T proxy.list.title}" Style="{StaticResource H2}" />
                                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ListEmpty, Converter={StaticResource Vis}}"
                                                       Text="{l:T proxy.list.empty}" />
                                            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="0,0,0,8" PreviewMouseWheel="PassWheelToPage"
                                                     AutomationProperties.Name="{l:T proxy.list.title}" Visibility="{Binding ListEmpty, Converter={StaticResource InvVis}}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Address}" local:Demo.Sensitive="True" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" local:Demo.Sensitive="True" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" local:Demo.Sensitive="True"
                                                                       Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <Expander Header="{l:T proxy.form.title}" Style="{StaticResource SubBlock}">
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" MaxWidth="420" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{l:T proxy.form.name}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" local:Demo.Sensitive="True" AutomationProperties.Name="{l:T proxy.form.name_field}" />
                                                    <TextBlock Grid.Row="1" Text="{l:T proxy.form.server}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditServer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" local:Demo.Sensitive="True"
                                                             ToolTip="{l:T proxy.form.server.tip}" AutomationProperties.Name="{l:T proxy.form.server_field}" />
                                                    <TextBlock Grid.Row="2" Text="{l:T proxy.form.bypass}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditBypass, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" local:Demo.Sensitive="True"
                                                             ToolTip="{l:T proxy.form.bypass.tip}" AutomationProperties.Name="{l:T proxy.form.bypass_field}" />
                                                    <TextBlock Grid.Row="3" Text="{l:T proxy.form.pac}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditPac, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" local:Demo.Sensitive="True"
                                                             ToolTip="{l:T proxy.form.pac.tip}" AutomationProperties.Name="{l:T proxy.form.pac_field}" />
                                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FormError, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" Margin="0,0,0,6"
                                                             Visibility="{Binding HasFormError, Converter={StaticResource Vis}}" />
                                                    <WrapPanel Grid.Row="5" Grid.Column="1">
                                                        <Button Content="{l:T proxy.form.add}" Style="{DynamicResource Small}" Command="{Binding AddCmd}" Margin="0,0,8,0" />
                                                        <Button Content="{l:T proxy.form.save}" Style="{DynamicResource Small}" Command="{Binding SaveCmd}" Margin="0,0,8,0" Visibility="{Binding IsSelected, Converter={StaticResource Vis}}" />
                                                        <Button Content="{l:T proxy.form.delete}" Style="{DynamicResource Small}" Command="{Binding DeleteCmd}" Margin="0,0,8,0" Visibility="{Binding IsSelected, Converter={StaticResource Vis}}" />
                                                        <Button Content="{l:T proxy.form.clear}" Style="{StaticResource LinkButton}" Command="{Binding ClearFormCmd}" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Expander>
                                        </StackPanel>
                                    </Border>

                                    <!-- Применить выбранный: куда, «Включить», «Очистить», «Вернуть прежний», «Проверить». -->
                                    <Border x:Name="ProxyApplyCard" Style="{StaticResource Inset}" DataContext="{Binding Proxy}">
                                        <StackPanel>
                                            <TextBlock Text="{l:T proxy.apply.title}" Style="{StaticResource H2}" />
                                            <StackPanel Margin="0,0,0,6">
                                                <RadioButton Content="{l:T proxy.for_user}" IsChecked="{Binding TargetUser}" Margin="0,0,0,4" ToolTip="{l:T proxy.for_user.tip}" />
                                                <RadioButton Content="{l:T proxy.for_user_admin}" IsChecked="{Binding TargetUserAdmin}" Margin="0,0,0,4" ToolTip="{l:T proxy.for_user_admin.tip}" />
                                                <RadioButton Content="{l:T proxy.for_machine_admin}" IsChecked="{Binding TargetMachine}" ToolTip="{l:T proxy.for_machine_admin.tip}" />
                                            </StackPanel>
                                            <CheckBox Content="{l:T proxy.also_winhttp}" IsChecked="{Binding AlsoWinHttp}" Margin="0,0,0,8"
                                                      Visibility="{Binding TargetMachine, Converter={StaticResource Vis}}"
                                                      ToolTip="{l:T proxy.also_winhttp.tip}" />
                                            <WrapPanel>
                                                <Button Content="{l:T proxy.enable}" Style="{StaticResource Primary}" Command="{Binding EnableCmd}" />
                                                <Button Content="{l:T proxy.disable}" Command="{Binding ClearCmd}" ToolTip="{l:T proxy.disable.tip}" />
                                                <Button Content="{l:T proxy.restore}" Command="{Binding RestoreCmd}" Visibility="{Binding HasPrevious, Converter={StaticResource Vis}}" />
                                                <Button Content="{l:T proxy.check}" Command="{Binding CheckCmd}" ToolTip="{l:T proxy.check.tip}" />
                                            </WrapPanel>
                                            <TextBox Text="{Binding PreviousText, Mode=OneWay}" local:Demo.Sensitive="True" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                                                     Visibility="{Binding HasPrevious, Converter={StaticResource Vis}}" />
                                            <TextBox Text="{Binding CheckText, Mode=OneWay}" local:Demo.Sensitive="True" Style="{StaticResource SelectableText}" Margin="0,8,0,0" Visibility="{Binding HasCheck, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Короткие честные подсказки о подводных камнях. -->
                                    <Border x:Name="ProxyHintsCard" Style="{StaticResource Inset}" DataContext="{Binding Proxy}">
                                        <StackPanel>
                                            <TextBlock Text="{l:T proxy.hints.title}" Style="{StaticResource H2}" />
                                            <ItemsControl ItemsSource="{Binding Hints}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Expander Header="{l:T common.more}" Style="{StaticResource SubBlock}">
                                                <ItemsControl ItemsSource="{Binding HintsMore}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="NetHostsBlock" Style="{StaticResource NetBlock}" IsExpanded="{Binding HostsBlockOpen}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource Ic.wrench}" Fill="{DynamicResource AccentText}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="{l:T common.nav.hosts}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <local:InfoButton Grid.Column="2" Topic="{x:Static local:InfoTexts.Hosts}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding NetHostsStatus}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{Binding NetHostsStatus}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel DataContext="{Binding Hosts}">
                                    <StackPanel.Resources>
                                        <!-- Строка вердикта: галочка (только если с ней можно что-то сделать) | «адрес имя» и что выяснила проверка | вердикт и пояснение. -->
                                        <DataTemplate x:Key="TryRowTemplate">
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{l:T hosts.row.select}"
                                                              Visibility="{Binding CanSelect, Converter={StaticResource Vis}}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"><Run Text="{Binding Ip, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Host, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                        <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                                        <Expander Header="{l:T common.more}" FontSize="12" Visibility="{Binding HasTechnical, Converter={StaticResource Vis}}">
                                                            <TextBox Text="{Binding Technical, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                                        </Expander>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Width="190" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="muted"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Reason}" FontSize="13" Opacity="0.8" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </StackPanel.Resources>

                                    <!-- Что внутри и когда нужно: название вкладки не говорит ни про hosts, ни про GitHub (UX-аудит 5, п. 8). -->
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="{l:T hosts.intro}" />

                                    <!-- Якоря: вкладка длинная, разделы свёрнуты — ссылка раскрывает раздел и прокручивает к нему. -->
                                    <WrapPanel Margin="0,0,0,10">
                                        <TextBlock Text="{l:T hosts.goto}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource LinkButton}" Content="{l:T hosts.anchor.list}" Tag="HostsListSection" Click="HostsAnchor_Click" />
                                        <Button Style="{StaticResource LinkButton}" Content="{l:T hosts.anchor.try}" Tag="HostsTrySection" Click="HostsAnchor_Click" />
                                        <Button Style="{StaticResource LinkButton}" Content="{l:T hosts.anchor.user}" Tag="HostsUserSection" Click="HostsAnchor_Click" />
                                        <Button Style="{StaticResource LinkButton}" Content="{l:T hosts.audit.title}" Tag="HostsAuditSection" Click="HostsAnchor_Click" />
                                    </WrapPanel>

                                    <!-- Замечания свёрнуты в одну строку «N замечания · Подробнее» (UX-аудит 5, п. 24); раскрываются одним щелчком. -->
                                    <Expander Header="{Binding WarningsHeader}" Visibility="{Binding HasWarnings, Converter={StaticResource Vis}}">
                                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,4,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                                        Padding="10,6" Margin="0,0,0,6">
                                                    <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="13" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Expander>

                                    <!-- Всё, что DpiShell изменила в hosts, откатывается одной кнопкой; чужие строки остаются теми же байтами. -->
                                    <Border Style="{StaticResource InsetBox}" Padding="14,10" Visibility="{Binding HasOurs, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{l:T hosts.restore_all}" Command="{Binding RestoreAllCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding OursText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>

                                    <!-- 1. Проверенные адреса: GitHub, Telegram, Discord -->
                                    <Expander x:Name="HostsListSection" Style="{StaticResource SubBlock}" IsExpanded="{Binding ListOpen}">
                                        <Expander.Header>
                                            <TextBlock Text="{l:T hosts.list.title}" FontSize="15" FontWeight="SemiBold" />
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                            <DockPanel>
                                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{l:T hosts.remove_entries}" Command="{Binding RevertCmd}" VerticalAlignment="Top" Margin="12,0,0,0"
                                                        Visibility="{Binding BlockPresent, Converter={StaticResource Vis}}" />
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <TextBlock Text="{l:T hosts.enable}" FontSize="15" FontWeight="SemiBold" />
                                                </CheckBox>
                                            </DockPanel>
                                            <TextBlock Text="{Binding OffHint}" Style="{StaticResource Hint}" Margin="50,4,0,0" Visibility="{Binding Disabled, Converter={StaticResource Vis}}" />
                                            <StackPanel Margin="50,4,0,0" Visibility="{Binding Enabled, Converter={StaticResource Vis}}">
                                                <TextBox Text="{Binding StatusText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                                <ItemsControl ItemsSource="{Binding AppliedLines}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Muted}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Margin="0,10,0,0" Visibility="{Binding Enabled, Converter={StaticResource Vis}}">
                                                <WrapPanel>
                                                    <Button ContentTemplate="{StaticResource Shield}" Content="{l:T hosts.check}" Style="{StaticResource Primary}" Command="{Binding CheckCmd}" />
                                                    <Button Content="{l:T hosts.stop}" Command="{Binding StopCmd}" Visibility="{Binding Checking, Converter={StaticResource Vis}}" />
                                                </WrapPanel>
                                                <StackPanel Visibility="{Binding Checking, Converter={StaticResource Vis}}">
                                                    <ProgressBar Height="8" Maximum="{Binding Total}" Value="{Binding Done, Mode=OneWay}" Margin="0,2,0,4" />
                                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                                </StackPanel>
                                                <TextBox Text="{Binding Summary, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,8" Visibility="{Binding HasSummary, Converter={StaticResource Vis}}" />
                                            </StackPanel>

                                            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                                      HeadersVisibility="Column" CanUserAddRows="False" MinHeight="90" PreviewMouseWheel="PassWheelToPage"
                                                      Visibility="{Binding Rows.Count, Converter={StaticResource NonZero}}">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                        <Style.Triggers>
                                                            <!-- Не записываются — серым «не нужно» (architecture.md «Починить адреса (hosts)»). -->
                                                            <DataTrigger Binding="{Binding Install}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <!-- Две строки на ячейку: таблица помещается в окно минимальной ширины без обрезанных слов. -->
                                                    <DataGridTemplateColumn Header="{l:T hosts.col.site}" Width="1.5*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel ToolTip="{Binding Host}">
                                                                    <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                    <TextBlock Text="{Binding Ip}" FontSize="13" Opacity="0.75" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{l:T hosts.col.owner}" Width="0.9*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Owner}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Owner}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{l:T hosts.col.check}" Width="1.3*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Live}" TextWrapping="NoWrap" />
                                                                    <TextBlock FontSize="13" Opacity="0.75" TextWrapping="NoWrap" Text="{Binding DnsLine, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{l:T hosts.col.result}" Width="2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel ToolTip="{Binding Reason}">
                                                                    <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Reason}" FontSize="13" Opacity="0.75" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Предпросмотр: что именно изменится в hosts, затем «Записать» с подтверждением. -->
                                            <Border Style="{StaticResource InsetBox}" Margin="0,12,0,0" Padding="14" Visibility="{Binding CanWrite, Converter={StaticResource Vis}}">
                                                <DockPanel>
                                                    <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Right" Content="{Binding ApplyText}" Style="{StaticResource Primary}" Command="{Binding ApplyCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T hosts.preview.title}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                                        <ItemsControl ItemsSource="{Binding PreviewLines}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="13" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <!-- 2. Примерить строки из гайда -->
                                    <Expander x:Name="HostsTrySection" Style="{StaticResource SubBlock}" IsExpanded="{Binding TryOpen}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{l:T hosts.try.title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <local:InfoButton Topic="{x:Static local:InfoTexts.HostsTry}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                       Text="{l:T hosts.try.intro}" />
                                            <TextBlock Text="{Binding ToolsUnavailableText}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ToolsUnavailable, Converter={StaticResource Vis}}" />
                                            <TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AutomationProperties.Name="{l:T hosts.try.input_name}"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                                     FontFamily="Consolas" FontSize="14" Padding="8" Height="110" local:Demo.Sensitive="True" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button ContentTemplate="{StaticResource Shield}" Content="{l:T hosts.try.run}" Style="{StaticResource Primary}" Command="{Binding TryCmd}" />
                                                <Button Content="{l:T hosts.stop}" Command="{Binding StopCmd}" Visibility="{Binding Trying, Converter={StaticResource Vis}}" />
                                                <Button Content="{l:T hosts.clear}" Command="{Binding ClearTryCmd}" />
                                            </WrapPanel>
                                            <StackPanel Visibility="{Binding Trying, Converter={StaticResource Vis}}">
                                                <ProgressBar Height="8" Maximum="{Binding Total}" Value="{Binding Done, Mode=OneWay}" Margin="0,2,0,4" />
                                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                            </StackPanel>
                                            <TextBox Text="{Binding TrySummary, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6" Visibility="{Binding HasTrySummary, Converter={StaticResource Vis}}" />
                                            <ItemsControl ItemsSource="{Binding TryRows}" ItemTemplate="{StaticResource TryRowTemplate}" />
                                            <DockPanel Margin="0,10,0,0" Visibility="{Binding TryRows.Count, Converter={StaticResource NonZero}}">
                                                <Button ContentTemplate="{StaticResource Shield}" DockPanel.Dock="Left" Content="{Binding WriteSelectedText}" Style="{StaticResource Primary}" Command="{Binding WriteSelectedCmd}" VerticalAlignment="Top" />
                                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8"
                                                           Text="{l:T hosts.try.write_note}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- 3. Мои строки -->
                                    <Expander x:Name="HostsUserSection" Style="{StaticResource SubBlock}" IsExpanded="{Binding UserOpen}">
                                        <Expander.Header>
                                            <TextBlock Text="{l:T hosts.user.title}" FontSize="15" FontWeight="SemiBold" />
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="{Binding UserHeader}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding UserRows}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <Button DockPanel.Dock="Right" Content="{l:T hosts.user.remove}" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.RemoveUserCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                            <StackPanel>
                                                                <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="14" local:Demo.Sensitive="True" />
                                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" FontSize="12" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="{l:T hosts.user.remove_all}" Command="{Binding RemoveAllUserCmd}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding HasUserRows, Converter={StaticResource Vis}}" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                       Text="{l:T hosts.user.note}" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- 4. Проверить мой hosts -->
                                    <Expander x:Name="HostsAuditSection" Style="{StaticResource SubBlock}" IsExpanded="{Binding AuditOpen}">
                                        <Expander.Header>
                                            <TextBlock Text="{l:T hosts.audit.title}" FontSize="15" FontWeight="SemiBold" />
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                       Text="{l:T hosts.audit.intro}" />
                                            <TextBlock Text="{Binding ToolsUnavailableText}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ToolsUnavailable, Converter={StaticResource Vis}}" />
                                            <WrapPanel>
                                                <Button ContentTemplate="{StaticResource Shield}" Content="{l:T hosts.audit.title}" Style="{StaticResource Primary}" Command="{Binding AuditCmd}" />
                                                <Button Content="{l:T hosts.stop}" Command="{Binding StopCmd}" Visibility="{Binding Auditing, Converter={StaticResource Vis}}" />
                                            </WrapPanel>
                                            <StackPanel Visibility="{Binding Auditing, Converter={StaticResource Vis}}">
                                                <ProgressBar Height="8" Maximum="{Binding Total}" Value="{Binding Done, Mode=OneWay}" Margin="0,2,0,4" />
                                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                            </StackPanel>
                                            <TextBox Text="{Binding AuditSummary, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6" Visibility="{Binding HasAuditSummary, Converter={StaticResource Vis}}" />
                                            <ItemsControl ItemsSource="{Binding AuditRows}" ItemTemplate="{StaticResource TryRowTemplate}" />
                                            <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasProblems, Converter={StaticResource Vis}}">
                                                <Button ContentTemplate="{StaticResource Shield}" Content="{Binding CommentText}" Style="{StaticResource Primary}" Command="{Binding CommentCmd}" />
                                                <Button Content="{l:T hosts.audit.select_problems}" Command="{Binding SelectProblemsCmd}" />
                                            </WrapPanel>
                                            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasOff, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{l:T hosts.audit.off_title}" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding OffRows}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,4">
                                                                <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="13" local:Demo.Sensitive="True" />
                                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" FontSize="12" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding UncommentText}" Command="{Binding UncommentCmd}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Диагностика: только проверки и исправления (UX-аудит п. 12); настройки, обновления, помощник — во вкладке «Настройки». ===== -->
                <TabItem Header="{l:T common.nav.diag}" AutomationProperties.Name="{l:T common.nav.diag}" local:Nav.Icon="{StaticResource Ic.pulse}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DiagUpdated}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource LinkButton}" Command="{Binding RefreshDiagCmd}" AutomationProperties.Name="{Binding RefreshButtonText}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Значок «обновить» из системного шрифта Windows 10/11 (Segoe Fluent Icons / Segoe MDL2 Assets). -->
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding RefreshButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="{l:T common.nav.diag}" Style="{StaticResource H1}" />
                                    <local:InfoButton Topic="{x:Static local:InfoTexts.Diag}" Margin="10,0,0,12" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Обход: одна строка, внутренности (драйвер, файлы, метки TCP) — за «Подробнее» (п. 15). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{l:T diag.optimization.label}" Foreground="{DynamicResource Muted}" DockPanel.Dock="Left" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding ServiceText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                    </DockPanel>
                                    <Expander Header="{l:T common.more}">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{l:T diag.driver}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBox Grid.Column="1" Text="{Binding DriverText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Text="{l:T diag.core_files}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CoreText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="2" Text="{l:T diag.timestamps}" Style="{StaticResource Hint}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TimestampsText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Warn}" Visibility="{Binding CoreBroken, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:T diag.core_broken}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Button ContentTemplate="{StaticResource Shield}" Content="{l:T diag.repair}" Style="{StaticResource Primary}" Command="{Binding RepairCoreCmd}" HorizontalAlignment="Left" />
                                    <!-- Путь не переписывать руками: «Скопировать путь» и сразу «Безопасность Windows» (п. 16). -->
                                    <TextBlock Text="{l:T diag.exclusion_hint}" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding CoreFolder, Mode=OneWay}" Style="{StaticResource SelectableText}" local:Demo.Sensitive="True" FontSize="12" Margin="0,2,0,0" />
                                    <Expander Header="{l:T common.more}">
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{l:T diag.defender_path}" />
                                    </Expander>
                                    <WrapPanel Margin="-4,6,0,0">
                                        <Button Content="{l:T diag.copy_path}" Style="{StaticResource LinkButton}" Command="{Binding CopyCoreFolderCmd}" Margin="0,0,10,0" />
                                        <Button Content="{l:T diag.open_defender}" Style="{StaticResource LinkButton}" Command="{Binding OpenDefenderCmd}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T diag.conflicts.title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{l:T diag.conflicts.none}" Style="{StaticResource Hint}" Visibility="{Binding ConflictList.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding ConflictList}" local:Demo.Sensitive="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="{l:T diag.conflicts.note}" />
                                    <Button ContentTemplate="{StaticResource Shield}" Content="{l:T diag.conflicts.stop}" Command="{Binding StopConflictsCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            ToolTip="{Binding StopConflictsTip}" ToolTipService.ShowOnDisabled="True"
                                            Visibility="{Binding ConflictList.Count, Converter={StaticResource NonZero}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="VPN" Style="{StaticResource H2}" />
                                    <TextBlock Text="{l:T diag.vpn.none}" Style="{StaticResource Hint}" Visibility="{Binding VpnList.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding VpnList}" local:Demo.Sensitive="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="{l:T diag.vpn.note}" />
                                </StackPanel>
                            </Border>

                            <!-- Проверки окружения (09-features-spec §4): только показываем, что мешает и что сделать. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T diag.findings.title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{l:T diag.findings.empty}" Style="{StaticResource Hint}" Visibility="{Binding Findings.Count, Converter={StaticResource Zero}}" />
                                    <ItemsControl ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="M" Text="{Binding Mark}" FontWeight="Bold" Foreground="{DynamicResource Ok}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Hint}" />
                                                    <TextBox Grid.Column="2" Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}" local:Demo.Sensitive="True" />
                                                    <!-- «Системный прокси включён» → вкладка «Прокси». -->
                                                    <Button Grid.Column="3" Content="{l:T diag.open_proxy}" Style="{StaticResource LinkButton}" Margin="10,0,0,0" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.GoProxyCmd, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            Visibility="{Binding HasGo, Converter={StaticResource Vis}}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter TargetName="M" Property="Foreground" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Решение 5: кэш Discord — кнопкой, с подтверждением (открытый Discord закрывается). -->
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:T diag.discord.clear}" Command="{Binding ClearDiscordCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{l:T diag.discord.title}" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="{l:T diag.discord.note}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Свои переводы, которые не взяты (битый файл, неверные строки): причина — здесь (docs/localization.md). -->
                            <Border Style="{StaticResource Card}" DataContext="{Binding Lang}" Visibility="{Binding HasProblems, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:T common.lang.problems}" Style="{StaticResource H2}" />
                                    <ItemsControl ItemsSource="{Binding Problems}" local:Demo.Sensitive="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Для вопроса о проблеме: журнал. («Роутер: что мешает» — на вкладке «Роутер».) -->
                            <WrapPanel>
                                <Button Content="{l:T diag.open_logs}" Command="{Binding OpenLogsCmd}" />
                                <Button Content="{l:T diag.open_results}" Command="{Binding OpenResultsCmd}" />
                                <Button Content="{l:T diag.report.save}" Command="{Binding SaveReportCmd}" ToolTip="{l:T diag.report.tip}" />
                                <Button Content="{l:T diag.report.issue}" Style="{StaticResource LinkButton}" Command="{Binding OpenIssuesCmd}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Роутер (router-api §5–6): обход, «Роутер: что мешает», DNS для всей сети (режим и «Сайт не открывается» — на «Сайтах»), «Проверять сам», подключение.
                     Видна всегда (п. 47): роутер не найден — пустое состояние, что можно сделать, и адрес. ===== -->
                <TabItem Header="{l:T common.nav.router}" AutomationProperties.Name="{l:T common.nav.router}" local:Nav.Icon="{StaticResource Ic.router}"
                         Visibility="{Binding ShowRouter, Converter={StaticResource Vis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Router}">
                        <StackPanel>
                            <TextBlock Text="{l:T common.nav.router}" Style="{StaticResource H1}" />

                            <!-- Совместимость (router-api §5.4): другая версия на роутере — что не так и что сделать. Обновление программы — отдельно (ссылка на выпуски). -->
                            <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding HasCompat, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBox Text="{Binding CompatText, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="-4,8,0,0">
                                        <Button Content="{l:T router.compat.update_router}" Style="{StaticResource Primary}" Command="{Binding UpdateCmd}" Margin="4,0,8,0"
                                                Visibility="{Binding CompatNeedsRouter, Converter={StaticResource Vis}}" />
                                        <Button Content="{l:T router.compat.update_app}" Style="{StaticResource LinkButton}" Command="{Binding GoUpdatesCmd}" VerticalAlignment="Center" Margin="4,0,8,0"
                                                ToolTip="{l:T router.compat.update_app_tip}" Visibility="{Binding CompatNeedsApp, Converter={StaticResource Vis}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Обновление DpiShell на роутере (status.update): «Доступно обновление X», «Что нового», «Обновить». -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding ShowUpdate, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding UpdateButtonText}" Style="{StaticResource Primary}" Command="{Binding UpdateCmd}" VerticalAlignment="Center"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" />
                                        <TextBox Text="{Binding UpdateTitle, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <!-- Шаги (status.update.job.step): «Скачиваю → Устанавливаю → Перезапуск службы → Готово», текущий выделен. -->
                                    <ItemsControl ItemsSource="{Binding UpdateSteps}" Margin="0,6,0,0" Visibility="{Binding HasUpdateSteps, Converter={StaticResource Vis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run x:Name="Step" Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource Muted}" /><Run Text="{Binding Arrow, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                </TextBlock>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Current}" Value="True">
                                                        <Setter TargetName="Step" Property="FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="Step" Property="Foreground" Value="{DynamicResource Text}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Expander Header="{l:T common.more}" Visibility="{Binding HasUpdateLog, Converter={StaticResource Vis}}">
                                        <TextBox Text="{Binding UpdateLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="6,4" Margin="0,4,0,0"
                                                 MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{l:T router.update.log_name}" />
                                    </Expander>
                                    <Expander Header="{l:T router.update.notes}" Visibility="{Binding HasUpdateNotes, Converter={StaticResource Vis}}">
                                        <TextBox Text="{Binding UpdateNotes, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Пустое состояние: DpiShell на роутере не найден. -->
                            <!-- Пока не искали — «не проверялся» (UX-аудит 2, п. 10); как поставить — ссылка на инструкцию и место под «Установить на роутер» (п. 9). -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Found, Converter={StaticResource InvVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Text="{l:T router.empty.intro}" />
                                    <!-- Человек не знает слов «OpenWrt» и «LuCI»: одна кнопка, программа сама находит роутер и отвечает «да / нет / не знаю» (UX-аудит 7, п. 10). -->
                                    <WrapPanel Margin="-4,10,0,0">
                                        <Button Content="{l:T router.empty.fit}" Style="{StaticResource Primary}" Command="{Binding FitCmd}" Margin="4,0,8,0" />
                                        <!-- Установка из окна по SSH (router-api §5.4, RouterInstallDialog). -->
                                        <Button Content="{l:T router.empty.install}" Command="{Binding InstallCmd}" Margin="4,0,8,0"
                                                Visibility="{Binding CanInstall, Converter={StaticResource Vis}}" />
                                        <Button Content="{l:T router.empty.guide}" Style="{StaticResource LinkButton}" Command="{Binding GuideCmd}" VerticalAlignment="Center"
                                                ToolTip="{l:T router.empty.guide_tip}" />
                                    </WrapPanel>
                                    <TextBox Text="{Binding FitText, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasFit, Converter={StaticResource Vis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{l:T router.empty.installed_q}" />
                                        <Button Content="{l:T router.find}" Style="{StaticResource LinkButton}" Command="{Binding FindCmd}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Expander Header="{l:T common.more}">
                                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="{l:T router.empty.openwrt_hint}" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Обход на роутере: состояние, предупреждения с «Исправить», действия (на главной — одна строка со ссылкой сюда). -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Found, Converter={StaticResource Vis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,6,12,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RouterEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding HomeTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding HomeDetail, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,1,0,0" />
                                        <!-- Выключение без человека (last_off: сторож, кнопка на корпусе, откат пробы): фраза, «Подробнее» — что не открылось, «Включить снова». -->
                                        <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="4"
                                                Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Left" MaxWidth="640"
                                                Visibility="{Binding HasOff, Converter={StaticResource Vis}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                Visibility="{Binding CanReEnable, Converter={StaticResource Vis}}">
                                                        <Button Content="{Binding ReEnableText}" Style="{StaticResource LinkButton}" Command="{Binding ReEnableCmd}" />
                                                        <Button Content="{l:T router.select}" Command="{Binding GoSelectCmd}" Margin="8,0,0,0"
                                                                Visibility="{Binding OfferSelectButton, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding OffText, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <!-- Подбор после сторожа идёт: полоса хода (текст хода — строкой карточки выше), как у обычного подбора на роутере. -->
                                                <ProgressBar Height="8" Maximum="{Binding SelectProgressMax}" Value="{Binding SelectProgress, Mode=OneWay}" Margin="0,8,0,2"
                                                             Visibility="{Binding WdRunning, Converter={StaticResource Vis}}" />
                                                <!-- Сторож выключил обход: не решаем за человека, а предлагаем подобрать другую стратегию; «Не сейчас» прячет до следующего срабатывания. -->
                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding OfferSelect, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{l:T router.off.offer_title}" FontWeight="SemiBold" />
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button Content="{l:T router.select}" Style="{StaticResource Primary}" Command="{Binding GoSelectCmd}" />
                                                        <Button Content="{l:T router.not_now}" Command="{Binding DismissOfferCmd}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Expander Header="{l:T common.more}" Visibility="{Binding HasOffDetails, Converter={StaticResource Vis}}">
                                                    <StackPanel Margin="0,4,0,0">
                                                        <TextBox Text="{Binding OffDetail, Mode=OneWay}" Style="{StaticResource SelectableHint}" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasOffDetail, Converter={StaticResource Vis}}" />
                                                        <ItemsControl ItemsSource="{Binding OffTargets}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                                                        <Run Text="✗" Foreground="{DynamicResource Danger}" /><Run Text=" " /><Run Text="{Binding Url, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                        <!-- Предупреждения роутера: у исправимых (flow_offload, ipv6) — «Исправить», у чужого обхода — «Подробнее». -->
                                        <ItemsControl ItemsSource="{Binding WarningRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left" MaxWidth="640">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="{Binding Fix}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasFix, Converter={StaticResource Vis}}"
                                                                    Command="{Binding DataContext.FixWarningCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Code}" />
                                                            <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Метки TCP (needs_tcp_timestamps): не смогли включить сами — плашка как у предупреждений и «Включить» со щитом (меняет Windows этого ПК);
                                             включили — серой строкой. Термин — только в подсказке (UX-аудит 2, п. 8). -->
                                        <Border Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="4"
                                                Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left" ToolTip="{l:T router.timestamps.term}"
                                                Visibility="{Binding TimestampsNeedAction, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding TimestampsNote, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                                                <Button Content="{l:T router.enable}" ContentTemplate="{StaticResource Shield}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding EnableTimestampsCmd}" ToolTip="{l:T router.timestamps.term}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBox Text="{Binding TimestampsNote, Mode=OneWay}" Style="{StaticResource SelectableHint}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   ToolTip="{l:T router.timestamps.term}" Visibility="{Binding TimestampsDone, Converter={StaticResource Vis}}" />
                                        <WrapPanel Margin="0,12,0,0" Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                            <Button Content="{Binding ToggleText}" Command="{Binding ToggleCmd}" ToolTip="{Binding MethodsTip}" ToolTipService.ShowOnDisabled="True"
                                                    Visibility="{Binding ShowRouterActions, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T router.check}" Command="{Binding CheckCmd}" ToolTip="{Binding MethodsTip}" ToolTipService.ShowOnDisabled="True" />
                                            <Button Content="{l:T router.select}" Command="{Binding GoSelectCmd}" ToolTip="{Binding MethodsTip}" ToolTipService.ShowOnDisabled="True"
                                                    Visibility="{Binding ShowRouterActions, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T router.stop_select}" Command="{Binding StopSelectCmd}" Visibility="{Binding WdRunning, Converter={StaticResource Vis}}" />
                                            <Button Click="RouterStrategy_Click" IsEnabled="{Binding CanAct}" ToolTip="{l:T router.strategy_tip}" AutomationProperties.Name="{l:T router.strategy_tip}"
                                                    Visibility="{Binding ShowRouterActions, Converter={StaticResource Vis}}">
                                                <TextBlock><Run Text="{l:T router.strategy}" /><Run Text=" ▾" Foreground="{DynamicResource Muted}" /></TextBlock>
                                            </Button>
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding NeedLogin, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                            <TextBlock Text="{l:T router.login_hint}" Style="{StaticResource Hint}" />
                                            <Button Content="{l:T router.login}" Command="{Binding LoginCmd}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Совместная работа с роутером (mixed-strategies.md §7, договор pc_link_*): выключена по умолчанию; включена — роутер ведёт YouTube и Discord
                                 для всей сети, этот ПК — свои сайты. Короткий статус, под ним — что ведёт роутер. Работает только при обоих приложениях. -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding JointCardVisible, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:T router.joint.title}" Style="{StaticResource H2}" />
                                        <local:InfoButton Topic="{x:Static local:InfoTexts.Joint}" Margin="8,0,0,8" />
                                    </StackPanel>
                                    <!-- Переключатель показывает настоящее состояние: роутера нет — выключен, а не «включён и ждёт» (UX-аудит 6, п. 6, 14). -->
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding JointShown}" IsEnabled="{Binding JointAvailable}" HorizontalAlignment="Left"
                                              AutomationProperties.Name="{l:T router.joint.title}">
                                        <TextBlock Text="{Binding JointToggleText}" FontSize="15" FontWeight="SemiBold" />
                                    </CheckBox>
                                    <TextBox Text="{Binding JointStatus, Mode=OneWay}" Style="{StaticResource SelectableText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="50,4,0,0"
                                               Visibility="{Binding HasJointStatus, Converter={StaticResource Vis}}" />
                                    <TextBox Text="{Binding JointNotes, Mode=OneWay}" Style="{StaticResource SelectableHint}" TextWrapping="Wrap" Margin="50,2,0,0" local:Demo.Sensitive="True"
                                               Visibility="{Binding HasJointNotes, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding JointHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="50,4,0,0"
                                               Visibility="{Binding HasJointHint, Converter={StaticResource Vis}}" />
                                    <Button Content="{l:T router.joint.stop_wait}" Style="{StaticResource LinkButton}" Command="{Binding JointStopWaitCmd}" HorizontalAlignment="Left" Margin="46,0,0,0"
                                            Visibility="{Binding JointWaiting, Converter={StaticResource Vis}}" ToolTip="{l:T router.joint.stop_wait_tip}" />
                                </StackPanel>
                            </Border>

                            <!-- «Роутер: что мешает» (diag, чужие обходы с «Остановить», отчёт; router-api §6) — рядом с плашками состояния. -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Found, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBox Text="{Binding DiagUpdated, Mode=OneWay}" Style="{StaticResource SelectableHint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Content="{l:T router.diag.save_report}" Style="{StaticResource LinkButton}" Command="{Binding SaveReportCmd}" Margin="0,0,8,0" />
                                            <Button Content="{l:T router.diag.recheck}" Style="{StaticResource LinkButton}" Command="{Binding RefreshDiagCmd}" />
                                        </StackPanel>
                                        <TextBlock Text="{l:T router.diag.title}" Style="{StaticResource H2}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding DiagHint}" Style="{StaticResource Hint}" Visibility="{Binding ShowDiagHint, Converter={StaticResource Vis}}" />
                                    <StackPanel Visibility="{Binding DiagLoaded, Converter={StaticResource Vis}}">
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{l:T router.diag.flow}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <!-- «Исправить» — один раз, в плашке выше: одна проблема показывается один раз (UX-аудит 6, п. 13). -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBox Text="{Binding FlowOffloadText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{l:T router.diag.ipv6}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBox Text="{Binding Ipv6Text, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="{l:T common.nav.dns}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DnsText, Mode=OneWay}" Style="{StaticResource SelectableText}" local:Demo.Sensitive="True" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="3" Text="{l:T router.diag.space}" Style="{StaticResource Hint}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SpaceText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                        </Grid>
                                        <TextBlock Text="{l:T router.diag.conflicts}" Style="{StaticResource Hint}" Margin="0,12,0,4" />
                                        <TextBlock Text="{l:T router.diag.none}" Visibility="{Binding Conflicts.Count, Converter={StaticResource Zero}}" />
                                        <ItemsControl ItemsSource="{Binding Conflicts}" local:Demo.Sensitive="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <Button DockPanel.Dock="Right" Content="{l:T router.diag.stop}" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                                                Visibility="{Binding CanStop, Converter={StaticResource Vis}}"
                                                                Command="{Binding DataContext.StopConflictCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}" />
                                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- «Безопасность роутера» (security_check, роутер с 0.2.0-r13; старый — карточки нет): справочно, как на странице роутера.
                                 Только текст — что защищено и варианты решения, без кнопок (решение владельца 22.10). -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding SecurityShown, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:T router.security.title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{l:T router.security.intro}" Style="{StaticResource Hint}" TextWrapping="Wrap" ToolTip="{l:T router.security.intro_info}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SecuritySummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SecurityHasWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarnText}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding SecurityRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="M" Text="{Binding Mark}" FontWeight="Bold" Foreground="{DynamicResource Ok}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                                        <TextBox Text="{Binding Fix, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,2,0,0"
                                                                 Visibility="{Binding HasFix, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Warn"><Setter TargetName="M" Property="Foreground" Value="{DynamicResource WarnText}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Unknown"><Setter TargetName="M" Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Ускорение сети — в «Что мешает» выше; здесь только ссылка, без повтора. -->
                                    <Grid Margin="0,3" Visibility="{Binding SecurityFlowRef, Converter={StaticResource Vis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                                        <TextBlock Grid.Column="1" Text="{l:T router.diag.flow}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{l:T router.security.flow_ref}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- «Изменения DpiShell на роутере» (changes_list, роутер с 0.2.0-r16; старый — карточки нет): тот же список, что на странице
                                 роутера («Диагностика»), вид — как «Изменения DpiShell» в «Настройках». ⚠-подпись — отмена может на секунды оборвать связь. -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding RouterChangesShown, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{l:T settings.changes.undo_all}" Command="{Binding RouterUndoAllCmd}" VerticalAlignment="Center"
                                                Visibility="{Binding RouterCanUndoAll, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{l:T router.changes.title}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:T router.changes.intro}" />
                                    <TextBlock Text="{l:T settings.changes.empty}" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="{Binding RouterChangesEmpty, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding RouterChanges}" Margin="0,6,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <Border DockPanel.Dock="Right" Width="128" Margin="12,0,0,0">
                                                        <Button Content="{Binding Action}" Style="{StaticResource LinkButton}" Command="{Binding UndoCmd}" HorizontalAlignment="Right"
                                                                VerticalAlignment="Top" Visibility="{Binding HasAction, Converter={StaticResource Vis}}" />
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" local:Demo.Sensitive="True" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Итог отмены по пунктам — как в «Настройках». -->
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRouterChangesReport, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding RouterChangesSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding RouterChangesReport}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,3">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,8,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Mark}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Mark}" Value="fail"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" local:Demo.Sensitive="True" />
                                                        </WrapPanel>
                                                        <TextBox Text="{Binding Note, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" Margin="0,1,0,0"
                                                                 Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding Connected, Converter={StaticResource Vis}}">
                                <!-- DNS для всей сети: dns_status, «Проверить», «Включить защищённый DNS», «Вернуть как было» (фоновые задания). -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{l:T router.dns.title}" Style="{StaticResource H2}" />
                                            <local:InfoButton Topic="{x:Static local:InfoTexts.RouterDns}" Margin="8,0,0,8" />
                                        </StackPanel>
                                        <TextBox Text="{Binding DnsState, Mode=OneWay}" Style="{StaticResource SelectableText}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding DnsLoaded, Converter={StaticResource Vis}}" />
                                        <TextBox Text="{Binding DnsHint, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding HasDnsHint, Converter={StaticResource Vis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasDnsJob, Converter={StaticResource Vis}}">
                                            <ProgressBar Height="4" Width="60" IsIndeterminate="{Binding DnsRunning}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Visibility="{Binding DnsRunning, Converter={StaticResource Vis}}" />
                                            <TextBox Text="{Binding DnsJobText, Mode=OneWay}" Style="{StaticResource SelectableHint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="{l:T router.check}" Command="{Binding DnsCheckCmd}" />
                                            <!-- Старый пакет на роутере (без dns_presets) — одна кнопка, как раньше. -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding DnsSingleButton, Converter={StaticResource Vis}}">
                                                <Button Content="{l:T router.dns.enable}" Style="{StaticResource Primary}" Command="{Binding DnsEnableCmd}"
                                                        Visibility="{Binding DnsCanEnable, Converter={StaticResource Vis}}" />
                                                <Button Content="{l:T router.dns.restore}" Command="{Binding DnsRestoreCmd}"
                                                        Visibility="{Binding DnsProtected, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <!-- Варианты для всей сети — тот же выбор, что для этого компьютера (свои — общие). -->
                                        <local:DnsPickerView x:Name="RouterDnsPicker" DataContext="{Binding DnsPick}" Margin="0,10,0,0"
                                                             Visibility="{Binding DataContext.DnsPresetsAvailable, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource Vis}}" />
                                        <Expander Header="{l:T router.dns.servers_header}" IsExpanded="{Binding DnsDetailsOpen}" Visibility="{Binding DnsServers.Count, Converter={StaticResource NonZero}}">
                                            <ItemsControl ItemsSource="{Binding DnsServers}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- «Проверять сам» и автоподбор (schedule_set) — на роутере, на ПК фоновой проверки нет. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:T router.schedule.title}" Style="{StaticResource H2}" />
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="{l:T router.schedule.enabled}" IsChecked="{Binding ScheduleEnabled}" IsEnabled="{Binding CanAct}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding Source={x:Static local:RouterViewModel.ScheduleOptions}}" DisplayMemberPath="Title" SelectedValuePath="Hours"
                                                      SelectedValue="{Binding ScheduleHours}" IsEnabled="{Binding ScheduleEditable}" Width="180" Margin="14,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{l:T router.schedule.interval_name}" />
                                        </StackPanel>
                                        <TextBlock Text="{l:T router.schedule.fallback_hint}" Style="{StaticResource Hint}" Margin="26,4,0,0" />
                                        <CheckBox Content="{l:T router.schedule.reselect}" IsChecked="{Binding AutoSelect}" IsEnabled="{Binding ScheduleEditable}"
                                                  Margin="0,10,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="{l:T router.schedule.reselect_hint}" Style="{StaticResource Hint}"
                                                   Margin="26,4,0,0" TextWrapping="Wrap" />
                                        <!-- Сторож (schedule.watchdog, status.watchdog): аварийный выключатель на самом роутере. -->
                                        <StackPanel Visibility="{Binding WatchdogAvailable, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <CheckBox Content="{l:T router.watchdog.check}" IsChecked="{Binding WatchdogEnabled}" IsEnabled="{Binding CanAct}"
                                                          VerticalAlignment="Center" />
                                                <local:InfoButton Topic="{x:Static local:InfoTexts.RouterWatchdog}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBox Text="{Binding WatchdogLine, Mode=OneWay}" Style="{StaticResource SelectableHint}" Margin="26,4,0,0"
                                                       Visibility="{Binding HasWatchdogLine, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Подключение: адрес и вход (раньше — карточка в конце «Диагностики»). Пароль — в диалоге «Войти». -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T router.connection.title}" Style="{StaticResource H2}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <!-- Роутера нет — «Найти» одна, в карточке выше (UX-аудит 6, п. 14). -->
                                        <Button Content="{l:T router.find}" Command="{Binding FindCmd}" Visibility="{Binding Found, Converter={StaticResource Vis}}" />
                                        <Button Content="{l:T router.login_dots}" Style="{StaticResource Primary}" Command="{Binding LoginCmd}" Visibility="{Binding NeedLogin, Converter={StaticResource Vis}}" />
                                        <Button Content="{l:T router.change_password}" Command="{Binding LoginCmd}" Visibility="{Binding Connected, Converter={StaticResource Vis}}" />
                                        <!-- Установка по SSH: пакета нет — «Установить на роутер», есть — «Установить заново» (починить сломанную установку). -->
                                        <Button Content="{Binding InstallText}" Command="{Binding InstallCmd}" Visibility="{Binding Found, Converter={StaticResource Vis}}" />
                                    </WrapPanel>
                                    <TextBox Text="{Binding ConnectionText, Mode=OneWay}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding ShowConnectionText, Converter={StaticResource Vis}}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConnectionOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <!-- Пароль переиспользуется везде (вход, установка, удаление, обновление по SSH); видно, что он сохранён, и его можно забыть. -->
                                    <WrapPanel Margin="0,4,0,0" Visibility="{Binding HasSavedPassword, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding SavedPasswordText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        <TextBlock Text=" · " Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        <Button Content="{l:T router.forget}" Style="{StaticResource LinkButton}" Command="{Binding ForgetPasswordCmd}" VerticalAlignment="Center"
                                                ToolTip="{l:T router.forget_tip}" />
                                    </WrapPanel>
                                    <!-- Адрес — в «Дополнительно», как в окне входа: обычно его определяют сами (UX-аудит 2, п. 10). -->
                                    <Expander Header="{l:T router.address.header}" IsExpanded="{Binding AddressCustom, Mode=OneTime}">
                                        <StackPanel Margin="0,4,0,0">
                                            <RadioButton Content="{Binding AutoAddressText}" IsChecked="{Binding AddressAuto}" Margin="0,3" HorizontalAlignment="Left" local:Demo.Sensitive="True" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <RadioButton Content="{l:T router.address.custom}" IsChecked="{Binding AddressCustom}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Text="{Binding CustomAddress, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="6,4" IsEnabled="{Binding AddressCustom}" local:Demo.Sensitive="True"
                                                         ToolTip="{l:T router.address.tip}" AutomationProperties.Name="{l:T router.address.name}">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding FindCmd}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                    <Button Content="{l:T router.update.check}" Style="{StaticResource LinkButton}" Command="{Binding UpdateCheckCmd}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Visibility="{Binding Connected, Converter={StaticResource Vis}}" />
                                    <!-- Итог проверки — у ссылки и держится (аудит С-23): «Проверка…», «Доступна X» + «Обновить до X», «Последняя версия · проверено в …», ошибка. -->
                                    <WrapPanel Margin="0,2,0,0" Visibility="{Binding HasUpdateCheckLine, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite">
                                        <TextBox Text="{Binding UpdateCheckLine, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource SelectableHint}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpdateCheckFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Button Content="{Binding UpdateToText}" Style="{StaticResource Small}" Command="{Binding UpdateCmd}" VerticalAlignment="Center"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" />
                                    </WrapPanel>
                                    <!-- «Вернуть версию» (status.rollback, роутер с 0.2.0-r16): только по кнопке, с вопросом; старый роутер — ссылки нет. -->
                                    <Button Content="{Binding RollbackText}" Style="{StaticResource LinkButton}" Command="{Binding RollbackCmd}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Visibility="{Binding RollbackShown, Converter={StaticResource Vis}}" />
                                    <!-- Удаление — спокойно и не на виду: ссылкой внизу карточки, подтверждение — в диалоге (RouterUninstallDialog). -->
                                    <Button Content="{l:T router.uninstall}" Style="{StaticResource LinkButton}" Command="{Binding UninstallCmd}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Visibility="{Binding Found, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Настройки (UX-аудит п. 12): работа, вид, обновления, помощник, данные, удаление. ===== -->
                <TabItem Header="{l:T common.nav.settings}" AutomationProperties.Name="{l:T common.nav.settings}" local:Nav.Icon="{StaticResource Ic.settings}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{l:T common.nav.settings}" Style="{StaticResource H1}" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T settings.work.title}" Style="{StaticResource H2}" />
                                    <!-- Режим службы (п. 4 аудита): настройка «на один раз», не действие главной. -->
                                    <CheckBox Content="{l:T settings.service.mode}" IsChecked="{Binding ServiceMode}" IsEnabled="{Binding CanChoose}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RunModeHint}" Style="{StaticResource Hint}" Margin="26,2,0,0" />
                                    <!-- Автозапуск окна при входе (architecture.md «Окно, трей, автозапуск»): ключ Run пользователя, окно — в трее. -->
                                    <CheckBox Content="{l:T settings.autostart.label}" IsChecked="{Binding Autostart.Enabled}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Autostart.Hint}" Style="{StaticResource Hint}" Margin="26,2,0,0" />
                                    <TextBlock Text="{l:T settings.close.title}" Style="{StaticResource Hint}" Margin="0,12,0,2" />
                                    <WrapPanel>
                                        <RadioButton Content="{l:T settings.close.tray}" IsChecked="{Binding CloseTray}" Margin="0,3,24,3" />
                                        <RadioButton Content="{l:T settings.close.exit}" IsChecked="{Binding CloseExit}" Margin="0,3,24,3" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CloseHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="{Binding HasCloseHint, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T settings.advanced.title}" Style="{StaticResource H2}" />
                                    <CheckBox Content="{l:T settings.advanced.check}" IsChecked="{Binding ShowAdvancedSetting}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    <TextBlock Text="{l:T settings.advanced.hint}" Style="{StaticResource Hint}" Margin="26,2,0,0" TextWrapping="Wrap" />
                                    <!-- Шаблон перевода (docs/localization.md): все ключи, английский текст и русский рядом. -->
                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding ShowAdvancedSetting, Converter={StaticResource Vis}}">
                                        <Button DockPanel.Dock="Right" Content="{l:T settings.lang.template}" Command="{Binding ExportLangTemplateCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Text="{l:T settings.lang.template.hint}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T settings.appearance.title}" Style="{StaticResource H2}" />
                                    <WrapPanel>
                                        <RadioButton Content="{l:T settings.theme.auto}" IsChecked="{Binding ThemeAuto}" Margin="0,3,24,3" />
                                        <RadioButton Content="{l:T settings.theme.light}" IsChecked="{Binding ThemeLight}" Margin="0,3,24,3" />
                                        <RadioButton Content="{l:T settings.theme.dark}" IsChecked="{Binding ThemeDark}" Margin="0,3,24,3" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" DataContext="{Binding Lang}">
                                <StackPanel>
                                    <TextBlock Text="{l:T settings.lang.title}" Style="{StaticResource H2}" />
                                    <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.Name="{l:T common.lang.name}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="Language" IsChecked="{Binding IsCurrent}" Margin="0,3,24,3" AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:FlagIcon Code="{Binding Flag}" />
                                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{l:T settings.lang.hint}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Роутер: показывать ли его в окне (R-shell). Снято — окно как при ненайденном роутере, поиск не идёт. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T common.nav.router}" Style="{StaticResource H2}" />
                                    <CheckBox Content="{l:T settings.router.show}" IsChecked="{Binding ShowRouter}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    <TextBlock Text="{l:T settings.router.show_hint}" Style="{StaticResource Hint}" Margin="26,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Роутер: сохранённый пароль виден и здесь, рядом с остальными данными на этом компьютере. -->
                            <Border Style="{StaticResource Card}" DataContext="{Binding Router}" Visibility="{Binding HasSavedPassword, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:T common.nav.router}" Style="{StaticResource H2}" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding SavedPasswordText}" VerticalAlignment="Center" />
                                        <TextBlock Text=" · " VerticalAlignment="Center" />
                                        <Button Content="{l:T settings.router.forget}" Style="{StaticResource LinkButton}" Command="{Binding ForgetPasswordCmd}" VerticalAlignment="Center"
                                                ToolTip="{l:T settings.router.forget_tip}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Свои настройки (R-settings, п. 14): выгрузка и загрузка папкой или .zip — окно TransferView. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T settings.transfer.title}" Style="{StaticResource H2}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Command="{Binding ExportSettingsCmd}" Margin="0,0,8,0" Padding="12,7" AutomationProperties.Name="{l:T settings.transfer.export_btn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Ic.arrow_upload}" Fill="{DynamicResource Text}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{l:T settings.transfer.export_btn}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ImportSettingsCmd}" Margin="0" Padding="12,7" AutomationProperties.Name="{l:T settings.transfer.import_btn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Ic.arrow_download}" Fill="{DynamicResource Text}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{l:T settings.transfer.import_btn}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{l:T settings.transfer.row}" />
                                            <TextBlock Text="{l:T settings.transfer.hint}" Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Адреса сайтов для проверок (R-settings, п. 17): защищённый DNS или как у системы. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T settings.checkdns.title}" Style="{StaticResource H2}" />
                                    <RadioButton GroupName="CheckDns" Content="{l:T settings.checkdns.secure}" IsChecked="{Binding CheckDnsSecure}" Margin="0,3,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="{l:T settings.checkdns.secure_hint}" Style="{StaticResource Hint}" FontSize="13" Margin="26,0,0,6" />
                                    <RadioButton GroupName="CheckDns" Content="{l:T settings.checkdns.system}" IsChecked="{Binding CheckDnsSystem}" Margin="0,3,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="{l:T settings.checkdns.system_hint}" Style="{StaticResource Hint}" FontSize="13" Margin="26,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Откат всего: список из журналов (помощника и окна), «Отменить всё», отчёт по пунктам. Над «Очисткой и удалением». -->
                            <Border Style="{StaticResource Card}" Margin="0,18,0,0" DataContext="{Binding Changes}" x:Name="ChangesCard">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="{l:T settings.changes.undo_all}" Command="{Binding UndoAllCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Text="{l:T settings.changes.title}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:T settings.changes.promise}" />
                                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}" />
                                    <Expander x:Name="ChangesList" Header="{Binding CountText}" IsExpanded="{Binding ListOpen}"
                                              Visibility="{Binding HasItems, Converter={StaticResource Vis}}">
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <!-- Пункт: «Отменить» — где отмена по одному безопасна (ChangeUndoPolicy); иначе — честная подпись почему. -->
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <!-- Колонка действия одной ширины у всех строк — даты стоят ровно. -->
                                                        <Border DockPanel.Dock="Right" Width="128" Margin="12,0,0,0">
                                                            <Button Content="{Binding Action}" Style="{StaticResource LinkButton}" Command="{Binding UndoCmd}" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top" Visibility="{Binding HasAction, Converter={StaticResource Vis}}" />
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" local:Demo.Sensitive="True" />
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                    <TextBox Text="{Binding HelperNote, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                                             Visibility="{Binding HasHelperNote, Converter={StaticResource Vis}}" />
                                    <!-- Отчёт: возвращено / уже было как раньше / пропущено (изменено после нас) / не удалось — с причиной. -->
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasReport, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Report}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,3">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,8,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Mark}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Mark}" Value="fail"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" local:Demo.Sensitive="True" />
                                                        </WrapPanel>
                                                        <TextBox Text="{Binding Note, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" Margin="0,1,0,0"
                                                                 Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Question}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasQuestion, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Удаление — отдельно, спокойным стилем, с тем, как вернуть (UX-аудит, «Опасные действия», п. 18–19). -->
                            <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                                <StackPanel>
                                    <TextBlock Text="{l:T settings.cleanup.title}" Style="{StaticResource H2}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="{l:T settings.cleanup.clear_history}" Command="{Binding ClearHistoryCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="{l:T settings.cleanup.clear_history_hint}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="{l:T settings.cleanup.remove_service}" Command="{Binding RemoveServiceCmd}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="{l:T settings.cleanup.remove_service_hint}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding CanUninstallHelper, Converter={StaticResource Vis}}">
                                        <Button DockPanel.Dock="Right" Content="{l:T settings.cleanup.uninstall_helper}" Command="{Binding UninstallHelperCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="{l:T settings.cleanup.uninstall_helper_hint}" />
                                    </DockPanel>
                                    <!-- Полный путь удаления (С-25): шаги по очереди, затем — какие папки стереть вручную. -->
                                    <DockPanel Margin="0,12,0,0">
                                        <Button x:Name="UninstallPc" DockPanel.Dock="Right" ContentTemplate="{StaticResource Shield}" Content="{l:T settings.uninstall.button}"
                                                Command="{Binding UninstallPcCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{l:T settings.uninstall.hint}" />
                                    </DockPanel>
                                    <StackPanel x:Name="UninstallSteps" Margin="0,10,0,0" Visibility="{Binding HasUninstallSteps, Converter={StaticResource Vis}}">
                                        <ItemsControl ItemsSource="{Binding UninstallSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,8,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Mark}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Mark}" Value="fail"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Title}" />
                                                        </WrapPanel>
                                                        <TextBox Text="{Binding Note, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}"
                                                                 Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasUninstallLeft, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{l:T settings.uninstall.left_title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding UninstallLeftText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,4,0,0" local:Demo.Sensitive="True" />
                                            <TextBlock Text="{Binding UninstallRouterText}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasUninstallRouterText, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T settings.uninstall.copy}" Command="{Binding CopyUninstallLeftCmd}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Информация и обновления: версии и обновления (проверка раз в день, списки ставит помощник, программа — ссылкой на релиз), сведения и лицензии. ===== -->
                <TabItem AutomationProperties.Name="{l:T common.nav.about}" local:Nav.Icon="{StaticResource Ic.info}" local:Nav.Badge="{Binding Updates.AnyAvailable}">
                    <!-- Не влезает в пункт меню одной строкой (ширина 168) — перенос по смыслу, без многоточия. -->
                    <TabItem.Header>
                        <TextBlock Text="{l:T common.nav.about.menu}" />
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{l:T common.nav.about}" Style="{StaticResource H1}" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T about.version.title}" Style="{StaticResource H2}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{l:T about.row.app}" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AppVersionText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="1" Text="{l:T about.row.helper}" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBox Text="{Binding HelperText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,2,0,0" />
                                            <TextBlock Text="{l:T about.helper.hint}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{l:T about.row.data}" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Updates.StatusText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="3" Text="{l:T about.row.core}" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <StackPanel Grid.Row="3" Grid.Column="1">
                                            <TextBox Text="{Binding CoreRowText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,2,0,2" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{l:T about.core.repair}" Command="{Binding RepairCoreCmd}" HorizontalAlignment="Left"
                                                    Visibility="{Binding CoreBroken, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Text="{l:T about.row.router}" Style="{StaticResource Hint}" Margin="0,2,16,2" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" DataContext="{Binding Router}">
                                            <TextBox Text="{Binding PackageVersionText, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                            <TextBox Text="{Binding PackageUpdateText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontWeight="SemiBold" Margin="0,2,0,2"
                                                       Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" />
                                            <WrapPanel>
                                                <Button Content="{Binding UpdateButtonText}" Style="{StaticResource Primary}" Command="{Binding UpdateCmd}"
                                                        Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" />
                                                <Button Content="{l:T about.router.install}" Style="{StaticResource LinkButton}" Command="{Binding InstallCmd}"
                                                        Visibility="{Binding ShowPackageInstall, Converter={StaticResource Vis}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <!-- Ядро, установленное на роутере (status.core.installed_version, роутер 0.2.0-r8); нет входа или старый роутер — строки нет. -->
                                        <TextBlock Grid.Row="5" Text="{l:T about.row.router_core}" Style="{StaticResource Hint}" Margin="0,2,16,2" Visibility="{Binding Router.HasRouterCore, Converter={StaticResource Vis}}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Router.RouterCoreText, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,2,0,2"
                                                   Visibility="{Binding Router.HasRouterCore, Converter={StaticResource Vis}}" />
                                    </Grid>
                                    <Button Content="{Binding FixHelperText}" Command="{Binding FixHelperCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding HasHelperProblem, Converter={StaticResource Vis}}" />

                                    <!-- Обновления данных (architecture.md «Обновления данных»). Списки и программа — разными словами (UX-аудит 2, п. 13). -->
                                    <StackPanel DataContext="{Binding Updates}">
                                        <!-- Блок «Списки» — только когда есть новые (одна кнопка); блок «Программа» — одна главная кнопка по состоянию (UX-аудит 5, п. 3). -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding DataAvailable, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{l:T about.lists.title}" Style="{StaticResource Hint}" />
                                            <TextBlock Text="{Binding AvailableText}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <Button ContentTemplate="{StaticResource Shield}" Content="{l:T about.lists.update}" Style="{StaticResource Primary}" Command="{Binding InstallCmd}"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{l:T about.row.app}" Style="{StaticResource Hint}" Margin="0,14,0,0" />
                                        <!-- Программа: подписанное описание выпуска получено — «Что нового» и «Обновить до X» (права не нужны);
                                             не получено — подсказка и ссылка на страницу релизов. -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding AppReleaseReady, Converter={StaticResource Vis}}">
                                            <TextBox Text="{Binding AppReleaseTitle, Mode=OneWay}" Style="{StaticResource SelectableText}" FontWeight="SemiBold" />
                                            <StackPanel Margin="0,6,0,0" Visibility="{Binding HasAppNotes, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{l:T about.app.whats_new}" Style="{StaticResource Hint}" Margin="0,0,0,2" />
                                                <ItemsControl ItemsSource="{Binding AppNotes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Mode=OneWay, StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,1,0,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="{l:T about.app.verify_note}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding AppOsNote, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,8,0,0" Visibility="{Binding HasAppOsNote, Converter={StaticResource Vis}}" />
                                        <TextBox Text="{Binding AppText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                                                 Visibility="{Binding AppHintOnly, Converter={StaticResource Vis}}" />
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding AppBusy, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite">
                                            <TextBox Text="{Binding AppProgressText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                            <ProgressBar Height="6" IsIndeterminate="True" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AppNotice}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                                   Visibility="{Binding HasAppNotice, Converter={StaticResource Vis}}" />
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasAppError, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Assertive">
                                            <TextBox Text="{Binding AppErrorShort, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" />
                                            <Expander Header="{l:T common.more}" Visibility="{Binding HasAppErrorMore, Converter={StaticResource Vis}}">
                                                <TextBox Text="{Binding AppErrorMore, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" FontSize="12" />
                                            </Expander>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="{l:T common.retry}" Command="{Binding RetryCmd}" />
                                                <Button Content="{l:T about.app.manual_link}" Style="{StaticResource LinkButton}" Command="{Binding OpenReleaseCmd}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <!-- Ручное скачивание — не рядом с главной кнопкой, а под «Подробнее». -->
                                        <Expander Header="{l:T common.more}" Visibility="{Binding AppHintOnly, Converter={StaticResource Vis}}">
                                            <Button Content="{Binding AppButtonText}" Command="{Binding OpenReleaseCmd}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                        </Expander>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="{Binding AppUpdateButtonText}" Style="{StaticResource Primary}" Command="{Binding UpdateAppCmd}"
                                                    Visibility="{Binding ShowAppUpdateButton, Converter={StaticResource Vis}}" />
                                            <Button Content="{l:T about.app.check_button}" Command="{Binding CheckCmd}"
                                                    Visibility="{Binding ShowCheckButton, Converter={StaticResource Vis}}" />
                                            <!-- Итог проверки — рядом с кнопкой и держится: «Проверка…», «Последняя версия · проверено в …», «Не проверено: причина». -->
                                            <TextBox Text="{Binding AppCheckLine, Mode=OneWay}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                                     Visibility="{Binding HasAppCheckLine, Converter={StaticResource Vis}}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SelectableHint}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AppCheckFailed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Content="{Binding RollbackText}" Command="{Binding RollbackCmd}" ToolTip="{l:T about.app.rollback_tip}"
                                                    Visibility="{Binding CanRollback, Converter={StaticResource Vis}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T about.info.title}" Style="{StaticResource H2}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="{l:T about.info.based_on}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Button Content="zapret (bol-van) ↗" Style="{StaticResource LinkButton}" Command="{Binding OpenZapretCmd}" VerticalAlignment="Center" Margin="0" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{l:T about.info.repo}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Button Content="github.com/Slavdew/dpishell ↗" Style="{StaticResource LinkButton}" Command="{Binding OpenRepoCmd}" VerticalAlignment="Center" Margin="0" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{l:T about.info.issues}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Button Content="{l:T about.info.issues_link}" Style="{StaticResource LinkButton}" Command="{Binding OpenIssuesCmd}" VerticalAlignment="Center" Margin="0" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="{l:T about.info.faq_link}" Style="{StaticResource LinkButton}" Command="{Binding OpenFaqCmd}" VerticalAlignment="Center" Margin="-4,0,0,0" />
                                    </WrapPanel>
                                    <TextBlock Text="{l:T about.info.license}" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="{l:T about.info.third_party}" />
                                    <Button Content="{l:T about.info.open_licenses}" Command="{Binding OpenNoticesCmd}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding HasNotices, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Проба включения на роутере (router-api §5.2 confirm_s): сайты с ПК не открылись или проверить нельзя — «Всё работает?»;
             отсчёт — по left_s на часах этого ПК. Видна на любой вкладке, над тостом. -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="190,0,0,104" MaxWidth="620" Padding="16,10,12,10" CornerRadius="8"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" DataContext="{Binding Router}"
                Visibility="{Binding TrialVisible, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Assertive">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding TrialText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <WrapPanel Margin="-4,8,0,0" Visibility="{Binding TrialAsk, Converter={StaticResource Vis}}">
                    <Button Content="{l:T router.trial.keep}" Style="{StaticResource Primary}" Command="{Binding TrialKeepCmd}" Margin="4,0,8,0" />
                    <Button Content="{l:T router.trial.revert}" Command="{Binding TrialRevertCmd}" Margin="0,0,12,0" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Тост: итог обратимого действия с «Вернуть» (DNS этого ПК) и ошибки операций (красная рамка), над строкой состояния.
             Сам скрывается, но не пока над ним мышь (UX-аудит 2, п. 14, 16). -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="190,0,0,44" MaxWidth="560" Padding="16,10,10,10" CornerRadius="8"
                Background="{DynamicResource Surface}" MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave"
                Visibility="{Binding HasToast, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="Black" />
            </Border.Effect>
            <!-- Ошибка: «Подробнее» — полное описание (ошибка, действие, время, версии) и «Скопировать»; личное скрыто, как в отчёте. -->
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButton}" Command="{Binding CloseToastCmd}" VerticalAlignment="Center"
                            Foreground="{DynamicResource Muted}" Margin="4,0,0,0" ToolTip="{l:T common.close}" AutomationProperties.Name="{l:T common.close_message}" />
                    <Button DockPanel.Dock="Right" Content="{Binding ToastAction}" ContentTemplate="{StaticResource Shield}" Command="{Binding ToastCmd}" VerticalAlignment="Center"
                            Margin="12,0,0,0" Visibility="{Binding HasToastAction, Converter={StaticResource Vis}}" />
                    <Button x:Name="ToastDetails" DockPanel.Dock="Right" Content="{Binding ErrorDetailsLabel}" Style="{StaticResource LinkButton}" Command="{Binding ErrorDetailsCmd}"
                            VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ToastError, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <StackPanel Margin="0,8,0,0" Visibility="{Binding ErrorDetailsOpen, Converter={StaticResource Vis}}">
                    <TextBox x:Name="ToastErrorText" Text="{Binding ErrorDetailsText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="12"
                             local:Demo.Sensitive="True" />
                    <Button Content="{l:T shell.error.copy}" Command="{Binding CopyErrorCmd}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Загрузка ядра при старте -->
        <Grid Background="{DynamicResource Page}" Visibility="{Binding ShowOverlay, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="DpiShell" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding LoadingText}" Margin="0,0,0,14" />
                    <ProgressBar Height="6" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadFailed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <!-- Не ответил или отвечает дольше 10 с — выход с первого экрана (UX-аудит, п. 46). -->
                    <WrapPanel Margin="0,4,0,0" Visibility="{Binding ShowLoadActions, Converter={StaticResource Vis}}">
                        <Button Content="{l:T common.retry}" Style="{StaticResource Primary}" Command="{Binding RetryCmd}" />
                        <Button Content="{l:T shell.overlay.open_without_helper}" Command="{Binding OpenWithoutHelperCmd}" ToolTip="{l:T shell.overlay.open_without_helper_tip}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
