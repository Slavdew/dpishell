<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Окно без прав (docs/dev/helper-protocol.md): всё, что их требует, делает служба-помощник DpiShellHelper.
             Права запрашиваются один раз — при установке помощника (DpiShell.exe -install-helper через runas). -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Windows 10/11: без этого блока Windows считает программу рассчитанной на 8.1 и включает режимы совместимости (в т. ч. на Windows 10). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
