<UserControl x:Class="DpiShell.App.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DpiShell.App"
             xmlns:local="clr-namespace:DpiShell.App">
    <!-- «Выгрузить / Загрузить настройки» (п. 14): один диалог с переключателем «Выгрузка | Загрузка», как в макете combined (экран «Выгрузка настроек»). DataContext — TransferViewModel. -->
    <UserControl.Resources>
        <!-- Строка раздела: галочка, название, число записей / итог плана; предупреждение, список записей, пояснения о пропущенном. -->
        <DataTemplate x:Key="SectionRow">
            <StackPanel>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="70" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding Enabled}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{Binding ToggleText}" Command="{Binding ToggleCmd}" Margin="8,0,12,0" Padding="0"
                                VerticalAlignment="Center" Visibility="{Binding HasItems, Converter={StaticResource Vis}}" />
                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{DynamicResource Muted}" TextAlignment="Right" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Warn}" Margin="26,6,0,4" Padding="10,8" Visibility="{Binding HasWarn, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="{StaticResource Ic.warning}" Fill="{DynamicResource Text}" Width="16" Height="16" Stretch="Uniform" Margin="0,1,8,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Warn}" FontSize="13" />
                    </DockPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Notes}" Margin="26,4,0,2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" FontSize="12.5" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="26,4,0,6" Visibility="{Binding ShowItems, Converter={StaticResource Vis}}">
                    <TextBox Text="{Binding ItemsText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="12.5" local:Demo.Sensitive="True"
                             />
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- Поле с подсказкой, пока пусто. -->
        <Style x:Key="WithHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="9,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <DockPanel Width="580" Margin="22,18,22,16">
        <!-- Заголовок и переключатель вкладок. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource ButtonLine}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ButtonBack}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Seg}" GroupName="TransferTab" Content="{l:T settings.transfer.tab_export}" IsChecked="{Binding IsExport}" />
                    <RadioButton Style="{StaticResource Seg}" GroupName="TransferTab" Content="{l:T settings.transfer.tab_import}" IsChecked="{Binding IsImport}" />
                </StackPanel>
            </Border>
            <Path Data="{StaticResource Ic.arrow_upload}" Fill="{DynamicResource Accent}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                  Visibility="{Binding IsExport, Converter={StaticResource Vis}}" />
            <Path Data="{StaticResource Ic.arrow_download}" Fill="{DynamicResource Accent}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                  Visibility="{Binding IsImport, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="18" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Кнопки внизу. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Primary}" Content="{l:T settings.transfer.export_go}" Command="{Binding ExportCmd}" IsDefault="True" Margin="0,0,8,0"
                        Visibility="{Binding IsExport, Converter={StaticResource Vis}}" />
                <Button Style="{StaticResource Primary}" ContentTemplate="{StaticResource Shield}" Content="{l:T settings.transfer.import_go}" Command="{Binding ImportCmd}" Margin="0,0,8,0"
                        Visibility="{Binding IsImport, Converter={StaticResource Vis}}" />
                <Button Content="{l:T common.close}" Command="{Binding CloseCmd}" IsCancel="True" Margin="0" />
            </StackPanel>
            <Button Style="{StaticResource LinkButton}" Content="{Binding ShowAllText}" Command="{Binding ShowAllCmd}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" Padding="0"
                    Visibility="{Binding IsExport, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ===== Выгрузка ===== -->
                <StackPanel Visibility="{Binding IsExport, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T settings.transfer.export_intro}" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                    <TextBox Text="{Binding ExportError, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" Margin="0,0,0,8"
                             Visibility="{Binding HasExportError, Converter={StaticResource Vis}}" />
                    <Border Style="{StaticResource Card}" Padding="14,4" Margin="0">
                        <ItemsControl ItemsSource="{Binding ExportSections}" ItemTemplate="{StaticResource SectionRow}" />
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Padding="6,5" AutomationProperties.Name="{l:T settings.transfer.provider_ph}" />
                            <TextBlock Text="{l:T settings.transfer.provider_ph}" Style="{StaticResource WithHint}">
                                <TextBlock.Visibility>
                                    <Binding Path="Provider" Converter="{x:Static l:EmptyToVisible.Instance}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Padding="6,5" AutomationProperties.Name="{l:T settings.transfer.note_ph}" />
                            <TextBlock Text="{l:T settings.transfer.note_ph}" Style="{StaticResource WithHint}">
                                <TextBlock.Visibility>
                                    <Binding Path="Note" Converter="{x:Static l:EmptyToVisible.Instance}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <!-- Куда: папка или архив. -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border BorderBrush="{DynamicResource ButtonLine}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ButtonBack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg}" GroupName="TransferKind" Content="{l:T settings.transfer.kind_zip}" IsChecked="{Binding ExportZip}" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="TransferKind" Content="{l:T settings.transfer.kind_folder}" IsChecked="{Binding ExportFolder}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="{l:T settings.transfer.browse}" Command="{Binding BrowseExportCmd}" Margin="8,0,0,0" Padding="12,4" />
                        <Path DockPanel.Dock="Left" Data="{StaticResource Ic.folder}" Fill="{DynamicResource Muted}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ExportPath, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="NoWrap" VerticalAlignment="Center" FontSize="13" />
                    </DockPanel>
                    <TextBlock Text="{l:T settings.transfer.never}" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasExportResult, Converter={StaticResource Vis}}">
                        <TextBox Text="{Binding ExportResultText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                        <Button Style="{StaticResource LinkButton}" Content="{l:T settings.transfer.open_folder}" Command="{Binding OpenExportedCmd}" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== Загрузка ===== -->
                <StackPanel Visibility="{Binding IsImport, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding FromText}" Style="{StaticResource Hint}" Margin="0,0,0,2" local:Demo.Sensitive="True" />
                    <TextBlock Text="{Binding ProviderText}" Style="{StaticResource Hint}" Visibility="{Binding HasProviderText, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding PackageNote}" Style="{StaticResource Hint}" Visibility="{Binding HasPackageNote, Converter={StaticResource Vis}}" />
                    <WrapPanel Margin="0,10,0,6">
                        <Button Content="{l:T settings.transfer.pick_folder}" Command="{Binding PickFolderCmd}" />
                        <Button Content="{l:T settings.transfer.pick_zip}" Command="{Binding PickZipCmd}" />
                    </WrapPanel>
                    <TextBox Text="{Binding ImportError, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" Margin="0,0,0,8"
                             Visibility="{Binding HasImportError, Converter={StaticResource Vis}}" />
                    <Border Style="{StaticResource Card}" Padding="14,4" Margin="0" Visibility="{Binding HasPackage, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding ImportSections}" ItemTemplate="{StaticResource SectionRow}" />
                    </Border>
                    <StackPanel Visibility="{Binding HasPackage, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{l:T settings.transfer.mode}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border BorderBrush="{DynamicResource ButtonLine}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ButtonBack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Seg}" GroupName="TransferMode" Content="{l:T settings.transfer.mode_add}" IsChecked="{Binding AddMode}" />
                                    <RadioButton Style="{StaticResource Seg}" GroupName="TransferMode" Content="{l:T settings.transfer.mode_replace}" IsChecked="{Binding ReplaceMode}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{l:T settings.transfer.promise}" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBox Text="{Binding ImportResultText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,10,0,0"
                             Visibility="{Binding HasImportResult, Converter={StaticResource Vis}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
