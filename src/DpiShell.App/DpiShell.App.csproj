<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DpiShell.Core\DpiShell.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Только ради NotifyIcon в трее: внешних пакетов не берём. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinDivert и sc требуют администратора. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DpiShell.App</RootNamespace>
    <AssemblyName>DpiShell</AssemblyName>
    <Product>DpiShell</Product>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Публикация: dotnet publish -c Release -r win-x64 (self-contained, PublishSingleFile=true) -->
  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- WPF+WinForms без сжатия — ~150 МБ; сжатый single-file примерно вдвое меньше. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <!-- Помощник доверяет окну той же сборки (helper-protocol §5): переменная DOTNET_STARTUP_HOOKS не должна подгружать чужой код в настоящий exe.
         В Debug остаётся (горячая перезагрузка студии). -->
    <StartupHookSupport Condition="'$(Configuration)' == 'Release'">false</StartupHookSupport>
  </PropertyGroup>

  <!-- Строки интерфейса (docs/localization.md): L и языковые файлы — в DpiShell.Core. -->
  <ItemGroup>
    <Using Include="DpiShell.Core.Localization" />
  </ItemGroup>

  <!-- WinForms и WPF дают одноимённые типы: глобальные using от WinForms убираем, нужные пишем явно. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- data\ (из Core) должна лежать рядом с exe, а не внутри single-file: Core ищет её в AppContext.BaseDirectory. -->
  <Target Name="KeepDataNextToExe" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('data'))"
                             ExcludeFromSingleFile="true" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
