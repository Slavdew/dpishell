<Project>
  <!-- Версия программы для Windows — единый источник: сборки (AssemblyVersion, ProductVersion exe), имя portable-архива,
       release.json. Выпуск — тег windows-v<Version>; CI (.github/workflows/windows.yml) сверяет тег с этим значением.
       Заметки к версии — packaging/release-notes.json (без них тег не выпускается). docs/dev/building.md «Публикация». -->
  <PropertyGroup>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
